# ─── Site (rr — resource.rahmanef.com) ──────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://resource.rahmanef.com"
NEXT_PUBLIC_REPO_URL="https://github.com/rahmanef63/resources"

# ─── Next 16 hardening — REQUIRED on multi-instance deploys ──────────────
# Stable Server Action encryption across rolling deploys / replicas. If
# missing or different across instances, in-flight Server Actions fail.
# Generate with: `openssl rand -base64 32`
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
# Pin a deployment fingerprint so the cache layer skips stale entries on
# new deploys. Set to commit SHA in CI.
NEXT_DEPLOYMENT_ID=""

# ─── Convex ───────────────────────────────────────────────────────────────
# rr's own backend (api-resource.rahmanef.com) deploys from this repo:
#   npm run deploy:convex   (composer: convex/schema.ts + convex/crons.ts)
# Consumers wiring their own backend set the same vars in their project.
# CONVEX_URL=""
# NEXT_PUBLIC_CONVEX_URL=""
# CONVEX_DEPLOY_KEY=""

# ─── Convex self-hosted (consumers running their own backend) ────────────
# Required for self-hosted: see docs/deploy.md.
# CONVEX_SELF_HOSTED_URL="http://localhost:3210"
# CONVEX_SELF_HOSTED_ADMIN_KEY=""

# Pin convex-backend image digest (NOT :latest) for production:
# CONVEX_SELF_HOSTED_IMAGE="ghcr.io/get-convex/convex-backend:<digest>"

# Backend self-knowledge (auto-set by si-coder deploy.js for known apps):
# CONVEX_SITE_ORIGIN="https://api-<appname>.<your-domain>"
# CONVEX_CLOUD_ORIGIN="https://api-<appname>.<your-domain>"

# ─── Auth (slice: convex-auth) ───────────────────────────────────────────
# CRITICAL: required on backend container — generate via si-coder skill keygen.
# Without these, @convex-dev/auth crashes mid-action.
# JWT_PRIVATE_KEY=""    # PEM PKCS8 RSA private key, multi-line
# JWKS=""               # JSON {"keys":[{...}]}
# SITE_URL=""

# Magic-link via Resend (optional auth path)
# AUTH_RESEND_KEY=""

# Google OAuth (optional)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Super-admin email gate for convex/_shared/auth.ts requireSuperAdmin.
# Empty = no super-admin gate active.
# SUPER_ADMIN_EMAIL=""

# ─── Slice envs (used by templates that include the slice) ───────────────

# Midtrans payment (slice: midtrans-payment)
# MIDTRANS_SERVER_KEY=""
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
# MIDTRANS_IS_PRODUCTION="false"

# DOKU payment (slice: doku-payment)
# DOKU_CLIENT_ID=""
# DOKU_SECRET_KEY=""
# DOKU_IS_PRODUCTION="false"
# DOKU_NOTIFY_PATH="/webhooks/doku"

# Cal.com booking (slice: cal-com-booking)
# CALCOM_WEBHOOK_SECRET=""
# NEXT_PUBLIC_CALCOM_USERNAME=""

# Resend newsletter (slice: resend-newsletter)
# RESEND_API_KEY=""
# RESEND_FROM=""

# AI router (slice: ai-router)
# OPENROUTER_API_KEY=""

# Vector search (slice: vector-search)
# OPENAI_API_KEY=""

# SEO AI generator (slice: seo)
# ANTHROPIC_API_KEY=""
