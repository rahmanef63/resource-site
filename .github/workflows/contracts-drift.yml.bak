name: contracts-drift

# Post-merge guard that scans frontend/slices/<slug>/ for:
#   - manifest/contract id mismatches (FAIL)
#   - slices with a manifest but no slice.contract.ts (INFO-only inventory)
#
# Runs after every merge to main. The scan logic lives in
# scripts/validation/check-contract-drift.mjs so devs can reproduce locally:
#   npm run contracts:drift

on:
  push:
    branches: [main]

permissions:
  contents: read
  issues: write

concurrency:
  group: contracts-drift-${{ github.ref }}
  cancel-in-progress: true

jobs:
  contracts-drift:
    name: scan manifest/contract drift
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: checkout
        uses: actions/checkout@v4

      - name: setup node
        uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: "npm"
          cache-dependency-path: package-lock.json

      - name: install
        run: npm ci --legacy-peer-deps --no-audit --no-fund

      - name: scan drift
        id: scan
        run: |
          set +e
          node scripts/validation/check-contract-drift.mjs --json > drift.json
          code=$?
          echo "exit_code=$code" >> "$GITHUB_OUTPUT"
          cat drift.json
          # Don't fail here — let the post-summary + final-fail step govern.
          exit 0

      - name: post inventory comment
        if: always()
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            let payload;
            try {
              payload = JSON.parse(fs.readFileSync('drift.json', 'utf8'));
            } catch (e) {
              core.warning(`drift.json unreadable: ${e.message}`);
              return;
            }
            const missing = payload.missingContracts || [];
            const mismatches = payload.mismatches || [];
            // No PR to comment on for `push` events — instead create / update
            // a tracking issue if drift is non-zero OR the inventory shifts.
            const lines = [
              `### contract drift — post-merge scan @ ${context.sha.slice(0,7)}`,
              ``,
              `- total slices scanned: **${payload.totalSlices}**`,
              `- drift (mismatch / orphan / unparsable): **${payload.driftCount}**`,
              `- missing slice.contract.ts (info): **${payload.missingContractCount}**`,
              ``,
            ];
            if (mismatches.length) {
              lines.push(`#### mismatches`, ``, `| slug | status | manifest.name | contract.id |`, `|---|---|---|---|`);
              for (const m of mismatches) {
                lines.push(`| ${m.slug} | ${m.status} | ${m.manifestName ?? '—'} | ${m.contractId ?? '—'} |`);
              }
              lines.push('');
            }
            if (missing.length) {
              lines.push(`#### backfill candidates (manifest present, no contract)`, ``);
              for (const s of missing) lines.push(`- ${s}`);
              lines.push('');
            }
            const body = lines.join('\n');
            // Stash report into the run summary so it's always visible.
            await core.summary.addRaw(body).write();
            console.log(body);

      - name: fail on drift
        run: |
          code="${{ steps.scan.outputs.exit_code }}"
          if [ "$code" != "0" ]; then
            echo "contracts-drift: drift detected (exit=$code)"
            exit 1
          fi
          echo "contracts-drift: ok"
