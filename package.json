{
  "name": "rahmanef-resources-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 9999",
    "gen:slices": "node scripts/features/gen-slice-registries.mjs",
    "gen:slices:check": "node scripts/features/gen-slice-registries.mjs --check",
    "validate:slices": "node packages/cli/scripts/validate-slice.mjs",
    "audit:slices": "node scripts/validation/audit-slice.mjs",
    "validate:compose": "node scripts/validation/validate-compose.mjs",
    "validate:manifests": "node scripts/validation/validate-manifests.mjs",
    "validate:manifests:check": "node scripts/validation/validate-manifests.mjs --check",
    "validate:contracts": "node scripts/validation/validate-contract.mjs",
    "validate:contracts:check": "node scripts/validation/validate-contract.mjs --check",
    "contracts:drift": "node scripts/validation/check-contract-drift.mjs",
    "slices:check": "npm run validate:slices && npm run audit:slices && npm run gen:slices:check && npm run validate:manifests && npm run validate:contracts",
    "new:slice": "node scripts/features/scaffold-slice.mjs",
    "new:template": "node scripts/features/scaffold-template.mjs",
    "modify:slice": "node scripts/features/modify-slice.mjs",
    "manifest:sync": "node packages/cli/scripts/gen-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@convex-dev/auth": "^0.0.90",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.38.0",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.0",
    "happy-dom": "^20.9.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.75.0",
    "react-resizable-panels": "^4.11.1",
    "recharts": "^3.8.0",
    "sanitize-html": "^2.17.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^16.2.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.3"
  }
}
