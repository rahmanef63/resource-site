{
  "name": "rahmanef-resources-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:alt": "next dev --port 3457",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "lint": "eslint . --max-warnings 9999",
    "gen:slices": "node scripts/features/gen-slice-registries.mjs",
    "gen:slices:check": "node scripts/features/gen-slice-registries.mjs --check",
    "gen:catalog": "node scripts/features/gen-slice-catalog.mjs",
    "gen:catalog:check": "node scripts/features/gen-slice-catalog.mjs --check",
    "gen:previews": "node packages/cli/scripts/gen-preview-registry.mjs",
    "gen:previews:check": "node packages/cli/scripts/gen-preview-registry.mjs --check",
    "validate:slices": "node packages/cli/scripts/validate-slice.mjs",
    "audit:slices": "node scripts/validation/audit-slice.mjs",
    "audit:tour": "vitest run tests/tour-coverage.test.ts",
    "audit:templates": "node scripts/validation/audit-templates.mjs",
    "audit:file-size": "node scripts/validation/audit-file-size.mjs",
    "audit:convex-features": "node scripts/validation/audit-convex-features.mjs",
    "audit:convex-api-paths": "node scripts/validation/audit-convex-api-paths.mjs",
    "audit:docs-primitives": "node scripts/validation/audit-docs-primitives.mjs",
    "validate:changelog": "node scripts/validation/validate-changelog.mjs",
    "validate:compose": "node scripts/validation/validate-compose.mjs",
    "validate:manifests": "node scripts/validation/validate-manifests.mjs",
    "validate:manifests:check": "node scripts/validation/validate-manifests.mjs --check",
    "validate:contracts": "node scripts/validation/validate-contract.mjs",
    "validate:contracts:check": "node scripts/validation/validate-contract.mjs --check",
    "forbidden:terms": "node scripts/validation/check-forbidden-terms.mjs",
    "validate:all": "node scripts/validate-all.mjs",
    "validate:all:quick": "node scripts/validate-all.mjs --quick",
    "redeploy": "node scripts/dokploy-redeploy.mjs",
    "redeploy:status": "node scripts/dokploy-redeploy.mjs --status",
    "slices:check": "npm run validate:slices && npm run audit:slices && npm run audit:tour && npm run audit:templates && npm run audit:file-size && npm run audit:convex-features && npm run audit:convex-api-paths && npm run audit:docs-primitives && npm run gen:slices:check && npm run gen:catalog:check && npm run gen:previews:check && npm run validate:manifests && npm run validate:contracts && npm run validate:changelog",
    "new:slice": "node scripts/features/scaffold-slice.mjs",
    "new:template": "node scripts/features/scaffold-template.mjs",
    "modify:slice": "node scripts/features/modify-slice.mjs",
    "manifest:sync": "node packages/cli/scripts/gen-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "e2e:only": "playwright test",
    "e2e:staging": "E2E_BASE_URL=https://staging-resource.rahmanef.com playwright test",
    "test:coverage": "vitest run --coverage",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "shots:capture": "node scripts/capture-shots.mjs",
    "deploy:convex": "node scripts/deploy-convex-functions.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@anthropic-ai/sdk": "^0.100.1",
    "@base-ui/react": "^1.4.1",
    "@convex-dev/auth": "^0.0.90",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@imgly/background-removal": "^1.7.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.197",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.38.0",
    "date-fns": "^4.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.0",
    "highlight.js": "^11.11.1",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "konva": "^10.3.0",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.15.0",
    "midtrans-client": "^1.4.3",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "rahman-shared": "^0.2.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.75.0",
    "react-konva": "^19.2.4",
    "react-resizable-panels": "^4.11.1",
    "recharts": "^3.8.0",
    "resend": "^6.12.4",
    "sanitize-html": "^2.17.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
