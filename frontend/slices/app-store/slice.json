{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "app-store",
  "version": "1.3.0",
  "category": "os",
  "kind": "ui",
  "title": "App Store \u2014 install, create + toggle apps",
  "description": "Framework-parity App Store + Create App over one localStorage registry. React/Next remains the default storefront with appshell-style descriptors and automatic agent-tool registration; explicit Svelte 5/SvelteKit adds native storefront, create-app, runtime iframe/command console surfaces over shared observable app/disabled stores, catalog metadata, exec adapter, manifest helpers, and self-contained tool semantics.",
  "namespace": "@/features/app-store",
  "frontend": {
    "slicePath": "frontend/slices/app-store",
    "configExport": "appStoreConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/app-store-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/app-store/config.ts",
            "frontend/slices/app-store/lib/apps-core.ts",
            "frontend/slices/app-store/lib/create-core.ts",
            "frontend/slices/app-store/lib/enabled-core.ts",
            "frontend/slices/app-store/lib/exec-core.ts",
            "frontend/slices/app-store/lib/glyph-core.ts",
            "frontend/slices/app-store/lib/runtime-core.ts",
            "frontend/slices/app-store/lib/store-catalog.ts",
            "frontend/slices/app-store/lib/system-catalog-core.ts",
            "frontend/slices/app-store/lib/tools.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button",
      "input",
      "badge",
      "card",
      "separator",
      "scroll-area"
    ],
    "env": [],
    "peers": [],
    "sharedFiles": [
      "lib/shared/agentic/types.ts",
      "lib/shared/agentic/define.ts",
      "lib/shared/agentic/schema.ts",
      "lib/shared/agentic/prompt.ts",
      "lib/shared/agentic/registry.ts",
      "lib/shared/agentic/global-host.ts",
      "lib/shared/agentic/use-agent-tools.ts"
    ]
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:ui-consistency"
  ],
  "license": "MIT",
  "tags": [
    "app-store",
    "registry",
    "installer",
    "dynamic-apps",
    "launcher",
    "ui",
    "svelte",
    "framework-parity",
    "local-storage",
    "agent-tools"
  ],
  "previews": [],
  "contract": {
    "requires": {
      "auth": "none",
      "deps": [
        {
          "npm": "react",
          "range": "^19"
        },
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "tools": [
        "app-store.list",
        "app-store.search",
        "app-store.install",
        "app-store.uninstall"
      ],
      "routes": [],
      "components": [
        "AppStore",
        "CreateApp"
      ],
      "hooks": [
        "useInstalledApps",
        "useApps",
        "useDisabledIds"
      ],
      "utils": [
        "createApp",
        "setInstalled",
        "configureAppStoreExec",
        "appStoreApp",
        "createAppApp"
      ],
      "tables": []
    }
  }
}
