{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "app-store",
  "version": "1.3.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add app-store",
    "consumerPath": "slices/app-store"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "app.tsx",
    "components/app-console.tsx",
    "components/create-app.tsx",
    "components/featured-card.tsx",
    "components/glyph-picker.tsx",
    "components/host-frame.tsx",
    "components/icon-preview.tsx",
    "components/runtime-app.tsx",
    "components/segmented.tsx",
    "components/store-app-card.tsx",
    "components/store-sidebar.tsx",
    "components/system-card.tsx",
    "config.ts",
    "index.ts",
    "lib/apps-core.ts",
    "lib/apps-store.ts",
    "lib/create-core.ts",
    "lib/enabled-core.ts",
    "lib/enabled-store.ts",
    "lib/exec-core.ts",
    "lib/glyph-core.ts",
    "lib/glyph.ts",
    "lib/host.ts",
    "lib/runtime-core.ts",
    "lib/store-catalog.ts",
    "lib/system-catalog-core.ts",
    "lib/system-catalog.ts",
    "lib/tools.ts",
    "lib/use-container.ts",
    "lib/use-installed-apps.ts",
    "slice.json"
  ],
  "imports": {
    "shared": [
      "lib/shared/agentic/types.ts",
      "lib/shared/agentic/define.ts",
      "lib/shared/agentic/schema.ts",
      "lib/shared/agentic/prompt.ts",
      "lib/shared/agentic/registry.ts",
      "lib/shared/agentic/global-host.ts",
      "lib/shared/agentic/use-agent-tools.ts"
    ],
    "external": [
      "lucide-react",
      "@/components/ui/badge",
      "@/components/ui/button",
      "@/components/ui/card",
      "@/components/ui/input",
      "@/components/ui/scroll-area",
      "@/components/ui/separator"
    ]
  }
}
