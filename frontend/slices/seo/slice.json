{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "seo",
  "version": "0.3.0",
  "category": "content",
  "title": "SEO — AI Metadata Generator",
  "description": "Service slice for SEO metadata generation — Anthropic-backed action with per-user 24h cost guard + portable persona prop. No public route or framework UI. Backend exposes generate + generateAndApply mutations gated by requireAdmin; consumers inject brand voice via the personaContext arg (or buildSeoSystemPrompt factory). The frontend service surface is framework-neutral TypeScript, so React/Next remains the default contract while explicit Svelte/SvelteKit installs reuse the same source without duplicate code or a Svelte runtime dependency.",
  "namespace": "@/features/seo",
  "kind": "full",
  "convex": {
    "tablesExport": "seoTables",
    "schemaPath": "convex/features/seo/_schema.ts",
    "rootPaths": [
      "convex/features/seo"
    ]
  },
  "frontend": {
    "slicePath": "frontend/slices/seo",
    "configExport": "seoConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/seo",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [],
          "shadcn": []
        }
      }
    }
  },
  "deps": {
    "npm": [],
    "shadcn": [],
    "env": [
      {
        "name": "ANTHROPIC_API_KEY",
        "scope": "server",
        "required": true,
        "description": "Anthropic API key for Claude metadata generation."
      }
    ],
    "peers": [
      {
        "slug": "convex-auth",
        "range": "^0.1",
        "reason": "Cost guard + requireAdmin gates use convex-auth user identity."
      }
    ]
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:public-fn-validator"
  ],
  "license": "MIT",
  "tags": [
    "content",
    "seo",
    "ai",
    "anthropic",
    "metadata-generator"
  ],
  "previews": [],
  "contract": {
    "requires": {
      "auth": "convex",
      "rbac": [
        "seo.write"
      ],
      "env": [
        "ANTHROPIC_API_KEY"
      ],
      "deps": [
        "convex-auth"
      ]
    },
    "provides": {
      "tools": [
        "seo.generate",
        "seo.generate_and_apply"
      ],
      "tables": [
        "seoGeneratorCalls"
      ],
      "components": [
        "buildSeoSystemPrompt"
      ]
    },
    "generalization": {
      "level": "portable",
      "forbiddenTerms": [
        "rahmanef",
        "rahmanef.com"
      ],
      "requiredProps": [
        "personaContext"
      ]
    }
  }
}
