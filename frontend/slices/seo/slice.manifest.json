{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "seo",
  "version": "0.2.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add seo",
    "consumerPath": "slices/seo"
  },
  "files": [
    "README.md",
    "components/index.ts",
    "config.ts",
    "hooks/index.ts",
    "index.ts",
    "lib/index.ts",
    "lib/persona.ts",
    "types/index.ts",
    "utils/index.ts"
  ],
  "convex": {
    "schemaPath": "convex/features/seo/schema.ts",
    "rootPaths": [
      "convex/features/seo"
    ]
  },
  "imports": {
    "shared": [
      "@/components/ui/card",
      "@/components/ui/button",
      "@/components/ui/input",
      "@/components/ui/textarea"
    ],
    "external": [
      "react",
      "convex/react",
      "lucide-react"
    ]
  }
}
