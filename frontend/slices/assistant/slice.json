{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "assistant",
  "version": "1.2.0",
  "category": "os",
  "kind": "ui",
  "title": "Assistant \u2014 agent workspace with streaming chat",
  "description": "Framework-parity agent workspace with streaming chat, user-managed agents/skills/automations, and one shared function-calling registry. React/Next remains default; native Svelte 5/SvelteKit uses the same observable localStorage store, persona/history builder, streaming demo fallback, shared agent loop, global tool registry, static/live tool catalog, and automation semantics. No backend is bundled; hosts inject one AgentStreamFn. Svelte ships no React/Next/shadcn/use-agent-tools runtime.",
  "namespace": "@/features/assistant",
  "frontend": {
    "slicePath": "frontend/slices/assistant",
    "configExport": "assistantConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/assistant-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5",
            "@lucide/svelte@^1.46.0"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/assistant/lib/agentic-host.ts",
            "frontend/slices/assistant/lib/chat-core.ts",
            "frontend/slices/assistant/lib/presets.ts",
            "frontend/slices/assistant/lib/store-core.ts",
            "frontend/slices/assistant/lib/stream-core.ts",
            "frontend/slices/assistant/lib/tools.ts",
            "frontend/slices/assistant/lib/types.ts",
            "lib/shared/agentic/agent-loop.ts",
            "lib/shared/agentic/global-host.ts",
            "lib/shared/agentic/host.ts",
            "lib/shared/agentic/prompt.ts",
            "lib/shared/agentic/registry.ts",
            "lib/shared/agentic/types.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "badge",
      "button",
      "dropdown-menu",
      "input",
      "scroll-area",
      "switch",
      "textarea"
    ],
    "env": [],
    "peers": [],
    "sharedFiles": [
      "lib/shared/agentic/types.ts",
      "lib/shared/agentic/host.ts",
      "lib/shared/agentic/agent-loop.ts",
      "lib/shared/agentic/prompt.ts",
      "lib/shared/agentic/registry.ts",
      "lib/shared/agentic/global-host.ts"
    ]
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:ui-consistency"
  ],
  "license": "MIT",
  "tags": [
    "ai",
    "assistant",
    "chat",
    "agents",
    "streaming",
    "automations",
    "ui",
    "svelte",
    "framework-parity",
    "tool-calling"
  ],
  "previews": [],
  "contract": {
    "requires": {
      "auth": "none",
      "deps": []
    },
    "provides": {
      "routes": [],
      "components": [
        "Assistant",
        "ChatPanel"
      ],
      "hooks": [],
      "utils": [
        "registerAssistantTools",
        "getAssistantRegistry",
        "configureAgentStream",
        "configureAssistantStream",
        "assistantApp",
        "assistantStoreActions",
        "runAssistantTurn"
      ],
      "tables": []
    }
  }
}
