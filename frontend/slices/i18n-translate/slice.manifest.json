{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "i18n-translate",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add i18n-translate",
    "consumerPath": "slices/i18n-translate"
  },
  "files": [
    "README.md",
    "components/GoogleTranslate.tsx",
    "config.ts",
    "hooks/useGoogleTranslate.ts",
    "index.ts",
    "lib/cookie.ts",
    "lib/defaults.ts",
    "lib/storage.ts",
    "lib/styles.ts",
    "lib/types.ts",
    "lib/widget.ts"
  ],
  "imports": {
    "shared": [],
    "external": [
      "lucide-react",
      "next/navigation",
      "react"
    ]
  }
}
