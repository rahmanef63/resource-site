{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "code-editor",
  "version": "1.3.0",
  "category": "os",
  "kind": "ui",
  "title": "Code \u2014 overlay syntax editor",
  "description": "Framework-parity lightweight code editor over one observable editor/filesystem core. React/Next remains the default renderer with Lucide/shadcn + appshell inspector/agent registration; explicit Svelte 5/SvelteKit adds a native explorer, tabs, overlay syntax editor, create/save flow, status bar, payload-open handoff, and optional tool-registration hook over the same CodeFsAdapter, writable mock filesystem, buffers, dirty/save state, highlighter, and tool semantics.",
  "namespace": "@/features/code-editor",
  "frontend": {
    "slicePath": "frontend/slices/code-editor",
    "configExport": "codeEditorConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/code-editor-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/code-editor/config.ts",
            "frontend/slices/code-editor/lib/editor-core.ts",
            "frontend/slices/code-editor/lib/fs-core.ts",
            "frontend/slices/code-editor/lib/highlight.ts",
            "frontend/slices/code-editor/lib/mock-fs.ts",
            "frontend/slices/code-editor/lib/seed.ts",
            "frontend/slices/code-editor/lib/tools.ts",
            "frontend/slices/code-editor/lib/util.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button",
      "badge",
      "input",
      "textarea",
      "scroll-area",
      "sheet",
      "dialog"
    ],
    "env": [],
    "peers": [],
    "sharedFiles": [
      "lib/shared/agentic/types.ts",
      "lib/shared/agentic/define.ts",
      "lib/shared/agentic/schema.ts",
      "lib/shared/agentic/prompt.ts",
      "lib/shared/agentic/registry.ts",
      "lib/shared/agentic/global-host.ts",
      "lib/shared/agentic/use-agent-tools.ts"
    ]
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:ui-consistency"
  ],
  "license": "MIT",
  "tags": [
    "code",
    "editor",
    "syntax-highlight",
    "ide",
    "ui",
    "svelte",
    "framework-parity",
    "filesystem",
    "agent-tools"
  ],
  "previews": [
    {
      "component": "CodeEditor",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "sample-tree",
          "title": "Sample tree",
          "description": "Seeded mock fs, default file open"
        },
        {
          "id": "markdown-doc",
          "title": "Markdown doc",
          "description": "Opens /Documents/roadmap.md via payload"
        },
        {
          "id": "python-script",
          "title": "Python script",
          "description": "Opens /apps/scraper.py via payload"
        }
      ],
      "seed": "bundled writable in-memory mock fs (lib/seed.ts); edits live for the mount"
    }
  ],
  "contract": {
    "requires": {
      "auth": "none",
      "deps": [
        {
          "npm": "react",
          "range": "^19"
        },
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "tools": [
        "code-editor.inspect",
        "code-editor.file.open",
        "code-editor.file.create",
        "code-editor.file.read",
        "code-editor.edit.set",
        "code-editor.edit.replace",
        "code-editor.file.save",
        "code-editor.tab.switch",
        "code-editor.tab.close"
      ],
      "routes": [],
      "components": [
        "CodeEditor"
      ],
      "hooks": [],
      "utils": [
        "configureCodeFs",
        "getCodeFs",
        "createMockFs",
        "createEditorCore",
        "createEditorContext",
        "codeEditorApp"
      ],
      "tables": []
    }
  }
}
