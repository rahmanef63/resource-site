{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "icon-picker",
  "version": "0.6.0",
  "category": "ui",
  "kind": "ui",
  "title": "Icon Picker",
  "description": "Framework-parity emoji + Lucide + Phosphor icon picker. React/Next remains default; native Svelte 5/SvelteKit preserves the same stored-value format, search/catalog/color/random/clear/recents semantics, Twemoji/native preference, keyboard navigation, and smart popover\u2192dialog fallback over shared framework-neutral stores and handlers.",
  "namespace": "@/features/icon-picker",
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "frontend": {
    "slicePath": "frontend/slices/icon-picker",
    "configExport": "",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/icon-picker-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5",
            "@lucide/svelte@^1.46.0",
            "phosphor-svelte@^3.1.0"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/icon-picker/lib/colors.ts",
            "frontend/slices/icon-picker/lib/defaults.ts",
            "frontend/slices/icon-picker/lib/emoji-catalog.ts",
            "frontend/slices/icon-picker/lib/emoji-keywords.ts",
            "frontend/slices/icon-picker/lib/icon-render-config.ts",
            "frontend/slices/icon-picker/lib/lucide-catalog.ts",
            "frontend/slices/icon-picker/lib/parse.ts",
            "frontend/slices/icon-picker/lib/phosphor-catalog.ts",
            "frontend/slices/icon-picker/lib/picker-handlers.ts",
            "frontend/slices/icon-picker/lib/recents-core.ts",
            "frontend/slices/icon-picker/lib/search-haystacks.ts",
            "frontend/slices/icon-picker/lib/style-core.ts",
            "frontend/slices/icon-picker/lib/tools.ts",
            "frontend/slices/icon-picker/lib/twemoji.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0",
      "@phosphor-icons/react@^2.1.10"
    ],
    "shadcn": [
      "popover",
      "dialog",
      "button",
      "input",
      "scroll-area",
      "tabs"
    ],
    "env": [],
    "peers": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "ui",
    "icon",
    "emoji",
    "lucide",
    "phosphor",
    "picker",
    "twemoji",
    "notion",
    "responsive",
    "svelte",
    "framework-parity"
  ],
  "previews": [
    {
      "component": "IconPickerInline",
      "kind": "variants",
      "axes": [
        {
          "prop": "style",
          "values": [
            "twemoji",
            "native"
          ],
          "default": "twemoji",
          "description": "Emoji render style \u2014 Twemoji SVG (Notion-consistent) vs the native OS emoji font. Drives setIconStyle; the picked icon previews in both modes."
        }
      ],
      "seed": "Picked icon value persisted in the demo store; the chosen emoji renders above the picker via DynamicIcon."
    }
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "tools": [
        "icon-picker.search",
        "icon-picker.pick"
      ],
      "components": [
        "IconPicker",
        "IconPickerInline",
        "DynamicIcon",
        "PickerSkeleton"
      ],
      "utils": [
        "parseIconValue",
        "lucideValue",
        "withColor",
        "isLucideValue",
        "LUCIDE_PREFIX"
      ],
      "hooks": [
        "useRecentIcons",
        "useIconStyle"
      ],
      "convex": {
        "tables": [],
        "rbac": []
      }
    }
  }
}
