{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "reel-editor",
  "version": "1.3.0",
  "category": "os",
  "kind": "ui",
  "title": "Reel \u2014 video timeline editor",
  "description": "Framework-parity in-browser video timeline editor. React/Next remains default; native Svelte 5/SvelteKit reuses the same immutable composition, observable undo/redo history, Canvas-2D preview/export draw path, MediaCache/audio graph, keyframes/transitions, AI transform core, local draft/settings, filesystem seam, and realtime WebM renderer. Svelte covers preview/playback, layered timeline, track controls, clip inspector, media/file/sample import, AI commands, keyboard shortcuts, autosave, settings and WebM export without React/Next/Lucide React/shadcn/Sonner/resizable-panels/agent runtime.",
