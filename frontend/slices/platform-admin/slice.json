{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "platform-admin",
  "version": "0.3.0",
  "category": "infra",
  "title": "Platform Admin — Control Plane Contract",
  "description": "Framework-neutral privileged control-plane tool contract. The host injects metrics, feature-flag, and tenant-tier operations through PlatformAdminCtx and must enforce platform-admin authorization at the server boundary. React/Next remains the default install contract while explicit Svelte/SvelteKit reuses the same TypeScript source; the canonical slice intentionally ships no renderer, persistence schema, or tenant model.",
  "namespace": "@/features/platform-admin",
  "kind": "backend",
  "frontend": {
    "slicePath": "frontend/slices/platform-admin",
    "configExport": "platformAdminConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/platform-admin",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [],
          "shadcn": []
        }
      }
    }
  },
  "deps": {
    "npm": [],
    "shadcn": [],
    "env": [],
    "peers": []
  },
  "registers": [
    "registry"
  ],
  "audit": [],
  "license": "MIT",
  "tags": [
    "infra",
    "admin",
    "multi-tenant",
    "saas",
    "platform"
  ],
  "contract": {
    "requires": {
      "rbac": [
        "platform.workspace.list",
        "platform.feature_flag.set",
        "platform.tier.set"
      ],
      "deps": []
    },
    "provides": {
      "tools": [
        "platform-admin.metrics",
        "platform-admin.feature_flag.set",
        "platform-admin.tier.set"
      ],
      "routes": [],
      "hooks": [],
      "tables": [],
      "components": []
    },
    "generalization": {
      "level": "needs-adapter",
      "requiredProps": [
        "metrics",
        "setFeatureFlag",
        "setTier"
      ]
    }
  },
  "previews": []
}
