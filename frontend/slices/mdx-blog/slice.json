{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "mdx-blog",
  "version": "0.1.0",
  "category": "content",
  "title": "MDX Blog",
  "description": "File-based MDX blog under content/blog/*.mdx. List + detail page + RSS feed. No backend.",
