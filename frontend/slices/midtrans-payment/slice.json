{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "midtrans-payment",
  "version": "0.1.0",
  "category": "payment",
  "title": "Midtrans — Indonesia Payment",
  "description": "Midtrans Snap checkout + webhook handler + transaction history. Provider-isolated under components/providers/midtrans + actions/midtrans so Doku/Stripe can land as siblings without API churn.",
  "namespace": "@/features/midtrans-payment",
  "convex": {
    "tablesExport": "paymentTables",
    "schemaPath": "convex/features/payment/schema.ts",
    "rootPaths": ["convex/features/payment"]
  },
  "frontend": {
    "slicePath": "frontend/slices/midtrans-payment",
    "configExport": "midtransPaymentConfig"
  },
  "deps": {
    "npm": ["midtrans-client@^1.4.2"],
    "shadcn": ["card", "button", "dialog", "input", "label"],
    "env": [
      { "name": "MIDTRANS_SERVER_KEY", "scope": "convex", "required": true },
      { "name": "MIDTRANS_CLIENT_KEY", "scope": "next-public", "required": true },
      { "name": "MIDTRANS_IS_PRODUCTION", "scope": "convex", "required": false, "description": "true|false; defaults false (sandbox)." }
    ],
    "peers": [
      { "slug": "convex-auth", "range": "^0.1", "reason": "Order ownership requires authenticated user." }
    ]
  },
  "registers": ["registry"],
  "audit": ["bp:public-fn-validator"],
  "license": "MIT",
  "tags": ["payment", "midtrans", "indonesia", "qris", "snap"],
  "providers": ["midtrans"]
}
