{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "os-terminal",
  "version": "1.3.1",
  "category": "os",
  "kind": "ui",
  "title": "Terminal — shell emulator with live passthrough + PTY seam",
  "description": "Framework-parity terminal shell: React/Next remains the default renderer, while explicit Svelte/SvelteKit installs native Svelte 5 exec + PTY UI over the same command dispatcher, mock filesystem, live TerminalOsApi, SSE PTY transport, and agentic tools. Mock mode stays zero-backend; configureTerminal({ mode:\"live\", fs, exec, sys }) enables real host truth and configurePty({ transport, screen }) unlocks an injected interactive shell. Terminal/PTy configuration changes are observable after mount in both frameworks.",
  "namespace": "@/features/os-terminal",
  "frontend": {
    "slicePath": "frontend/slices/os-terminal",
    "configExport": "osTerminalConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/os-terminal-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/os-terminal/config.ts",
            "frontend/slices/os-terminal/lib/commands.ts",
            "frontend/slices/os-terminal/lib/commands-fs.ts",
            "frontend/slices/os-terminal/lib/fs-model.ts",
            "frontend/slices/os-terminal/lib/host-core.ts",
            "frontend/slices/os-terminal/lib/host-mock.ts",
            "frontend/slices/os-terminal/lib/tools.ts",
            "frontend/slices/os-terminal/lib/use-pty.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button"
    ],
    "env": [],
    "peers": [],
    "sharedFiles": [
      "lib/shared/agentic/types.ts",
      "lib/shared/agentic/define.ts",
      "lib/shared/agentic/schema.ts",
      "lib/shared/agentic/prompt.ts",
      "lib/shared/agentic/registry.ts",
      "lib/shared/agentic/global-host.ts",
      "lib/shared/agentic/use-agent-tools.ts"
    ]
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:ui-consistency"
  ],
  "license": "MIT",
  "tags": [
    "terminal",
    "shell",
    "cli",
    "emulator",
    "exec",
    "pty",
    "ui",
    "svelte",
    "framework-parity"
  ],
  "previews": [],
  "contract": {
    "requires": {
      "auth": "none",
      "deps": [
        {
          "npm": "react",
          "range": "^19"
        },
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "tools": [
        "os-terminal.run",
        "os-terminal.cwd",
        "os-terminal.clear"
      ],
      "routes": [],
      "components": [
        "Terminal"
      ],
      "hooks": [],
      "utils": [
        "configureTerminal",
        "configurePty",
        "createSsePtyTransport",
        "osTerminalApp",
        "getOsApi",
        "getTerminalMode",
        "subscribeTerminal",
        "hasPty",
        "subscribePty"
      ],
      "tables": []
    }
  }
}
