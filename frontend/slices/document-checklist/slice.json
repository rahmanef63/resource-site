{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "document-checklist",
  "version": "0.1.0",
  "category": "content",
  "kind": "full",
  "title": "Document Checklist — Job-Search Doc Tracker",
  "description": "Track required job-search documents (CV, KTP, ijazah, etc.) with country-scoped seed templates and per-user completion state. Toggle completed + notes + expiry per item. Indonesian copy ships out-of-the-box.",
  "namespace": "@/features/document-checklist",
  "convex": {
    "tablesExport": "documentChecklistTables",
    "schemaPath": "convex/features/document-checklist/_schema.ts",
    "rootPaths": ["convex/features/document-checklist"]
  },
  "frontend": {
    "slicePath": "frontend/slices/document-checklist",
    "configExport": "documentChecklistConfig"
  },
  "deps": {
    "npm": ["lucide-react"],
    "shadcn": [
      "badge",
      "button",
      "card",
      "dialog",
      "label",
      "progress",
      "scroll-area",
      "skeleton",
      "tabs",
      "textarea"
    ],
    "env": [],
    "peers": [
      {
        "slug": "convex-auth",
        "range": "^0.1",
        "reason": "Auth identity for user-scoped checklist state."
      }
    ]
  },
  "registers": ["registry"],
  "audit": ["bp:public-fn-validator"],
  "license": "MIT",
  "tags": ["career", "documents", "checklist", "job-search", "indonesia"]
}
