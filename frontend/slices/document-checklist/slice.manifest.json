{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "document-checklist",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add document-checklist",
    "consumerPath": "slices/document-checklist"
  },
  "files": [
    "index.ts",
    "config.ts",
    "README.md",
    "components/CountryTemplateCard.tsx",
    "components/TemplatePreviewDialog.tsx",
    "components/country-template-types.ts",
    "components/DocumentChecklist.tsx",
    "components/document-checklist/CategoryFilter.tsx",
    "components/document-checklist/CategorySection.tsx",
    "components/document-checklist/ChecklistItemCard.tsx",
    "components/document-checklist/ItemDetailDialog.tsx",
    "components/document-checklist/ProgressGrid.tsx",
    "constants/icons.ts",
    "data/indonesianData.ts",
    "hooks/useChecklistData.ts",
    "lib/layout.tsx",
    "types/index.ts"
  ],
  "convex": {
    "schemaPath": "convex/features/document-checklist/schema.ts",
    "rootPaths": ["convex/features/document-checklist"]
  },
  "imports": {
    "shared": [
      "@/components/ui/card",
      "@/components/ui/button",
      "@/components/ui/checkbox",
      "@/components/ui/dialog",
      "@/components/ui/input",
      "@/components/ui/progress",
      "@/components/ui/badge"
    ],
    "external": ["react", "convex/react", "lucide-react"]
  }
}
