{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "pages-cms",
  "version": "0.2.0",
  "category": "content",
  "kind": "ui",
  "title": "Pages CMS \u2014 block-composed multi-page editor",
  "description": "A small multi-page CMS: list, create, edit, duplicate, and publish pages composed from 11 block kinds (hero, text, feature-list, cta, logo-cloud, testimonial, video, image-gallery, faq, stats, pricing-table). Admin views (PagesView list + CRUD, PageEditorView block editor) plus a read-only public BlockRenderer. Ships a localStorage adapter (LocalPagesProvider) + a generic Home/About/Pricing seed so it runs env-free \u2014 or wire the bundled reducer/store-context to your own backend. Pure UI; no Convex required.",
  "namespace": "@/features/pages-cms",
  "frontend": {
    "slicePath": "frontend/slices/pages-cms",
    "configExport": "pagesCmsFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/pages-cms-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/pages-cms/config.ts",
            "frontend/slices/pages-cms/types.ts",
            "frontend/slices/pages-cms/lib/core.ts",
            "frontend/slices/pages-cms/lib/default-pages.ts",
            "frontend/slices/pages-cms/lib/duplicate.ts",
            "frontend/slices/pages-cms/lib/nav-builder.ts",
            "frontend/slices/pages-cms/lib/reducer.ts"
          ]
        }
      }
    }
  },
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "badge",
      "button",
      "table",
      "input",
      "textarea",
      "label",
      "select",
      "switch",
      "card",
      "dialog"
    ],
    "env": [],
    "peers": [],
    "sharedFiles": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "content",
    "cms",
    "pages",
    "blocks",
    "editor",
    "builder",
    "basics"
  ],
  "previews": [],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "tools": [],
      "components": [
        "PagesView",
        "PageEditorView",
        "PageEditorBlocks",
        "BlockEditor",
        "BlockRenderer",
        "BlocksRenderer",
        "PageCreateDialog",
        "PagesProvider",
        "LocalPagesProvider"
      ],
      "utils": [
        "pagesReducer",
        "duplicatePage",
        "blankPage",
        "buildPageNavItems",
        "defaultPages",
        "emptyBlock"
      ],
      "hooks": [
        "usePagesStore",
        "usePage"
      ],
      "convex": {
        "tables": [],
        "rbac": []
      }
    }
  }
}
