{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "motion-kit",
  "version": "0.2.0",
  "category": "ui",
  "kind": "ui",
  "title": "Motion Kit \u2014 scroll reveals, carousel, accordion, micro-interactions",
  "description": "Framework-parity motion primitives: shared IntersectionObserver/easing/CSS core plus React/Next default and native Svelte 5/SvelteKit distributions for reveal, stagger, count-up, marquee, Embla carousel, and accessible accordion. Both distributions respect reduced motion; Svelte uses Embla core with explicit destroy cleanup and carries no React/Lucide/Radix runtime.",
  "namespace": "@/features/motion-kit",
  "registers": [],
  "audit": [],
  "frontend": {
    "slicePath": "frontend/slices/motion-kit",
    "configExport": "",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/motion-kit-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5",
            "embla-carousel@^8.6.0",
            "embla-carousel-autoplay@^8.6.0"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/motion-kit/globals-motion.css",
            "frontend/slices/motion-kit/lib/core.ts"
          ]
        }
      }
    }
  },
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "deps": {
    "npm": [
      "embla-carousel-react@^8.6.0",
      "embla-carousel-autoplay@^8.6.0",
      "radix-ui@^1.4.3",
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button"
    ],
    "env": [],
    "peers": []
  },
  "previews": [
    {
      "component": "Reveal",
      "kind": "variants",
      "axes": [
        {
          "prop": "variant",
          "values": [
            "fade-up",
            "zoom"
          ],
          "default": "fade-up",
          "description": "Scroll-reveal entrance \u2014 element animates in on first intersection (respects prefers-reduced-motion)."
        }
      ],
      "seed": "Scroll the preview frame; wrapped content fades/zooms in once it enters the viewport. Append globals-motion.css for the transitions to take effect."
    }
  ],
  "contract": {
    "provides": {
      "components": [
        "Reveal",
        "Stagger",
        "CountUp",
        "Marquee",
        "Carousel",
        "CarouselContent",
        "CarouselItem",
        "CarouselPrevious",
        "CarouselNext",
        "Accordion",
        "AccordionItem",
        "AccordionTrigger",
        "AccordionContent"
      ],
      "utils": [
        "observeInView",
        "staggerDelay",
        "countAt",
        "easeOutCubic"
      ],
      "hooks": [
        "useInView"
      ],
      "types": [
        "RevealVariant",
        "CarouselApi"
      ]
    },
    "generalization": {
      "level": "portable"
    }
  }
}
