{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "booking-svelte",
  "version": "1.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add booking --framework sveltekit",
    "consumerPath": "slices/booking"
  },
  "files": [
    "README.md",
    "components/Booking.svelte",
    "config.ts",
    "index.ts",
    "lib/host.ts",
    "lib/request.ts",
    "svelte-components.d.ts"
  ],
  "imports": {
    "shared": [],
    "external": ["svelte"]
  }
}
