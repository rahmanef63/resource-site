{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "quicklinks-svelte",
  "version": "1.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add quicklinks --framework sveltekit",
    "consumerPath": "slices/quicklinks"
  },
  "files": [
    "README.md",
    "components/QuicklinksApp.svelte",
    "config.ts",
    "index.ts",
    "lib/store.ts",
    "svelte-components.d.ts"
  ],
  "imports": {
    "shared": [
      "frontend/slices/quicklinks/lib/core.ts"
    ],
    "external": [
      "svelte"
    ]
  }
}
