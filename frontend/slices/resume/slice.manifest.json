{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "resume",
  "version": "1.0.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add resume",
    "consumerPath": "slices/resume"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "app.tsx",
    "components/section.tsx",
    "config.ts",
    "index.ts",
    "lib/host.ts",
    "slice.json"
  ],
  "imports": {
    "shared": [
      "@/components/ui/button",
      "@/components/ui/scroll-area"
    ],
    "external": ["react", "lucide-react"]
  }
}
