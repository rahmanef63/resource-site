{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "changelog-feed",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add changelog-feed",
    "consumerPath": "slices/changelog-feed"
  },
  "files": [
    "README.md",
    "components/ChangelogEntryCard.tsx",
    "config.ts",
    "index.ts",
    "views/ChangelogFeedSection.tsx"
  ],
  "imports": {
    "shared": [],
    "external": [
      "@/components/ui/badge",
      "@/components/ui/card",
      "@/components/ui/separator",
      "@/lib/utils"
    ]
  }
}
