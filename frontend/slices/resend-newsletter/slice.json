{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "resend-newsletter",
  "version": "0.3.1",
  "category": "integrations",
  "kind": "full",
  "title": "Resend — Transactional & Newsletter",
  "description": "Truthful single-opt-in newsletter slice with adapter-backed React/Next and native Svelte 5 subscribe forms, a self-contained Convex subscriber/issue backend, public unsubscribe, host-authorized list/send adapters, and internal Resend campaign workers. No frontend fake-success timer, unimplemented double-opt-in claim, or hidden auth-schema dependency remains.",
  "namespace": "@/features/resend-newsletter",
  "convex": {
    "tablesExport": "newsletterTables",
    "schemaPath": "convex/features/newsletter/_schema.ts",
    "rootPaths": [
      "convex/features/newsletter"
    ]
  },
  "frontend": {
    "slicePath": "frontend/slices/resend-newsletter",
    "configExport": "resendNewsletterConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/resend-newsletter-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5",
            "resend@^6.12.4"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/resend-newsletter/lib/core.ts",
            "frontend/slices/resend-newsletter/lib/host.ts",
            "frontend/slices/resend-newsletter/lib/tools.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "resend@^6.12.4"
    ],
    "shadcn": [
      "button",
      "card",
      "input",
      "label"
    ],
    "env": [
      {
        "name": "RESEND_API_KEY",
        "scope": "convex",
        "required": true,
        "description": "Server-only Resend API key used by the internal campaign worker."
      },
      {
        "name": "RESEND_FROM",
        "scope": "convex",
        "required": true,
        "description": "Verified sender address, e.g. hello@yourdomain.com."
      }
    ],
    "peers": [],
    "sharedFiles": [
      "frontend/slices/resend-newsletter/lib/core.ts",
      "frontend/slices/resend-newsletter/lib/host.ts",
      "frontend/slices/resend-newsletter/lib/tools.ts"
    ]
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:public-fn-validator"
  ],
  "license": "MIT",
  "tags": [
    "email",
    "newsletter",
    "resend",
    "broadcast",
    "svelte"
  ],
  "previews": [],
  "contract": {
    "requires": {
      "auth": "none",
      "rbac": [],
      "env": [
        "RESEND_API_KEY",
        "RESEND_FROM"
      ],
      "deps": []
    },
    "provides": {
      "tools": [
        "resend-newsletter.subscribe",
        "resend-newsletter.unsubscribe",
        "resend-newsletter.list",
        "resend-newsletter.send_campaign"
      ],
      "routes": [
        "/newsletter"
      ],
      "components": [
        "SubscribeForm"
      ],
      "utils": [
        "configureResendNewsletter",
        "newsletterPublicApi",
        "normalizeNewsletterEmail"
      ],
      "convex": {
        "tables": [
          "newsletterSubscribers",
          "newsletterIssues",
          "newsletterSubscribeAttempts"
        ],
        "rbac": [
          "admin"
        ]
      },
      "tables": [
        "newsletterSubscribers",
        "newsletterIssues",
        "newsletterSubscribeAttempts"
      ]
    },
    "generalization": {
      "level": "needs-adapter",
      "requiredProps": [
        "subscribe",
        "unsubscribe",
        "listSubscribers",
        "sendBroadcast"
      ]
    }
  }
}
