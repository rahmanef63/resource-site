{
  "$schema": "../../../docs/slice.manifest.schema.json",
  "name": "resend-newsletter",
  "version": "0.2.0",
  "description": "Newsletter subscribe form + admin send-broadcast pipeline via Resend transactional email.",
  "category": "content",
  "stability": "beta",
  "deps": {
    "shared": [],
    "slices": [],
    "convexFeatures": [
      "newsletter"
    ],
    "npm": {
      "resend": "^4.0.0"
    },
    "env": [
      {
        "name": "RESEND_API_KEY",
        "required": true,
        "scope": "server",
        "description": "Resend API key from https://resend.com/api-keys"
      },
      {
        "name": "RESEND_FROM",
        "required": true,
        "scope": "server",
        "example": "hello@yourdomain.com",
        "description": "Verified sender address. Domain must be verified in Resend dashboard."
      }
    ]
  },
  "files": {
    "include": [
      "**/*"
    ],
    "exclude": [
      "*.test.ts",
      "*.test.tsx"
    ]
  },
  "convexFiles": {
    "include": [
      "**/*.ts"
    ],
    "exclude": [
      "*.test.ts"
    ]
  },
  "permissions": [
    "newsletter.subscribe",
    "newsletter.unsubscribe",
    "newsletter.send-broadcast",
    "newsletter.list-subscribers"
  ],
  "schemaTables": [
    {
      "name": "newsletter_subscribers",
      "namespaced": true,
      "indexes": [
        "by_email",
        "by_status",
        "by_workspace"
      ]
    },
    {
      "name": "newsletter_broadcasts",
      "namespaced": true,
      "indexes": [
        "by_workspace",
        "by_workspace_sentAt"
      ]
    }
  ],
  "compatibility": {
    "next": ">=15 <17",
    "react": "^19",
    "convex": "^1.36",
    "tailwind": "3||4",
    "auth": "any"
  },
  "hooks": {
    "postInstall": [
      "echo 'Verify sender domain in Resend dashboard before send-broadcast works.'",
      "echo 'Optional: set up webhook for bounce/complaint handling.'"
    ]
  },
  "tags": [
    "email",
    "newsletter",
    "resend",
    "broadcast",
    "transactional"
  ],
  "notes": "Subscribe form public, send-broadcast admin-only. Schema uses workspace isolation. Double opt-in flow recommended \u2014 add token verification mutation to harden production use."
}
