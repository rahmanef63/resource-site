{
  "$schema": "../../../docs/slice.manifest.schema.json",
  "name": "resend-newsletter",
  "version": "0.3.1",
  "description": "Single-opt-in newsletter UI + real Convex subscriber/campaign backend + admin-gated Resend delivery worker.",
  "category": "content",
  "stability": "beta",
  "deps": {
    "shared": [],
    "slices": [],
    "convexFeatures": [
      "newsletter"
    ],
    "npm": {
      "resend": "^6.12.4"
    },
    "env": [
      {
        "name": "RESEND_API_KEY",
        "required": true,
        "scope": "server",
        "description": "Server-only Resend API key."
      },
      {
        "name": "RESEND_FROM",
        "required": true,
        "scope": "server",
        "example": "hello@yourdomain.com",
        "description": "Verified sender address."
      }
    ]
  },
  "files": {
    "include": [
      "**/*"
    ],
    "exclude": [
      "*.test.ts",
      "*.test.tsx"
    ]
  },
  "convexFiles": {
    "include": [
      "**/*.ts"
    ],
    "exclude": [
      "*.test.ts"
    ]
  },
  "permissions": [],
  "schemaTables": [
    {
      "name": "newsletterSubscribers",
      "namespaced": false,
      "indexes": [
        "by_email",
        "by_status_subscribedAt"
      ]
    },
    {
      "name": "newsletterIssues",
      "namespaced": false,
      "indexes": [
        "by_status_createdAt"
      ]
    },
    {
      "name": "newsletterSubscribeAttempts",
      "namespaced": false,
      "indexes": [
        "by_email_time",
        "by_attemptedAt"
      ]
    }
  ],
  "compatibility": {
    "next": ">=15 <17",
    "react": "^19",
    "convex": "^1.36",
    "tailwind": "4",
    "auth": "any"
  },
  "hooks": {
    "postInstall": [
      "echo 'Verify RESEND_FROM in Resend before scheduling a campaign.'"
    ]
  },
  "tags": [
    "email",
    "newsletter",
    "resend",
    "broadcast",
    "single-opt-in"
  ],
  "notes": "Public subscribe is single opt-in and unsubscribe is idempotent. List/send remain host-authorized adapters; only internal Convex campaign workers touch Resend."
}
