{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "loading-states",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add loading-states",
    "consumerPath": "slices/loading-states"
  },
  "files": [
    "README.md",
    "components/LoadingSkeleton.tsx",
    "components/LoadingState.tsx",
    "components/presets.ts",
    "config.ts",
    "index.ts"
  ],
  "imports": {
    "shared": [],
    "external": [
      "@/components/ui/skeleton",
      "@/components/ui/spinner"
    ]
  }
}
