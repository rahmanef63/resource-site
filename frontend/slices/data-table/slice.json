{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "data-table",
  "version": "0.3.0",
  "category": "data",
  "kind": "ui",
  "title": "Data Table — TanStack",
  "description": "Framework-parity data table: React/Next remains default on TanStack React Table v8 + shadcn, while explicit Svelte/SvelteKit installs the official Svelte 5 TanStack Table v9 adapter with native semantic controls. Both surfaces cover sorting, column-bound filtering, pagination, row selection, column visibility, and compact/comfortable density over shared labels/summary semantics.",
  "namespace": "@/features/data-table",
  "frontend": {
    "slicePath": "frontend/slices/data-table",
    "configExport": "dataTableFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/data-table-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5",
            "@tanstack/svelte-table@^9.2.4"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/data-table/lib/core.ts"
          ]
        }
      }
    }
  },
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "deps": {
    "npm": [
      "@tanstack/react-table@^8.21.3",
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "table",
      "button",
      "input",
      "checkbox",
      "dropdown-menu"
    ],
    "env": [],
    "peers": [],
    "sharedFiles": [
      "frontend/slices/data-table/lib/core.ts"
    ]
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "data",
    "table",
    "datagrid",
    "tanstack",
    "sorting",
    "pagination",
    "svelte",
    "framework-parity"
  ],
  "previews": [
    {
      "component": "DataTable",
      "kind": "variants",
      "axes": [
        {
          "prop": "density",
          "values": [
            "compact",
            "comfortable"
          ],
          "default": "comfortable",
          "description": "Row padding density"
        },
        {
          "prop": "selectable",
          "values": [
            "on",
            "off"
          ],
          "default": "on",
          "description": "Checkbox row-selection column"
        }
      ],
      "seed": "12 static invoice rows (id, customer, status, amount, date)"
    }
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "@tanstack/react-table",
          "range": "^8.21.0"
        },
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "tools": [],
      "components": [
        "DataTable",
        "DataTableToolbar",
        "DataTablePagination",
        "DataTableColumnHeader"
      ],
      "utils": [
        "selectionColumn",
        "resolveDataTableLabels",
        "dataTableCellPadding",
        "dataTableRowSummary",
        "dataTablePageSummary"
      ],
      "hooks": [],
      "convex": {
        "tables": [],
        "rbac": []
      },
      "types": [
        "DataTableDensity",
        "DataTableLabels"
      ]
    },
    "generalization": {
      "level": "portable"
    }
  }
}
