{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "full-width-toggle",
  "version": "0.2.0",
  "category": "ui",
  "kind": "ui",
  "title": "Full Width Toggle",
  "description": "Page-container width toggle (contained / wide / full). Per-device localStorage with cross-tab sync. React/Next remains default; explicit Svelte/SvelteKit distribution is available with the same storage and layout semantics. Three components: useFullWidth hook, FullWidthToggle button (icon / button / segment variants), WidthContainer wrapper. Drop in app shell.",
  "namespace": "@/features/full-width-toggle",
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "frontend": {
    "slicePath": "frontend/slices/full-width-toggle",
    "configExport": "fullWidthToggleConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/full-width-toggle-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": []
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button"
    ],
    "env": [],
    "peers": []
  },
  "registers": [],
  "license": "MIT",
  "tags": [
    "ui",
    "layout",
    "preference",
    "localstorage",
    "dashboard"
  ],
  "providers": [],
  "previews": [
    {
      "component": "FullWidthToggle",
      "kind": "variants",
      "axes": [
        {
          "prop": "variant",
          "values": [
            "icon",
            "button",
            "segment"
          ],
          "default": "icon",
          "description": "Chrome shape — icon button, labeled button, or 3-segment toggle"
        }
      ],
      "seed": "uses the slice's own localStorage width-mode key; sample container reacts live"
    }
  ],
  "contract": {
    "requires": {
      "auth": "none"
    },
    "provides": {
      "hooks": [
        "useFullWidth"
      ],
      "components": [
        "FullWidthToggle",
        "WidthContainer"
      ]
    },
    "generalization": {
      "level": "portable"
    }
  }
}
