{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "ai-admin",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add ai-admin",
    "consumerPath": "slices/ai-admin"
  },
  "files": [
    "index.ts",
    "README.md",
    "types.ts",
    "config.ts",
    "components/AdminSection.tsx",
    "components/ProvidersTable.tsx",
    "components/ModelsGrid.tsx",
    "components/SkillsGrid.tsx",
    "components/ToolsTable.tsx",
    "components/AgentsTable.tsx",
    "components/BudgetsCard.tsx",
    "components/AuditTable.tsx",
    "hooks/useAiAdmin.ts",
    "lib/encrypt.ts"
  ],
  "convex": {
    "schemaPath": "convex/features/ai-admin/schema.ts",
    "rootPaths": ["convex/features/ai-admin"]
  },
  "imports": {
    "shared": [
      "@/components/ui/card",
      "@/components/ui/button",
      "@/components/ui/badge",
      "@/components/ui/tabs",
      "@/components/ui/table",
      "@/components/ui/dialog",
      "@/components/ui/input",
      "@/components/ui/label",
      "@/components/ui/select",
      "@/components/ui/textarea",
      "@/components/ui/switch",
      "@/lib/utils"
    ],
    "external": ["react", "lucide-react"]
  }
}
