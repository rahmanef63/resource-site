{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "file-explorer",
  "version": "1.7.0",
  "category": "os",
  "kind": "full",
  "title": "File Explorer \u2014 Tree + CRUD + Preview + Properties",
  "description": "Framework-parity backend-agnostic file explorer. React/Next remains default; native Svelte 5/SvelteKit provides location sidebar, history + breadcrumbs, grid/list sorting, multi-select, CRUD/clipboard/trash, drag/drop upload, inline image/audio/video/PDF/text preview, editable text + metadata properties, and optional function-calling tool registration over the same FileExplorerAdapter. The bundled in-memory mock keeps real bytes; live REST and structural Convex adapter factories stay portable. Svelte installs no React, Next, Lucide React, shadcn, shared FilePicker, or agent runtime.",
  "namespace": "@/features/file-explorer",
  "frontend": {
    "slicePath": "frontend/slices/file-explorer",
    "configExport": "fileExplorerConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/file-explorer-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/file-explorer/adapter/convex.ts",
            "frontend/slices/file-explorer/adapter/live.ts",
            "frontend/slices/file-explorer/adapter/mock-blobs.ts",
            "frontend/slices/file-explorer/adapter/mock-tree.ts",
            "frontend/slices/file-explorer/adapter/mock.ts",
            "frontend/slices/file-explorer/adapter/types.ts",
            "frontend/slices/file-explorer/lib/file-kinds.ts",
            "frontend/slices/file-explorer/lib/format.ts",
            "frontend/slices/file-explorer/lib/history-core.ts",
            "frontend/slices/file-explorer/lib/ops-core.ts",
            "frontend/slices/file-explorer/lib/read-drop.ts",
            "frontend/slices/file-explorer/lib/tools.ts",
            "frontend/slices/file-explorer/lib/types.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button",
      "input",
      "scroll-area",
      "separator",
      "dropdown-menu",
      "sheet",
      "dialog"
    ],
    "env": [],
    "peers": [],
    "sharedFiles": [
      "components/shared/ui/FilePicker.tsx",
      "lib/shared/agentic/types.ts",
      "lib/shared/agentic/define.ts",
      "lib/shared/agentic/schema.ts",
      "lib/shared/agentic/prompt.ts",
      "lib/shared/agentic/registry.ts",
      "lib/shared/agentic/global-host.ts",
      "lib/shared/agentic/use-agent-tools.ts"
    ]
  },
  "registers": [],
  "audit": [
    "bp:ui-consistency"
  ],
  "license": "MIT",
  "tags": [
    "files",
    "file-manager",
    "explorer",
    "tree",
    "breadcrumb",
    "crud",
    "drag-drop",
    "upload",
    "download",
    "preview",
    "properties",
    "adapter",
    "ui",
    "svelte",
    "framework-parity"
  ],
  "previews": [
    {
      "component": "FileExplorer",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "root",
          "title": "Home root",
          "description": "top-level folders + files"
        },
        {
          "id": "documents",
          "title": "Documents",
          "description": "opens into /Documents"
        },
        {
          "id": "projects",
          "title": "Projects",
          "description": "opens into /Projects"
        }
      ],
      "seed": "in-memory mock adapter (seeded tree); rename / new-folder / move persist for the mount"
    }
  ],
  "contract": {
    "requires": {
      "auth": "none",
      "deps": []
    },
    "provides": {
      "tools": [
        "file-explorer.list",
        "file-explorer.navigate",
        "file-explorer.mkdir",
        "file-explorer.rename",
        "file-explorer.move",
        "file-explorer.trash",
        "file-explorer.remove",
        "file-explorer.empty_trash"
      ],
      "routes": [],
      "components": [
        "FileExplorer"
      ],
      "hooks": [],
      "utils": [
        "createMockAdapter",
        "createLiveAdapter",
        "createConvexAdapter",
        "createFsHistory",
        "createFileOperations"
      ],
      "tables": []
    }
  }
}
