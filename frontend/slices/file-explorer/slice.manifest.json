{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "file-explorer",
  "version": "1.6.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add file-explorer",
    "consumerPath": "slices/file-explorer"
  },
  "files": [
    "CHANGELOG.md",
    "adapter/context.tsx",
    "adapter/convex.ts",
    "adapter/index.ts",
    "adapter/live.ts",
    "adapter/mock-blobs.ts",
    "adapter/mock-tree.ts",
    "adapter/mock.ts",
    "adapter/types.ts",
    "components/drop-overlay.tsx",
    "components/explorer-overlays.tsx",
    "components/explorer-view.tsx",
    "components/file-context-menu.tsx",
    "components/file-crumbs.tsx",
    "components/file-details.tsx",
    "components/file-item.tsx",
    "components/file-preview.tsx",
    "components/file-properties.tsx",
    "components/file-status-bar.tsx",
    "components/file-tree/dir.tsx",
    "components/file-tree/index.tsx",
    "components/file-view.tsx",
    "components/files-sidebar.tsx",
    "components/files-toolbar.tsx",
    "components/upload-input.tsx",
    "config.ts",
    "file-explorer.tsx",
    "hooks/use-dnd.ts",
    "hooks/use-file-commands.ts",
    "hooks/use-file-ops.ts",
    "hooks/use-file-selection.ts",
    "hooks/use-files.ts",
    "hooks/use-fs-history.ts",
    "hooks/use-is-mobile.ts",
    "hooks/use-preview.ts",
    "hooks/use-window-drop.ts",
    "index.ts",
    "lib/backend.ts",
    "lib/errors.ts",
    "lib/format.ts",
    "lib/icons.ts",
    "lib/read-drop.ts",
    "lib/tools.ts",
    "lib/types.ts",
    "preview.tsx"
  ],
  "imports": {
    "shared": [
      "@/components/ui/button",
      "@/components/ui/input",
      "@/components/ui/scroll-area",
      "@/components/ui/separator",
      "@/components/ui/dropdown-menu",
      "@/components/ui/sheet",
      "@/components/ui/dialog",
      "@/shared/ui/FilePicker",
      "@/shared/agentic",
      "@/lib/utils"
    ],
    "external": [
      "react",
      "lucide-react"
    ]
  }
}
