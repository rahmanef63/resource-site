{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "ai-router",
  "version": "0.6.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add ai-router",
    "consumerPath": "slices/ai-router"
  },
  "files": [
    "README.md",
    "components/chat-fab.tsx",
    "config.ts",
    "index.ts",
    "lib/core.ts",
    "lib/tools.ts"
  ],
  "imports": {
    "shared": [
      "lib/shared/agentic/define.ts",
      "lib/shared/agentic/schema.ts"
    ],
    "external": ["react", "lucide-react", "convex", "ai", "@openrouter/ai-sdk-provider"]
  }
}
