{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "ai-router",
  "version": "0.6.0",
  "category": "ai",
  "title": "AI Router — OpenRouter Tier Proxy",
  "description": "Authenticated tier-routed LLM access through one Convex action and OpenRouter. The ChatFab is transport-injected over a shared request/result core: unconfigured hosts return an explicit notice instead of a fake reply. React/Next remains default; SvelteKit ships native Svelte 5 UI over the same core and Convex backend.",
  "namespace": "@/features/ai-router",
  "convex": {
    "tablesExport": "aiTables",
    "schemaPath": "convex/features/ai/_schema.ts",
    "rootPaths": [
      "convex/features/ai"
    ]
  },
  "frontend": {
    "slicePath": "frontend/slices/ai-router",
    "configExport": "aiRouterConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/ai-router-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5",
            "convex@^1.17",
            "ai@^4.0.0",
            "@openrouter/ai-sdk-provider@^0.0.5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/ai-router/config.ts",
            "frontend/slices/ai-router/lib/core.ts",
            "frontend/slices/ai-router/lib/tools.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "convex@^1.17",
      "ai@^4.0.0",
      "@openrouter/ai-sdk-provider@^0.0.5",
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button",
      "card",
      "input"
    ],
    "env": [
      {
        "name": "OPENROUTER_API_KEY",
        "scope": "convex",
        "required": true,
        "description": "Server-side OpenRouter key used only by the Convex action."
      }
    ],
    "peers": []
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:public-fn-validator"
  ],
  "license": "MIT",
  "tags": [
    "ai",
    "llm",
    "openrouter",
    "tier-routing",
    "chat"
  ],
  "previews": [
    {
      "component": "ChatFab",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "demo-transport",
          "title": "Injected preview transport",
          "description": "ChatFab renders a clearly labeled deterministic preview adapter."
        },
        {
          "id": "unconfigured",
          "title": "Unconfigured host",
          "description": "No transport: the shared core returns an explicit wiring notice instead of a fake reply."
        }
      ],
      "seed": "Preview-only route adapter; no OpenRouter request is made."
    }
  ],
  "contract": {
    "requires": {
      "auth": "convex",
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "deps": []
    },
    "provides": {
      "tools": [
        "ai-router.route"
      ],
      "routes": [],
      "components": [
        "ChatFab"
      ],
      "utils": [
        "AI_ROUTER_TIERS",
        "routePrompt",
        "greetingMessage",
        "userMessage",
        "assistantMessage"
      ],
      "convex": {
        "tables": [
          "aiUsage"
        ],
        "rbac": []
      }
    },
    "generalization": {
      "level": "needs-adapter",
      "requiredProps": [
        "route"
      ]
    }
  }
}
