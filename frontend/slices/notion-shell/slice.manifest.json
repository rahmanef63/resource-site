{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "notion-shell",
  "version": "0.23.1",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add notion-shell",
    "consumerPath": "slices/notion-shell"
  },
  "files": [
    "agent.md",
    "block-types.ts",
    "calc-types.ts",
    "components/BlockActionsHandle.tsx",
    "components/BlockActionsMenu.tsx",
    "components/BlockColorPicker.tsx",
    "components/InlineFormatToolbar.tsx",
    "components/InsertBlockButton.tsx",
    "components/MentionTypeahead.tsx",
    "components/NotionBlock.tsx",
    "components/NotionHeader.tsx",
    "components/NotionPage.tsx",
    "components/PageActionsMenu.tsx",
    "components/PageBreadcrumbs.tsx",
    "components/PageLayoutSection.tsx",
    "components/SlashMenu.tsx",
    "components/SortableBlockList.tsx",
    "components/Subpages.tsx",
    "components/blocks/ButtonBlock.tsx",
    "components/blocks/CalloutBlock.tsx",
    "components/blocks/CodeBlock.tsx",
    "components/blocks/ColumnsBlock.tsx",
    "components/blocks/DividerBlock.tsx",
    "components/blocks/EditableLine.tsx",
    "components/blocks/EmbedRenderer.tsx",
    "components/blocks/EquationBlock.tsx",
    "components/blocks/ImageRenderer.tsx",
    "components/blocks/MediaBlock.tsx",
    "components/blocks/PageLinkBlock.tsx",
    "components/blocks/TableBlock.tsx",
    "components/blocks/TocBlock.tsx",
    "components/blocks/ToggleBlock.tsx",
    "components/placeholders.ts",
    "config.ts",
    "index.ts",
    "lib/blockClassName.ts",
    "lib/blockColors.ts",
    "lib/blockInputHandler.test.ts",
    "lib/blockInputHandler.ts",
    "lib/blockKeyHandler.ts",
    "lib/blockPaste.ts",
    "lib/blockSpecs.ts",
    "lib/codeLanguages.ts",
    "lib/collectHeadings.ts",
    "lib/defaultBlockRenderers.tsx",
    "lib/focusBlock.ts",
    "lib/inline-decorator/caret.ts",
    "lib/inline-decorator/decorate.ts",
    "lib/inlineDecorator.ts",
    "lib/inlineMd.ts",
    "lib/markdownTriggers.ts",
    "lib/selectionFormat.ts",
    "property-type-meta.ts",
    "slice.contract.ts",
    "slice.json",
    "types.ts",
    "view-config-types.ts"
  ],
  "imports": {
    "shared": [
      "@/lib/shared/features/defineFeature",
      "@/shared/error"
    ],
    "external": [
      "@/components/ui/button",
      "@/components/ui/input",
      "@/components/ui/popover",
      "@/lib/utils",
      "@dnd-kit/utilities",
      "highlight.js",
      "katex",
      "lucide-react",
      "react",
      "vitest"
    ]
  }
}
