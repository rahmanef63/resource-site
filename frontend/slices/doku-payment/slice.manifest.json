{
  "$schema": "../../../docs/slice.manifest.schema.json",
  "name": "doku-payment",
  "version": "0.3.0",
  "description": "DOKU Indonesia payment \u2014 hosted Checkout + Direct (VA/QRIS/eWallet/PayLater/Minimarket/CC). HMAC-signed REST + signature-verified webhook + idempotent retry. Sibling provider to midtrans-payment.",
  "category": "commerce",
  "stability": "beta",
  "deps": {
    "shared": [],
    "slices": [
      "convex-auth"
    ],
    "convexFeatures": [
      "payment"
    ],
    "npm": {},
    "env": [
      {
        "name": "DOKU_CLIENT_ID",
        "required": true,
        "scope": "server",
        "description": "Merchant Client-Id from DOKU dashboard."
      },
      {
        "name": "DOKU_SECRET_KEY",
        "required": true,
        "scope": "server",
        "description": "HMAC secret for outbound signing + inbound webhook verification."
      },
      {
        "name": "DOKU_IS_PRODUCTION",
        "required": false,
        "scope": "server",
        "description": "true|false; defaults false (sandbox)."
      },
      {
        "name": "DOKU_NOTIFY_PATH",
        "required": false,
        "scope": "server",
        "description": "Path component DOKU calls; defaults /webhooks/doku."
      }
    ]
  },
  "files": {
    "include": [
      "**/*"
    ],
    "exclude": [
      "*.test.ts",
      "*.test.tsx",
      "*.spec.ts"
    ]
  },
  "convexFiles": {
    "include": [
      "**/*.ts"
    ],
    "exclude": [
      "*.test.ts"
    ]
  },
  "permissions": [
    "payment.create-order",
    "payment.view-order",
    "payment.cancel-order",
    "payment.refund",
    "payment.webhook-process"
  ],
  "schemaTables": [
    {
      "name": "doku_payment_orders",
      "namespaced": true,
      "indexes": [
        "by_workspace",
        "by_workspace_user",
        "by_workspace_orderId",
        "by_workspace_status_createdAt"
      ]
    },
    {
      "name": "doku_payment_webhook_events",
      "namespaced": true,
      "indexes": [
        "by_workspace_received",
        "by_workspace_request"
      ]
    }
  ],
  "compatibility": {
    "next": ">=15 <17",
    "react": "^19",
    "convex": "^1.36",
    "tailwind": "4",
    "auth": "convex-auth"
  },
  "tags": [
    "payment",
    "commerce",
    "doku",
    "indonesia",
    "qris",
    "virtual-account",
    "ewallet",
    "checkout",
    "webhook"
  ],
  "notes": "Webhook handler at convex/features/payment/http.ts; verify HMAC via DOKU_SECRET_KEY before insert. Namespace collision with midtrans-payment RESOLVED 2026-05-14 via convex/migrations/M-doku-namespace-2026-05.ts (rename paymentOrders \u2192 doku_orders, paymentWebhookEvents \u2192 doku_webhook_events). Both contracts now use disjoint Convex prefixes (doku_ / midtrans_) so the compose-solver accepts them together."
}
