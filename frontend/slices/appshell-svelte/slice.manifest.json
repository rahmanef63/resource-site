{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "appshell-svelte",
  "version": "1.7.1",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add appshell --framework sveltekit",
    "consumerPath": "slices/appshell-svelte"
  },
  "files": [
    "AppShell.svelte",
    "README.md",
    "components/AppHost.svelte",
    "components/AppIcon.svelte",
    "components/AppLauncher.svelte",
    "components/CommandPalette.svelte",
    "components/InspectorPanel.svelte",
    "components/Notifications.svelte",
    "components/Slot.svelte",
    "components/SystemSheets.svelte",
    "components/WindowFrame.svelte",
    "index.ts",
    "lib/bootstrap.ts",
    "lib/context.ts",
    "primitives/AppFrame.svelte",
    "primitives/MasterDetail.svelte",
    "primitives/QuicklinkIcon.svelte",
    "primitives/ResponsiveToolbar.svelte",
    "primitives/TouchList.svelte",
    "shells/MacShell.svelte",
    "shells/MobileShell.svelte",
    "shells/WindowsShell.svelte",
    "svelte-components.d.ts",
    "types.ts"
  ],
  "imports": {
    "shared": [
      "frontend/slices/appshell/appshell.css",
      "frontend/slices/appshell/appshell-focus.css",
      "frontend/slices/appshell/appshell-materials.css",
      "frontend/slices/appshell/appshell-spinner.css",
      "frontend/slices/appshell/appshell-wallpapers.css",
      "frontend/slices/appshell/lib/types-core.ts",
      "frontend/slices/appshell/lib/window-exit-core.ts",
      "frontend/slices/appshell/lib/store-state.ts",
      "frontend/slices/appshell/lib/store-geometry.ts",
      "frontend/slices/appshell/lib/store-panels.ts",
      "frontend/slices/appshell/lib/store-persist.ts",
      "frontend/slices/appshell/lib/store.ts",
      "frontend/slices/appshell/lib/window-title.ts",
      "frontend/slices/appshell/lib/commands-core.ts",
      "frontend/slices/appshell/lib/badges-core.ts",
      "frontend/slices/appshell/lib/toast-core.ts",
      "frontend/slices/appshell/lib/activity-core.ts",
      "frontend/slices/appshell/lib/clipboard-core.ts",
      "frontend/slices/appshell/lib/share-core.ts",
      "frontend/slices/appshell/lib/quick-look-core.ts",
      "frontend/slices/appshell/lib/lock-core.ts",
      "frontend/slices/appshell/lib/shortcuts-core.ts",
      "frontend/slices/appshell/lib/focus-mode-core.ts",
      "frontend/slices/appshell/lib/inspector-core.ts",
      "frontend/slices/appshell/lib/recents-core.ts",
      "frontend/slices/appshell/lib/spaces-core.ts",
      "frontend/slices/appshell/lib/window-tabs-core.ts",
      "frontend/slices/appshell/lib/layouts-core.ts",
      "frontend/slices/appshell/lib/profiles-core.ts",
      "frontend/slices/appshell/lib/tools.ts",
      "frontend/slices/appshell/registry/shell-core.ts",
      "frontend/slices/appshell/registry/chrome-kit.ts",
      "frontend/slices/appshell/registry/chrome-kit-data.ts",
      "lib/shared/agentic/define.ts",
      "lib/shared/agentic/schema.ts",
      "lib/shared/agentic/types.ts"
    ],
    "external": [
      "svelte"
    ]
  }
}
