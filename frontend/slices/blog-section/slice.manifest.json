{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "blog-section",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add blog-section",
    "consumerPath": "slices/blog-section"
  },
  "files": [
    "README.md",
    "components/BlogCard.tsx",
    "components/PostMeta.tsx",
    "config.ts",
    "index.ts",
    "views/BlogListSection.tsx",
    "views/BlogPostView.tsx"
  ],
  "imports": {
    "shared": [],
    "external": [
      "next/image",
      "next/link",
      "@/components/ui/badge",
      "@/components/ui/button",
      "@/components/ui/card",
      "@/components/ui/separator",
      "@/lib/utils"
    ]
  }
}
