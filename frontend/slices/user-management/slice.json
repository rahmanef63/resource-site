{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "user-management",
  "version": "0.8.0",
  "category": "auth",
  "title": "User Management",
  "description": "Framework-parity user administration for members, hierarchy-aware invites, custom roles, teams, and the cross-tenant access matrix. React/Next remains the default shadcn renderer; native Svelte 5/SvelteKit reuses the same framework-neutral types, RBAC checks, members query/sort core, agent tools, and Convex backend. Authorization stays server-side in the bundled permission-gated Convex functions.",
  "namespace": "@/features/user-management",
  "convex": {
    "tablesExport": "userManagementTables",
    "schemaPath": "convex/features/user_management/_schema.ts",
    "rootPaths": [
      "convex/features/user_management"
    ]
  },
  "frontend": {
    "slicePath": "frontend/slices/user-management",
    "configExport": "userManagementFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/user-management-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/user-management/types.ts",
            "frontend/slices/user-management/access-types.ts",
            "frontend/slices/user-management/lib/can.ts",
            "frontend/slices/user-management/lib/members-core.ts",
            "frontend/slices/user-management/lib/tools.ts",
            "lib/shared/agentic/define.ts",
            "lib/shared/agentic/schema.ts",
            "lib/shared/agentic/types.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "avatar",
      "badge",
      "button",
      "checkbox",
      "dialog",
      "dropdown-menu",
      "input",
      "label",
      "select",
      "switch",
      "table",
      "tabs",
      "textarea"
    ],
    "env": [],
    "peers": [
      {
        "slug": "rbac-roles",
        "range": "^0.2",
        "reason": "Roles + resolved permissions + the convex permission helpers (requirePermission, getActorPermissions)."
      },
      {
        "slug": "convex-auth",
        "range": "^0.1",
        "reason": "Member identity (name/email/avatar) joined from the users table."
      }
    ],
    "sharedFiles": [
      "lib/shared/agentic/define.ts",
      "lib/shared/agentic/schema.ts",
      "lib/shared/agentic/types.ts"
    ]
  },
  "registers": [],
  "audit": [
    "bp:public-fn-validator"
  ],
  "license": "MIT",
  "tags": [
    "user-management",
    "members",
    "rbac",
    "auth",
    "team",
    "admin",
    "convex",
    "no-clerk",
    "svelte",
    "framework-parity"
  ],
  "previews": [
    {
      "component": "UserManagementPanel",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "members",
          "title": "Members tab",
          "description": "table + role dropdowns + invite"
        },
        {
          "id": "roles",
          "title": "Roles tab",
          "description": "role list + permission editor"
        },
        {
          "id": "teams",
          "title": "Teams tab",
          "description": "named user groups"
        },
        {
          "id": "access",
          "title": "Access matrix",
          "description": "per-tenant grant grid"
        }
      ],
      "seed": "4 demo members + 4 roles + 2 teams in rr-demo:user-management; role/grant edits persist"
    }
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "next",
          "range": "^15"
        },
        {
          "npm": "react",
          "range": "^18"
        }
      ]
    },
    "provides": {
      "tools": [
        "user-management.list",
        "user-management.invite",
        "user-management.set_role",
        "user-management.disable",
        "user-management.remove"
      ],
      "components": [
        "UserManagementPanel",
        "MembersPanel",
        "MembersTable",
        "MembersToolbar",
        "MemberRowActions",
        "RoleChip",
        "InviteDialog",
        "PendingInvites",
        "RolesPanel",
        "RoleEditor",
        "RolePermissionGrid",
        "TeamsPanel",
        "TeamDetail",
        "AccessMatrix"
      ],
      "hooks": [
        "useMembersView"
      ],
      "utils": [
        "can",
        "matchPermission",
        "deriveMembersView",
        "nextSort"
      ],
      "convex": {
        "tables": [
          "um_members",
          "um_invites",
          "um_teams",
          "um_team_members",
          "um_tenant_links"
        ],
        "rbac": [
          "members.view",
          "members.manage",
          "members.invite",
          "roles.view",
          "roles.manage"
        ]
      }
    }
  }
}
