{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "notion-sidebar",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add notion-sidebar",
    "consumerPath": "slices/notion-sidebar"
  },
  "files": [
    "components/NotionSidebar.tsx",
    "components/SidebarRow.tsx",
    "index.ts",
    "lib/tree.ts",
    "slice.contract.ts",
    "slice.json",
    "types.ts"
  ],
  "imports": {
    "shared": [],
    "external": [
      "@/components/ui/button",
      "@/components/ui/input",
      "@/lib/utils",
      "@dnd-kit/sortable",
      "@dnd-kit/utilities",
      "lucide-react",
      "react"
    ]
  }
}
