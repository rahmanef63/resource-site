{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "testimonials",
  "version": "0.2.0",
  "category": "content",
  "kind": "backend",
  "title": "Testimonials",
  "description": "Backend-only testimonials data contract with bounded public list/get, admin CRUD, and internal seed over Convex. Runtime/config source is framework-neutral TypeScript: React/Next remains the default distribution contract while explicit Svelte/SvelteKit installs reuse the same source with no duplicate UI or framework runtime dependency.",
  "namespace": "@/features/testimonials",
  "frontend": {
    "slicePath": "frontend/slices/testimonials",
    "configExport": "testimonialsFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/testimonials",
        "aliases": [
          "svelte",
          "sveltekit"
        ]
      }
    }
  },
  "convex": {
    "tablesExport": "testimonialsTables",
    "schemaPath": "convex/features/testimonials/_schema.ts",
    "rootPaths": [
      "convex/features/testimonials"
    ]
  },
  "deps": {
    "npm": [
      "convex@^1.16.0"
    ],
    "shadcn": [],
    "env": [
      {
        "name": "SUPER_ADMIN_EMAIL",
        "scope": "convex",
        "required": false
      }
    ],
    "peers": [
      {
        "slug": "convex-auth",
        "range": "^0.1",
        "reason": "requireAdmin calls getAuthUserId from @convex-dev/auth."
      }
    ]
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "content",
    "testimonials",
    "convex",
    "backend",
    "marketing"
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "convex",
          "range": "^1.16.0"
        }
      ]
    },
    "provides": {
      "components": [],
      "utils": [],
      "hooks": [],
      "convex": {
        "tables": [
          "testimonials"
        ],
        "rbac": [
          "admin"
        ]
      }
    }
  }
}
