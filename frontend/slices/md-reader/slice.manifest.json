    "index.ts",
    "slice.json",
    "slice.contract.ts",
    "components/MarkdownReader.tsx",
    "components/MdNodeView.tsx",
    "lib/parse.ts",
    "lib/parse.test.ts",
    "lib/inline.tsx"
  ],
  "imports": {
    "shared": [],
    "external": [
      "react",
      "katex",
      "lucide-react",
      "@/lib/utils"
    ]
  }
}
