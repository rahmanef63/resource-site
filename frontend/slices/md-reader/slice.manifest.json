{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "md-reader",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add md-reader",
    "consumerPath": "slices/md-reader"
  },
  "files": [
