{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "profile",
  "version": "1.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add profile",
    "consumerPath": "slices/profile"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "config.ts",
    "index.ts",
    "lib/core.ts",
    "slice.json",
    "variants/card/CHANGELOG.md",
    "variants/card/README.md",
    "variants/card/app.tsx",
    "variants/card/components/faq-list.tsx",
    "variants/card/config.ts",
    "variants/card/index.ts",
    "variants/card/lib/host.ts",
    "variants/resume/CHANGELOG.md",
    "variants/resume/README.md",
    "variants/resume/app.tsx",
    "variants/resume/components/section.tsx",
    "variants/resume/config.ts",
    "variants/resume/index.ts",
    "variants/resume/lib/host.ts"
  ],
  "imports": {
    "shared": [
      "@/components/ui/avatar",
      "@/components/ui/button",
      "@/components/ui/scroll-area",
      "@/lib/utils"
    ],
    "external": [
      "lucide-react",
      "react"
    ]
  }
}
