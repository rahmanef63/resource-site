{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "broadcast-channel-sync",
  "version": "0.2.0",
  "category": "data",
  "title": "BroadcastChannel \u2014 Cross-tab Sync",
  "description": "Cross-tab + cross-iframe state sync via BroadcastChannel + localStorage fallback. Tiny, no backend.",
  "namespace": "@/features/broadcast-channel-sync",
  "frontend": {
    "slicePath": "frontend/slices/broadcast-channel-sync",
    "configExport": "broadcastChannelSyncConfig"
  },
  "deps": {
    "npm": [],
    "shadcn": [],
    "env": [],
    "peers": []
  },
  "registers": [
    "registry"
  ],
  "audit": [],
  "license": "MIT",
  "tags": [
    "realtime",
    "cross-tab",
    "broadcast-channel"
  ],
  "contract": {
    "requires": {
      "auth": "none"
    },
    "provides": {
      "tools": [
        "broadcast-channel-sync.read",
        "broadcast-channel-sync.publish"
      ],
      "hooks": [
        "useBroadcastSync"
      ]
    },
    "generalization": {
      "level": "portable"
    }
  }
