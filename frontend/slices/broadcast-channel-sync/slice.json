{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "broadcast-channel-sync",
  "version": "0.3.0",
  "category": "data",
  "title": "BroadcastChannel \u2014 Cross-tab Sync",
  "description": "Cross-tab + cross-iframe state sync with one transport contract: BroadcastChannel when available and same-origin localStorage/storage-event fallback otherwise. React/Next remains the default hook distribution; an additive Svelte/SvelteKit distribution exposes a Svelte-readable store plus the same bounded agent tool surface.",
  "namespace": "@/features/broadcast-channel-sync",
  "frontend": {
    "slicePath": "frontend/slices/broadcast-channel-sync",
    "configExport": "broadcastChannelSyncConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/broadcast-channel-sync-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [],
          "shadcn": []
        }
      }
    }
  },
  "deps": {
    "npm": [],
    "shadcn": [],
    "env": [],
    "peers": []
  },
  "registers": [
    "registry"
  ],
  "audit": [],
  "license": "MIT",
  "tags": [
    "realtime",
    "cross-tab",
    "broadcast-channel"
  ],
  "contract": {
    "requires": {
      "auth": "none"
    },
    "provides": {
      "tools": [
        "broadcast-channel-sync.read",
        "broadcast-channel-sync.publish"
      ],
      "hooks": [
        "useBroadcastSync"
      ],
      "utils": [
        "createBroadcastSyncStore"
      ]
    },
    "generalization": {
      "level": "portable"
    }
  },
  "kind": "ui"
}
