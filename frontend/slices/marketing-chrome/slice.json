{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "marketing-chrome",
  "version": "0.3.0",
  "category": "ui",
  "kind": "ui",
  "title": "Marketing Chrome — Header + Footer",
  "description": "Config-driven marketing header + footer with React/Next default and native Svelte 5/SvelteKit adapter. Both reuse one framework-neutral nav/CTA/footer/social/layout core plus the same configure tool; framework-specific logo render nodes remain adapter-local.",
  "namespace": "@/features/marketing-chrome",
  "frontend": {
    "slicePath": "frontend/slices/marketing-chrome",
    "configExport": "marketingChromeFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/marketing-chrome-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/marketing-chrome/lib/core.ts",
            "frontend/slices/marketing-chrome/lib/tools.ts"
          ]
        }
      }
    }
  },
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button",
      "sheet",
      "separator"
    ],
    "env": [],
    "peers": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "ui",
    "header",
    "footer",
    "navbar",
    "marketing"
  ],
  "previews": [
    {
      "component": "MarketingHeader",
      "kind": "variants",
      "axes": [
        {
          "prop": "layout",
          "values": [
            "split",
            "centered",
            "minimal"
          ],
          "default": "split",
          "description": "split = brand/nav/cta; centered = stacked brand over nav; minimal = brand + cta only"
        }
      ],
      "seed": "static brand + 4 nav links + primary/secondary CTA"
    },
    {
      "component": "MarketingFooter",
      "kind": "variants",
      "axes": [
        {
          "prop": "layout",
          "values": [
            "columns",
            "slim"
          ],
          "default": "columns",
          "description": "columns = multi-column link grid + legal bar; slim = single brand/links/social row"
        }
      ],
      "seed": "static brand + 3 link columns + social + legal"
    }
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "tools": [
        "marketing-chrome.configure"
      ],
      "components": [
        "MarketingHeader",
        "MarketingFooter"
      ],
      "utils": [
        "externalLinkAttrs",
        "headerShowsInlineNav",
        "orderedCtas",
        "SOCIAL_TEXT"
      ],
      "hooks": [],
      "convex": {
        "tables": [],
        "rbac": []
      }
    }
  }
}
