{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "media-viewer",
  "version": "1.3.0",
  "category": "os",
  "kind": "ui",
  "title": "Preview \u2014 media quick-look",
  "description": "Framework-parity quick-look media viewer. React/Next remains the default renderer, while explicit Svelte/SvelteKit installs native Svelte 5 image/video/audio/PDF/text surfaces over the same samples, editor mapping, remote payload parser, host opener/source seams, and agentic tool collection. Images zoom 40\u2013300%; timed media expose playback/scrubbers; remote files use host-injected URLs; editor handoffs stay injectable. Svelte installs no React, Next, Lucide React, or shadcn runtime.",
  "namespace": "@/features/media-viewer",
  "frontend": {
    "slicePath": "frontend/slices/media-viewer",
    "configExport": "mediaViewerConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/media-viewer-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/media-viewer/lib/host-core.ts",
            "frontend/slices/media-viewer/lib/media.ts",
            "frontend/slices/media-viewer/lib/remote.ts",
            "frontend/slices/media-viewer/lib/samples.ts",
            "frontend/slices/media-viewer/lib/tools.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react"
    ],
    "shadcn": [
      "button",
      "badge",
      "separator",
      "tooltip",
      "slider"
    ],
    "env": [],
    "peers": [],
    "sharedFiles": [
      "lib/shared/agentic/types.ts",
      "lib/shared/agentic/prompt.ts",
      "lib/shared/agentic/registry.ts",
      "lib/shared/agentic/global-host.ts",
      "lib/shared/agentic/use-agent-tools.ts"
    ]
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:ui-consistency"
  ],
  "license": "MIT",
  "tags": [
    "media",
    "preview",
    "viewer",
    "ui",
    "svelte",
    "framework-parity"
  ],
  "previews": [
    {
      "component": "MediaViewer",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "sample-gallery",
          "title": "Sample gallery",
          "description": "Offline carousel: images, simulated video/audio transport, pdf, text"
        },
        {
          "id": "remote-image",
          "title": "Remote payload",
          "description": "payload={path,name,kind} through the identity media source (data-URI, offline)"
        }
      ],
      "seed": "fully offline \u2014 bundled SVG samples + data-URI remote payload"
    }
  ],
  "contract": {
    "requires": {
      "auth": "none",
      "deps": [
        {
          "npm": "react",
          "range": "^19"
        },
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "tools": [
        "media-viewer.info",
        "media-viewer.next",
        "media-viewer.prev",
        "media-viewer.zoom.set"
      ],
      "routes": [],
      "components": [
        "MediaViewer"
      ],
      "hooks": [],
      "utils": [
        "configureMediaOpener",
        "configureMediaSource",
        "mediaViewerApp"
      ],
      "tables": []
    }
  }
}
