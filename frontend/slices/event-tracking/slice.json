{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "event-tracking",
  "version": "0.2.0",
  "category": "data",
  "kind": "backend",
  "title": "Analytics",
  "description": "Framework-neutral analytics instrumentation contract. Host code injects an EventTrackingCtx transport for emit/query/funnel operations; no renderer or framework runtime is required. React/Next remains the default install contract and explicit Svelte/SvelteKit reuses the same TypeScript source.",
