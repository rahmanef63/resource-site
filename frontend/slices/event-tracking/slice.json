  "frontend": {
    "slicePath": "frontend/slices/event-tracking",
    "configExport": "eventTrackingFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/event-tracking",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [],
          "shadcn": []
        }
      }
    }
  },
  "deps": {
    "npm": [],
    "shadcn": [],
    "env": [],
    "peers": []
  },
  "registers": [],
  "audit": [],
