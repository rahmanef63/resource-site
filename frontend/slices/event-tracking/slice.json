  "tags": [
    "events",
    "analytics",
    "instrumentation",
    "attribution",
    "utm",
    "p0"
  ],
  "contract": {
    "requires": {
      "deps": []
    },
    "provides": {
      "tools": [
        "event-tracking.track",
        "event-tracking.query",
        "event-tracking.funnel"
      ],
      "components": [],
      "utils": [],
      "hooks": [],
      "convex": {
        "tables": [],
        "rbac": []
