{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "command-menu",
  "version": "0.4.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add command-menu",
    "consumerPath": "slices/command-menu"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "components/CommandPalette.tsx",
    "components/SearchModal.tsx",
    "components/palette/CommandGroups.tsx",
    "config.ts",
    "index.ts",
    "lib/cmdkHistory.ts",
    "lib/core.ts",
    "lib/types.ts",
    "slice.json"
  ],
  "imports": {
    "shared": [
      "@/components/ui/button",
      "@/components/ui/command",
      "@/components/ui/dialog"
    ],
    "external": [
      "cmdk",
      "lucide-react",
      "react"
    ]
  }
}
