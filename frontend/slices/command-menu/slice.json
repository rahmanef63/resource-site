{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "command-menu",
  "version": "0.4.0",
  "category": "ui",
  "kind": "ui",
  "title": "Command Menu",
  "description": "Portable command palette + generic search modal. React/Next remains the default cmdk/shadcn UI while Svelte 5/SvelteKit adds native palette/search surfaces over the same framework-neutral group, hotkey, MRU history, filtering, selection, label, and search-state core.",
  "namespace": "@/features/command-menu",
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "frontend": {
    "slicePath": "frontend/slices/command-menu",
    "configExport": "commandMenuConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/command-menu-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/command-menu/lib/core.ts",
            "frontend/slices/command-menu/lib/cmdkHistory.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "cmdk@^1.0.0",
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button",
      "command",
      "dialog"
    ],
    "env": [],
    "peers": []
  },
  "registers": [
    "registry"
  ],
  "license": "MIT",
  "tags": [
    "ui",
    "palette",
    "cmd-k",
    "navigation",
    "keyboard",
    "search"
  ],
  "providers": [],
  "previews": [
    {
      "component": "CommandPalette",
      "kind": "variants",
      "axes": [
        {
          "prop": "scope",
          "values": [
            "all",
            "commands"
          ],
          "default": "all",
          "description": "Which mock command groups the palette renders — full set (pages + commands) vs commands only."
        }
      ],
      "seed": "Palette rendered inline (open, no ⌘K) over 4-5 mock command items; type to fuzzy-filter. onSelect handlers are no-ops."
    }
  ],
  "contract": {
    "provides": {
      "components": [
        "CommandPalette",
        "SearchModal",
        "CommandGroupList"
      ],
      "utils": [
        "filterCommandGroups",
        "visibleCommandGroups",
        "isCommandMenuHotkey",
        "runCommandSelection",
        "searchView",
        "loadHistory",
        "saveHistory",
        "clearHistory"
      ]
    },
    "generalization": {
      "level": "portable",
      "forbiddenTerms": [
        "nosion",
        "Nosion"
      ],
      "requiredProps": [
        "groups",
        "onNavigate",
        "labels"
      ]
    }
  }
}
