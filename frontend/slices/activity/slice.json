{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "activity",
  "version": "0.4.0",
  "category": "data",
  "kind": "full",
  "title": "Activity — public productivity log",
  "description": "Public weekly activity log with one portable ISO-week/copy/format/stats/tool core and canonical Convex backend. React/Next remains the default UI; Svelte 5/SvelteKit adds a native feed/item/stats distribution over the same core and backend, preserving locale/copy/category overrides, public visibility filtering, stats semantics, metadata, and safe external links.",
  "namespace": "@/features/activity",
  "frontend": {
    "slicePath": "frontend/slices/activity",
    "configExport": "activityFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/activity-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5",
            "convex@^1.17"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/activity/config.ts",
            "frontend/slices/activity/lib/types.ts",
            "frontend/slices/activity/lib/format.ts",
            "frontend/slices/activity/lib/grouping.ts",
            "frontend/slices/activity/lib/defaults.ts",
            "frontend/slices/activity/lib/stats.ts",
            "frontend/slices/activity/lib/tools.ts"
          ]
        }
      }
    }
  },
  "convex": {
    "tablesExport": "activityTables",
    "schemaPath": "convex/features/activity/_schema.ts",
    "rootPaths": [
      "convex/features/activity"
    ]
  },
  "deps": {
    "npm": [
      "convex@^1.17",
      "lucide-react@^0.400.0",
      "next@^15",
      "react@^18"
    ],
    "shadcn": [],
    "env": [],
    "peers": []
  },
  "registers": [],
  "audit": [
    "bp:public-fn-validator"
  ],
  "license": "MIT",
  "tags": [
    "activity",
    "productivity",
    "log",
    "now-page",
    "feed",
    "mcp",
    "seo",
    "personal-brand"
  ],
  "previews": [
    {
      "component": "ActivityFeed",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "with-stats",
          "title": "Feed + stats",
          "description": "Stats panel over week-grouped entries"
        },
        {
          "id": "feed-only",
          "title": "Feed only",
          "description": "Week-grouped entries, no stats panel"
        },
        {
          "id": "empty",
          "title": "Empty state",
          "description": "No rows — empty-title/body fallback renders"
        }
      ],
      "seed": "4 static ActivityRow entries across two ISO weeks (display-only); scenario toggles stats + emptiness"
    }
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "convex",
          "range": "^1.17"
        },
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        },
        {
          "npm": "next",
          "range": "^15"
        },
        {
          "npm": "react",
          "range": "^18"
        }
      ]
    },
    "provides": {
      "tools": [
        "activity.list",
        "activity.stats"
      ],
      "components": [
        "ActivityFeed",
        "StatsPanel",
        "ActivityItem"
      ],
      "utils": [
        "groupByWeek",
        "isoWeek",
        "fmtDate",
        "fmtTime",
        "DEFAULT_COPY",
        "activityStatItems"
      ],
      "hooks": [],
      "convex": {
        "tables": [
          "activities"
        ],
        "rbac": []
      }
    }
  }
}
