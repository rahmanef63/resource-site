{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "system-monitor",
  "version": "1.3.0",
  "category": "os",
  "kind": "ui",
  "title": "System Monitor — host telemetry dashboard",
  "description": "Activity-Monitor-style host telemetry dashboard with React/Next kept as the default distribution and native Svelte 5/SvelteKit gauges, sparklines, and responsive process UI over one injected telemetry adapter + rolling history core. Polling stays at 1.5s with ~40 CPU/network points; zero-backend mock and host live adapter remain supported.",
  "namespace": "@/features/system-monitor",
  "frontend": {
    "slicePath": "frontend/slices/system-monitor",
    "configExport": "systemMonitorConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/system-monitor-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/system-monitor/lib/core.ts",
            "frontend/slices/system-monitor/lib/format.ts",
            "frontend/slices/system-monitor/lib/palette.ts",
            "frontend/slices/system-monitor/lib/tools.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "scroll-area"
    ],
    "env": [],
    "peers": []
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:ui-consistency"
  ],
  "license": "MIT",
  "tags": [
    "monitoring",
    "telemetry",
    "dashboard",
    "gauges",
    "sparkline",
    "processes",
    "ui"
  ],
  "previews": [
    {
      "component": "SystemMonitor",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "wide",
          "title": "Wide pane",
          "description": "Full dashboard with grid process table"
        },
        {
          "id": "compact",
          "title": "Compact pane",
          "description": "≤440px container reflow with stacked sparkline panels and touch process cards"
        }
      ],
      "seed": "Bundled wavy mock telemetry; no backend required"
    }
  ],
  "contract": {
    "requires": {
      "auth": "none",
      "deps": [
        {
          "npm": "react",
          "range": "^19"
        },
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "tools": [
        "system-monitor.stats",
        "system-monitor.processes"
      ],
      "routes": [],
      "components": [
        "SystemMonitor"
      ],
      "hooks": [],
      "utils": [
        "configureSysmon",
        "getSysmonApi",
        "createStatsHistoryStore",
        "createMockSys",
        "systemMonitorApp"
      ],
      "tables": []
    }
  }
}
