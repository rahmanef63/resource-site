{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "notion-ui",
  "version": "0.25.0",
  "category": "ui",
  "kind": "ui",
  "title": "Notion UI \u2014 page editor \u00b7 database \u00b7 sidebar primitives",
  "description": "Framework-parity, props-driven Notion primitives over one shared domain model. React/Next remains default; native Svelte 5/SvelteKit now provides page, database and sidebar variants. Page keeps block CRUD, slash/markdown transforms and native drag reorder; database renders all 11 view kinds over the same filter/sort/formula/aggregate/CSV/JSON engines; sidebar reuses the same tree projection helpers with native drag/reparent. Host owns all data and authorization.",
  "namespace": "@/features/notion-ui",
  "variants": {
    "default": "page",
    "shared": "shared",
    "items": [
      {
        "id": "page",
        "title": "Page",
        "description": "Page + block editor primitives (NotionPage / NotionBlock, SlashMenu, renderers).",
        "deps": {
          "sharedFiles": [
            "frontend/slices/notion-ui/shared/block-core.ts",
            "frontend/slices/notion-ui/shared/types.ts",
            "frontend/slices/notion-ui/shared/calc-types.ts",
            "frontend/slices/notion-ui/shared/view-config-types.ts",
            "frontend/slices/notion-ui/variants/page/lib/block-catalog.ts",
            "frontend/slices/notion-ui/variants/page/lib/markdownTriggers.ts",
            "frontend/slices/notion-ui/variants/page/lib/blockInputHandler.ts",
            "frontend/slices/notion-ui/variants/page/lib/tools.ts",
            "lib/shared/agentic/define.ts",
            "lib/shared/agentic/schema.ts",
            "lib/shared/agentic/types.ts"
          ]
        }
      },
      {
        "id": "database",
        "title": "Database",
        "description": "11-view database (NotionDatabase, filter/sort/group, formula, CSV/JSON I/O).",
        "deps": {
          "sharedFiles": [
            "frontend/slices/notion-ui/shared/block-core.ts",
            "frontend/slices/notion-ui/shared/types.ts",
            "frontend/slices/notion-ui/shared/calc-types.ts",
            "frontend/slices/notion-ui/shared/view-config-types.ts",
            "frontend/slices/notion-ui/shared/property-type-meta.ts",
            "frontend/slices/notion-ui/variants/database/types.ts",
            "frontend/slices/notion-ui/variants/database/lib/viewData.ts",
            "frontend/slices/notion-ui/variants/database/lib/viewData-filters.ts",
            "frontend/slices/notion-ui/variants/database/lib/calcAggregate.ts",
            "frontend/slices/notion-ui/variants/database/lib/format.ts",
            "frontend/slices/notion-ui/variants/database/lib/io/csv.ts",
            "frontend/slices/notion-ui/variants/database/lib/io/serialize.ts",
            "frontend/slices/notion-ui/variants/database/lib/formulaEngine/index.ts",
            "frontend/slices/notion-ui/variants/database/lib/formulaEngine/types.ts",
            "frontend/slices/notion-ui/variants/database/lib/formulaEngine/parser.ts",
            "frontend/slices/notion-ui/variants/database/lib/formulaEngine/ParserClass.ts",
            "frontend/slices/notion-ui/variants/database/lib/formulaEngine/evaluator.ts",
            "frontend/slices/notion-ui/variants/database/lib/formulaEngine/functions.ts",
            "frontend/slices/notion-ui/variants/database/lib/formulaEngine/coerce.ts",
            "frontend/slices/notion-ui/variants/database/lib/formulaEngine/dateUtils.ts",
            "frontend/slices/notion-ui/variants/database/lib/formulaEngine/deps.ts",
            "frontend/slices/notion-ui/variants/database/lib/tools.ts",
            "lib/shared/agentic/define.ts",
            "lib/shared/agentic/schema.ts",
            "lib/shared/agentic/types.ts"
          ]
        }
      },
      {
        "id": "sidebar",
        "title": "Sidebar",
        "description": "Tree-nav sidebar (NotionSidebar, dnd reorder + reparent, inline rename).",
        "deps": {
          "sharedFiles": [
            "frontend/slices/notion-ui/variants/sidebar/lib/types-core.ts",
            "frontend/slices/notion-ui/variants/sidebar/lib/tree.ts"
          ]
        }
      }
    ]
  },
  "frontend": {
    "slicePath": "frontend/slices/notion-ui",
    "configExport": "",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/notion-ui-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": []
        }
      }
    }
  },
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "deps": {
    "npm": [
      "@dnd-kit/core@^6.3.1",
      "@dnd-kit/sortable@^10.0.0",
      "@dnd-kit/utilities@^3.2.2",
      "katex@^0.16.47",
      "highlight.js@^11.11.1",
      "recharts@^3.8.0",
      "lucide-react@^1.16.0"
    ],
    "shadcn": [
      "button",
      "checkbox",
      "dialog",
      "dropdown-menu",
      "input",
      "popover",
      "select",
      "separator",
      "sheet",
      "switch",
      "toggle-group",
      "tooltip"
    ],
    "env": [],
    "peers": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "notion",
    "notion-like",
    "editor",
    "block-editor",
    "database",
    "views",
    "sidebar",
    "tree",
    "primitive",
    "portable",
    "ui",
    "svelte",
    "framework-parity"
  ],
  "previews": [],
  "contract": {
    "provides": {
      "tools": [
        "notion-shell.configure",
        "notion-database.rows",
        "notion-database.row.add",
        "notion-database.row.update",
        "notion-database.row.delete",
        "notion-database.view.switch",
        "notion-database.filter",
        "notion-database.sort"
      ],
      "components": [
        "NotionPage",
        "NotionBlock",
        "SlashMenu",
        "NotionDatabase",
        "NotionProperty",
        "NotionSidebar"
      ],
      "utils": [
        "focusBlock",
        "VIEW_REGISTRY",
        "PROPERTY_TYPE_META"
      ],
      "hooks": [],
      "convex": {
        "tables": [],
        "rbac": []
      }
    }
  }
}
