{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "ai-workspace",
  "version": "0.4.0",
  "category": "ai",
  "kind": "full",
  "title": "AI Workspace \u2014 chat \u00b7 studio \u00b7 agents",
  "description": "Framework-parity AI workspace with three exact variants. React/Next remains default; native Svelte 5/SvelteKit mirrors chat, studio, and agents over shared framework-neutral chat, generation, runner, and tool cores. Variant installs are dependency-scoped: chat alone pulls convex/features/aiChat plus the Vercel AI + Anthropic packages/key; studio and agents remain frontend-only and install no provider SDK or model env.",
  "namespace": "@/features/ai-workspace",
  "variants": {
    "default": "chat",
    "items": [
      {
        "id": "chat",
        "title": "Chat",
        "description": "Floating assistant FAB with real function-calling over any ToolHost.",
        "convex": [
          "convex/features/aiChat"
        ],
        "deps": {
          "npm": [
            "ai@^4.0.0",
            "@ai-sdk/anthropic@^0.0.50"
          ],
          "env": [
            {
              "name": "ANTHROPIC_API_KEY",
              "scope": "convex",
              "required": false,
              "description": "chat variant \u2014 enables the bundled aiChat action; when unset it returns a configuration notice."
            }
          ],
          "sharedFiles": [
            "frontend/slices/ai-workspace/variants/chat/core.ts",
            "frontend/slices/ai-workspace/variants/chat/agentic-send.ts",
            "lib/shared/agentic/agent-loop.ts",
            "lib/shared/agentic/host.ts",
            "lib/shared/agentic/types.ts"
          ]
        }
      },
      {
        "id": "studio",
        "title": "Studio",
        "description": "Single-prompt generation canvas + agentic generate tool.",
        "convex": [],
        "deps": {
          "sharedFiles": [
            "frontend/slices/ai-workspace/variants/studio/types.ts",
            "frontend/slices/ai-workspace/variants/studio/stub.ts",
            "frontend/slices/ai-workspace/variants/studio/tools.ts",
            "lib/shared/agentic/define.ts",
            "lib/shared/agentic/schema.ts",
            "lib/shared/agentic/types.ts"
          ]
        }
      },
      {
        "id": "agents",
        "title": "Agents",
        "description": "Autonomous-worker run dashboard + createAgentRunner loop.",
        "convex": [],
        "deps": {
          "sharedFiles": [
            "frontend/slices/ai-workspace/variants/agents/types.ts",
            "frontend/slices/ai-workspace/variants/agents/runner.ts",
            "frontend/slices/ai-workspace/variants/agents/views/demo.ts",
            "lib/shared/agentic/agent-loop.ts",
            "lib/shared/agentic/host.ts",
            "lib/shared/agentic/types.ts"
          ]
        }
      }
    ]
  },
  "frontend": {
    "slicePath": "frontend/slices/ai-workspace",
    "configExport": "aiWorkspaceFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/ai-workspace-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": []
        }
      }
    }
  },
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": [
      "convex/features/aiChat"
    ]
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "avatar",
      "badge",
      "button",
      "card",
      "progress",
      "scroll-area",
      "select",
      "separator",
      "slider",
      "switch",
      "table",
      "tabs",
      "textarea",
      "tooltip"
    ],
    "env": [],
    "peers": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "ai",
    "ai:chatbot",
    "ai:studio",
    "ai:agent",
    "agent-mode",
    "tool-calls",
    "streaming",
    "generation",
    "async",
    "traces",
    "multimodal",
    "svelte",
    "framework-parity",
    "variant-gated"
  ],
  "previews": [],
  "contract": {
    "provides": {
      "tools": [
        "ai-studio.generate"
      ],
      "components": [
        "AiChatFab",
        "AiStudioPage",
        "AiAgentsPage"
      ],
      "utils": [
        "createAgenticChatSend",
        "createAgentRunner"
      ],
      "hooks": [],
      "convex": {
        "tables": [],
        "rbac": []
      }
    }
  }
}
