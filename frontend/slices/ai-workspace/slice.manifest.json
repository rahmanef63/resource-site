  "slug": "ai-workspace",
  "version": "0.3.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add ai-workspace",
    "consumerPath": "slices/ai-workspace"
  },
  "files": [
