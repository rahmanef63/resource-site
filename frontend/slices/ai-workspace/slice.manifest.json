{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "ai-workspace",
  "version": "0.4.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add ai-workspace",
    "consumerPath": "slices/ai-workspace"
  },
  "files": [
    "README.md",
    "config.ts",
    "index.ts",
    "lib/classnames.ts",
    "variants/chat/agentic-send.ts",
    "variants/chat/core.ts",
    "variants/chat/components/AiChatFab.tsx",
    "variants/chat/index.ts",
    "variants/studio/index.ts",
    "variants/studio/stub.ts",
    "variants/studio/tools.ts",
    "variants/studio/types.ts",
    "variants/studio/views/AiStudioPage.tsx",
    "variants/studio/views/VersionTree.tsx",
    "variants/agents/index.ts",
    "variants/agents/runner.ts",
    "variants/agents/types.ts",
    "variants/agents/views/AiAgentsPage.tsx",
    "variants/agents/views/AgentTabs.tsx",
    "variants/agents/views/RunTrace.tsx",
    "variants/agents/views/demo.ts",
    "variants/agents/views/parts.tsx"
  ],
  "imports": {
    "shared": [
      "lib/shared/agentic/agent-loop.ts",
      "lib/shared/agentic/host.ts",
      "lib/shared/agentic/types.ts",
      "lib/shared/agentic/define.ts",
      "lib/shared/agentic/schema.ts"
    ],
    "external": [
      "lucide-react"
    ]
  }
}
