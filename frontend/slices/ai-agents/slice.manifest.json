{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "ai-agents",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add ai-agents",
    "consumerPath": "slices/ai-agents"
  },
  "files": [
    "README.md",
    "index.ts",
    "types.ts"
  ],
  "convex": {
    "schemaPath": "convex/features/ai-agents/_schema.ts",
    "rootPaths": [
      "convex/features/ai-agents"
    ]
  },
  "imports": {
    "shared": [
      "@/components/ui/button",
      "@/components/ui/card",
      "@/components/ui/badge",
      "@/components/ui/table",
      "@/components/ui/tabs",
      "@/components/ui/scroll-area",
      "@/components/ui/progress",
      "@/lib/utils"
    ],
    "external": [
      "react",
      "lucide-react",
      "ai"
    ]
  }
}
