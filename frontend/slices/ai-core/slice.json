{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "ai-core",
  "version": "0.2.0",
  "category": "ui",
  "kind": "ui",
  "title": "AI Core Kit",
  "description": "Shared AI dashboard UI/helper substrate with one framework-neutral formatter, error-presentation, and theme core. React/Next remains the default adapter; Svelte 5/SvelteKit adds native dialog, confirm, error-boundary, error-line, theme, and confirm-store adapters without React/Lucide/shadcn leakage.",
  "namespace": "@/features/ai-core",
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "frontend": {
    "slicePath": "frontend/slices/ai-core",
    "configExport": "aiCoreConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/ai-core-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/ai-core/lib/format.ts",
            "frontend/slices/ai-core/lib/error-core.ts",
            "frontend/slices/ai-core/lib/theme.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react"
    ],
    "shadcn": [],
    "env": [],
    "peers": []
  },
  "registers": [
    "registry"
  ],
  "license": "MIT",
  "tags": [
    "ui",
    "dialog",
    "theme",
    "error-state",
    "no-shadcn",
    "ai"
  ],
  "contract": {
    "requires": {
      "auth": "none",
      "deps": []
    },
    "provides": {
      "components": [
        "ResponsiveDialog",
        "ConfirmDialog",
        "SectionErrorBoundary",
        "ErrorLine"
      ],
      "hooks": [
        "useConfirm",
        "useTheme"
      ],
      "utils": [
        "fmt",
        "ago",
        "dt",
        "errData",
        "presentError",
        "parseTheme",
        "nextTheme",
        "readTheme",
        "applyTheme"
      ]
    },
    "generalization": {
      "level": "generic",
      "forbiddenTerms": [],
      "requiredProps": []
    }
  },
  "previews": [
    {
      "component": "AiCorePreview",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "confirm",
          "title": "Confirm dialog",
          "description": "Native dialog confirm flow with close/confirm behavior"
        },
        {
          "id": "error",
          "title": "Error presentation",
          "description": "Provider-friendly headline with admin detail/copy payload"
        },
        {
          "id": "format",
          "title": "Formatters",
          "description": "Compact number plus relative and absolute time helpers"
        }
      ],
      "seed": "static confirm/error/formatter examples over canonical ai-core behavior"
    }
  ]
}
