{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "site-setup-wizard",
  "version": "0.3.0",
  "category": "ui",
  "kind": "ui",
  "title": "Site Setup Wizard — first-run site setup",
  "description": "Post-claim onboarding wizard for clone-to-own templates. React/Next remains the default UI; Svelte 5/SvelteKit adds a native Identitas / Branding / Konten / Selesai flow over the same framework-neutral step, field, preset, validation, save-payload and agent-tool semantics. Host callbacks still own save/seed/upload/theme-preview behavior; no backend is invented.",
  "namespace": "@/features/site-setup-wizard",
  "registers": [],
  "audit": [],
  "frontend": {
    "slicePath": "frontend/slices/site-setup-wizard",
    "configExport": "",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/site-setup-wizard-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/site-setup-wizard/lib/core.ts",
            "frontend/slices/site-setup-wizard/lib/tools.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button",
      "card",
      "input",
      "label",
      "progress",
      "select"
    ],
    "env": [],
    "peers": []
  },
  "previews": [
    {
      "component": "OnboardingWizard",
      "kind": "variants",
      "axes": [
        {
          "prop": "presetPicker",
          "values": [
            "on",
            "off"
          ],
          "default": "on",
          "description": "Branding step with vs without the theme preset Select (host may omit presetOptions)."
        }
      ],
      "seed": "Mock save/seed callbacks; step through Identitas → Branding (color chips, mode buttons, swatch Select) → Konten → Selesai."
    }
  ],
  "contract": {
    "provides": {
      "tools": [
        "site-setup-wizard.status",
        "site-setup-wizard.goto_step",
        "site-setup-wizard.set_field",
        "site-setup-wizard.complete"
      ],
      "components": [
        "OnboardingWizard",
        "StepIdentity",
        "StepBranding",
        "StepContent",
        "StepDone",
        "ThemePresetField",
        "Field"
      ],
      "utils": [
        "normalizePresetOptions"
      ],
      "hooks": [],
      "types": [
        "OnboardingFields",
        "ImageFieldComponent",
        "PresetOption"
      ]
    }
  }
}
