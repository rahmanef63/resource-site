{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "site-setup-wizard",
  "version": "0.3.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add site-setup-wizard",
    "consumerPath": "slices/site-setup-wizard"
  },
  "files": [
    "HOST-SETUP.md",
    "README.md",
    "components/OnboardingWizard.tsx",
    "components/step-branding.tsx",
    "components/steps.tsx",
    "components/theme-preset-field.tsx",
    "index.ts",
    "lib/core.ts",
    "lib/tools.ts",
    "lib/types.ts",
    "slice.json"
  ],
  "imports": {
    "shared": [],
    "external": [
      "@/components/ui/button",
      "@/components/ui/card",
      "@/components/ui/input",
      "@/components/ui/label",
      "@/components/ui/progress",
      "@/components/ui/select",
      "lucide-react",
      "next/image",
      "react"
    ]
  }
}
