    "registry"
  ],
  "audit": [
    "bp:ui-consistency"
  ],
  "license": "MIT",
  "tags": [
    "image",
    "raster",
    "layers",
    "konva",
    "editor",
    "ai",
    "ui",
    "svelte",
    "framework-parity"
  ],
  "previews": [
    {
      "component": "ImageEditor",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "square",
          "title": "Square canvas",
          "description": "640×360 blank document — full editor chrome (tool rail, layers, adjust)."
        },
        {
          "id": "wide",
          "title": "Wide canvas",
          "description": "960×360 blank document for a banner-style layout."
        }
      ],
