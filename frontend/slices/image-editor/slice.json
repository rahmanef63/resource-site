{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "image-editor",
  "version": "2.1.1",
  "category": "os",
  "kind": "ui",
  "title": "Image Editor \u2014 layered raster editor",
  "description": "Embeddable, layer-based raster image editor (Konva): layers with blend modes + layer styles (shadow/glow/stroke), transforms, crop/resize/aspect presets, paint brushes, adjustments, text layers with fonts, free in-browser background removal (@imgly), PNG/JPEG/WebP export, an AI function-calling command registry (every operation is a schema'd command) with in-editor chat, and a headless server barrel (server.ts) to run commands against documents without a DOM. The AI bridge is injectable via configureAgentStream \u2014 without wiring, everything except the AI chat works.",
  "namespace": "@/features/image-editor",
  "frontend": {
    "slicePath": "frontend/slices/image-editor",
    "configExport": "imageEditorConfig"
  },
  "deps": {
    "npm": [
      "lucide-react",
      "konva",
      "react-konva",
      "@imgly/background-removal",
      "class-variance-authority",
      "radix-ui"
    ],
    "shadcn": [
      "button",
      "input",
      "label",
      "separator",
      "select",
      "scroll-area",
      "switch",
      "dropdown-menu",
      "tooltip",
      "resizable",
      "popover"
    ],
    "env": [],
    "peers": []
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:ui-consistency"
  ],
  "license": "MIT",
  "tags": [
    "image",
    "raster",
    "layers",
    "konva",
    "editor",
    "ai",
    "ui"
  ],
  "previews": [
    {
      "component": "ImageEditor",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "square",
          "title": "Square canvas",
          "description": "640\u00d7360 blank document \u2014 full editor chrome (tool rail, layers, adjust)."
        },
        {
          "id": "wide",
          "title": "Wide canvas",
          "description": "960\u00d7360 blank document for a banner-style layout."
        }
      ],
      "seed": "blank Konva doc sized per scenario; client-only stage, autosaves to localStorage, no server/fs"
    }
  ],
  "contract": {
    "requires": {
      "auth": "none",
      "deps": [
        {
          "npm": "react",
          "range": "^19"
        },
        {
          "npm": "konva",
          "range": "^10"
        },
        {
          "npm": "react-konva",
          "range": "^19"
        },
        {
          "npm": "@imgly/background-removal",
          "range": "^1.6.0"
        },
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        },
        {
          "npm": "class-variance-authority",
          "range": "^0.7"
        },
        {
          "npm": "radix-ui",
          "range": "^1"
        }
      ]
    },
    "provides": {
      "routes": [],
      "components": [
        "ImageEditor",
        "EditorProvider"
      ],
      "hooks": [
        "useEditor",
        "useEditorCommands"
      ],
      "utils": [
        "blankDoc",
        "createLayer",
        "removeImageBackground",
        "runEditorAgent",
        "configureAgentStream",
        "EDITOR_COMMANDS"
      ],
      "tables": [],
      "tools": [
        "image-editor.doc.inspect",
        "image-editor.doc.resize",
        "image-editor.doc.aspect",
        "image-editor.doc.crop",
        "image-editor.layer.add",
        "image-editor.layer.remove",
        "image-editor.layer.duplicate",
        "image-editor.layer.rename",
        "image-editor.layer.select",
        "image-editor.layer.order",
        "image-editor.layer.visibility",
        "image-editor.layer.lock",
        "image-editor.layer.opacity",
        "image-editor.transform.set",
        "image-editor.transform.flip",
        "image-editor.tool.select",
        "image-editor.brush.set",
        "image-editor.color.set",
        "image-editor.color.swap",
        "image-editor.adjust.set",
        "image-editor.adjust.addLayer",
        "image-editor.adjust.reset",
        "image-editor.style.stroke",
        "image-editor.style.shadow",
        "image-editor.style.glow",
        "image-editor.style.blend",
        "image-editor.text.edit",
        "image-editor.shape.edit",
        "image-editor.mask.add",
        "image-editor.mask.remove",
        "image-editor.edit.undo",
        "image-editor.edit.redo",
        "image-editor.export.image",
        "image-editor.image.removeBackground"
      ]
    }
  }
}
