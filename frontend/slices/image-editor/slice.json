{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "image-editor",
  "version": "2.2.0",
  "category": "os",
  "kind": "ui",
  "title": "Image Editor — layered raster editor",
  "description": "Framework-parity layered raster image editor. React/Next remains default with react-konva; native Svelte 5/SvelteKit uses Konva directly over the same document model, command registry, unified doc+paint history, project IO, filters/styles/masks, background-removal and export stage semantics. Svelte includes move/transform, brush/eraser/mask painting, eyedropper, zoom/pan, text/shape/paint/adjustment layers, properties/layers, autosave/open/save, image import/export, background removal, command tools and optional host-injected AI without React/Next/react-konva/Lucide/shadcn/FilePicker/shared agent runtime.",
  "namespace": "@/features/image-editor",
  "frontend": {
    "slicePath": "frontend/slices/image-editor",
    "configExport": "imageEditorConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/image-editor-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5",
            "konva@^10.3.0",
            "@imgly/background-removal@^1.7.0"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/image-editor/commands/adjust.commands.ts",
            "frontend/slices/image-editor/commands/document.commands.ts",
            "frontend/slices/image-editor/commands/export.commands.ts",
            "frontend/slices/image-editor/commands/invoke.ts",
            "frontend/slices/image-editor/commands/layer.commands.ts",
            "frontend/slices/image-editor/commands/registry.ts",
            "frontend/slices/image-editor/commands/schema.ts",
            "frontend/slices/image-editor/commands/style.commands.ts",
            "frontend/slices/image-editor/commands/tool.commands.ts",
            "frontend/slices/image-editor/commands/transform.commands.ts",
            "frontend/slices/image-editor/commands/types.ts",
            "frontend/slices/image-editor/lib/assistant-core.ts",
            "frontend/slices/image-editor/lib/bbox.ts",
            "frontend/slices/image-editor/lib/bg-removal.ts",
            "frontend/slices/image-editor/lib/editor-core.ts",
            "frontend/slices/image-editor/lib/export.ts",
            "frontend/slices/image-editor/lib/history-core.ts",
            "frontend/slices/image-editor/lib/konva-helpers.ts",
            "frontend/slices/image-editor/lib/konva-native.ts",
            "frontend/slices/image-editor/lib/mask-core.ts",
            "frontend/slices/image-editor/lib/model.ts",
            "frontend/slices/image-editor/lib/project-core.ts",
            "frontend/slices/image-editor/lib/types.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "@imgly/background-removal@^1.7.0",
      "konva@^10.3.0",
      "lucide-react@^1.16.0",
      "react-konva@^19.2.4"
