{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "create-your-mcp",
  "version": "0.4.1",
  "category": "ai",
  "kind": "full",
  "title": "Create Your MCP",
  "description": "Framework-parity MCP/OAuth integration: React/Next remains the default admin UI and route adapter, while explicit SvelteKit installs native Svelte 5 admin UI plus SvelteKit handler factories over the same OAuth 2.1 + PKCE, JSON-RPC, Convex token backend, scope enforcement, and static MCP_API_KEY fallback. HTTP behavior is framework-neutral Web Request/Response logic; the host-specific adapters are thin.",
  "namespace": "@/features/create-your-mcp",
  "frontend": {
    "slicePath": "frontend/slices/create-your-mcp",
    "configExport": "createYourMcpFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/create-your-mcp-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5",
            "convex@^1.16.0"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/create-your-mcp/server.ts",
            "frontend/slices/create-your-mcp/views/mcp-admin-helpers.ts",
            "frontend/slices/create-your-mcp/lib/auth.ts",
            "frontend/slices/create-your-mcp/lib/backend.ts",
            "frontend/slices/create-your-mcp/lib/context.ts",
            "frontend/slices/create-your-mcp/lib/hash.ts",
            "frontend/slices/create-your-mcp/lib/mcp-http.ts",
            "frontend/slices/create-your-mcp/lib/oauth-http.ts",
            "frontend/slices/create-your-mcp/lib/server.ts",
            "frontend/slices/create-your-mcp/lib/tools/example.ts",
            "frontend/slices/create-your-mcp/lib/types.ts"
          ]
        }
      }
    }
  },
  "convex": {
    "tablesExport": "createYourMcpTables",
    "schemaPath": "convex/features/create_your_mcp/_schema.ts",
    "rootPaths": [
      "convex/features/create_your_mcp"
    ]
  },
  "deps": {
    "npm": [
      "convex@^1.16.0",
      "class-variance-authority@^0.7.1"
    ],
    "shadcn": [
      "button"
    ],
    "env": [
      {
        "name": "MCP_API_KEY",
        "scope": "server",
        "required": false,
        "description": "Static bearer for service-account / CI access. Min 32 chars. Same value must be set on Convex (npx convex env set MCP_API_KEY …) and on the Next host so both validation paths agree."
      },
      {
        "name": "MCP_OAUTH_ALLOWED_HOSTS",
        "scope": "convex",
        "required": false,
        "description": "CSV of vendor domains allowed in redirect_uri (e.g. chatgpt.com,claude.ai,cursor.sh). Empty = no remote redirects (localhost only)."
      },
      {
        "name": "MCP_OAUTH_ALLOWED_PATH_PREFIXES",
        "scope": "convex",
        "required": false,
        "description": "CSV of path prefixes allowed under each allowed host (e.g. /aip/,/connector/,/oauth/). Empty = any path under allowed hosts accepted."
      },
      {
        "name": "NEXT_PUBLIC_SITE_URL",
        "scope": "next-public",
        "required": true,
        "description": "Public site origin for OAuth/MCP discovery and setup UI. Route handlers fall back to the request origin when omitted."
      }
    ],
    "peers": [
      {
        "slug": "convex-auth",
        "range": "^0.1",
        "reason": "requireAdmin calls getAuthUserId from @convex-dev/auth."
      }
    ]
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "ai",
    "mcp",
    "oauth",
    "pkce",
    "chatgpt",
    "claude",
    "cursor",
    "convex",
    "backend",
    "integration",
    "svelte",
    "framework-parity"
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "convex",
          "range": "^1.16.0"
        },
        {
          "npm": "react",
          "range": "^19"
        },
        {
          "npm": "class-variance-authority",
          "range": "^0.7.1"
        }
      ]
    },
    "provides": {
      "components": [
        "McpAdminView"
      ],
      "utils": [
        "dispatchJsonRpc",
        "checkAuth",
        "extractBearer",
        "runWithMcpContext",
        "getMcpContext",
        "createConvexMcpBackend",
        "handleMcpPost",
        "handleOauthTokenPost",
        "createSvelteKitMcpHandlers",
        "createSvelteKitOauthTokenHandlers"
      ],
      "hooks": [],
      "convex": {
        "tables": [
          "oauthCodes",
          "oauthAccessTokens"
        ],
        "rbac": [
          "admin"
        ]
      }
    }
  }
}
