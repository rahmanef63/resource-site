{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "rate-limit",
  "version": "0.4.0",
  "category": "infra",
  "kind": "backend",
  "title": "Rate Limit",
  "description": "Backend-only Convex per-key request counter with atomic consume, server-owned namespace policy, optional server-key gate, and cron pruning. Runtime/config/tool source is framework-neutral TypeScript: React/Next remains the default distribution contract while explicit Svelte/SvelteKit installs reuse the same source with no duplicate UI or framework runtime dependency.",
  "namespace": "@/features/rate-limit",
  "frontend": {
    "slicePath": "frontend/slices/rate-limit",
    "configExport": "rateLimitFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/rate-limit",
        "aliases": [
          "svelte",
          "sveltekit"
        ]
      }
    }
  },
  "convex": {
    "tablesExport": "rateLimitTables",
    "schemaPath": "convex/features/rate_limit/_schema.ts",
    "rootPaths": [
      "convex/features/rate_limit"
    ]
  },
  "deps": {
    "npm": [
      "convex@^1.16.0"
    ],
    "shadcn": [],
    "env": [
      {
        "name": "RATE_LIMIT_SERVER_KEY",
        "scope": "convex",
        "required": false,
        "description": "Optional shared secret for server-only consume calls; recommended for user-facing or security-sensitive rate-limit namespaces."
      }
    ],
    "peers": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "infra",
    "rate-limit",
    "convex",
    "backend",
    "throttle"
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "convex",
          "range": "^1.16.0"
        }
      ]
    },
    "provides": {
      "tools": [
        "rate-limit.check",
        "rate-limit.reset"
      ],
      "components": [],
      "utils": [],
      "hooks": [],
      "convex": {
        "tables": [
          "rateLimits"
        ],
        "rbac": []
      }
    }
  }
}
