{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "rate-limit",
  "version": "0.3.0",
  "category": "infra",
  "kind": "backend",
  "title": "Rate Limit",
  "description": "Convex-backed per-key request counter. Atomic check-and-increment via `consume` mutation; expired rows pruned by `_pruneExpired` internalMutation wired to a 5-min cron. Replaces single-replica in-memory Map so multi-replica Next deployments share buckets. Caller chooses key namespace (csp:<ip>, mcp:<ip>, oauth_token:<ip>).",
  "namespace": "@/features/rate-limit",
  "frontend": {
    "slicePath": "frontend/slices/rate-limit",
    "configExport": "rateLimitFeature"
  },
  "convex": {
    "tablesExport": "rateLimitTables",
    "schemaPath": "convex/features/rate-limit/_schema.ts",
    "rootPaths": [
      "convex/features/rate-limit"
    ]
  },
  "deps": {
    "npm": [
      "convex@^1.16.0"
    ],
    "shadcn": [],
    "env": [],
    "peers": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "infra",
    "rate-limit",
    "convex",
    "backend",
    "throttle"
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "convex",
          "range": "^1.16.0"
        }
      ]
    },
    "provides": {
      "tools": [
        "rate-limit.check",
        "rate-limit.reset"
      ],
      "components": [],
      "utils": [],
      "hooks": [],
      "convex": {
        "tables": [
          "rateLimits"
        ],
        "rbac": []
      }
    }
  }
}
