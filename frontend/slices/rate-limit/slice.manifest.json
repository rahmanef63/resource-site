{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "rate-limit",
  "version": "0.4.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add rate-limit",
    "consumerPath": "slices/rate-limit"
  },
  "files": [
    "README.md",
    "config.ts",
    "index.ts",
    "lib/tools.ts"
  ],
  "convexFiles": [
    "convex/features/rate_limit/_schema.ts",
    "convex/features/rate_limit/mutation.ts"
  ],
  "imports": {
    "shared": [
      "@/shared/agentic/define",
      "@/shared/agentic/schema"
    ],
    "external": [
      "convex/server",
      "convex/values"
    ]
  }
}
