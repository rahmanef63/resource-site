{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "vector-search",
  "version": "0.1.0",
  "category": "search",
  "title": "Convex Vector Search",
  "description": "Embeddings-based search via @convex-dev/vector-search. Embed on insert, query by vector similarity.",
  "namespace": "@/features/vector-search",
  "convex": {
    "tablesExport": "searchTables",
    "schemaPath": "convex/features/search/_schema.ts",
    "rootPaths": [
      "convex/features/search"
    ]
  },
  "frontend": {
    "slicePath": "frontend/slices/vector-search",
    "configExport": "vectorSearchConfig"
  },
  "deps": {
    "npm": [
      "@convex-dev/vector-search@^0.0.5"
    ],
    "shadcn": [
      "card",
      "input"
    ],
    "env": [
      {
        "name": "OPENAI_API_KEY",
        "scope": "convex",
        "required": true,
        "description": "For text-embedding-3-small."
      }
    ],
    "peers": []
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:public-fn-validator"
  ],
  "license": "MIT",
  "tags": [
    "search",
    "vector",
    "embeddings",
    "convex"
  ],
  "previews": []
}
