{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "storefront-checkout",
  "version": "0.3.0",
  "category": "content",
  "kind": "ui",
  "title": "Storefront Checkout — guest cart + checkout composition",
  "description": "Guest-friendly persisted cart with one framework-neutral cart store, native React and Svelte UI adapters, and display-only client totals that the host must re-price server-side at checkout. React/Next remains default; Svelte/SvelteKit reuses the same item, quantity, persistence, count/subtotal, IDR-format, and agent-tool semantics.",
  "namespace": "@/features/storefront-checkout",
  "registers": [],
  "audit": [],
  "frontend": {
    "slicePath": "frontend/slices/storefront-checkout",
    "configExport": "",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/storefront-checkout-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/storefront-checkout/lib/core.ts",
            "frontend/slices/storefront-checkout/lib/tools.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "badge",
      "button",
      "card",
      "separator",
      "sheet"
    ],
    "env": [],
    "peers": [
      {
        "slug": "payment",
        "range": "^0.4",
        "optional": true,
        "reason": "Payment step — checkout page composes DokuDirectForm + DokuPaymentInstructions (or swap payment)."
      }
    ]
  },
  "previews": [
    {
      "component": "CartWidget",
      "kind": "variants",
      "axes": [
        {
          "prop": "seeded",
          "values": [
            "empty",
            "filled"
          ],
          "default": "filled",
          "description": "Cart contents — empty state vs two seeded demo items."
        }
      ],
      "seed": "Wrapped in CartProvider (isolated storageKey). Click the cart trigger to open the sheet — qty steppers, remove, subtotal, checkout CTA."
    }
  ],
  "contract": {
    "provides": {
      "tools": [
        "storefront-checkout.cart",
        "storefront-checkout.add",
        "storefront-checkout.set_qty",
        "storefront-checkout.remove",
        "storefront-checkout.clear"
      ],
      "components": [
        "CartProvider",
        "CartWidget",
        "CheckoutSummary"
      ],
      "utils": [
        "formatIDR",
        "createCartStore"
      ],
      "hooks": [
        "useCart"
      ],
      "types": [
        "CartItem",
        "CartSnapshot",
        "CartStore"
      ]
    }
  }
}
