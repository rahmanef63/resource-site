{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "storefront-checkout",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add storefront-checkout",
    "consumerPath": "slices/storefront-checkout"
  },
  "files": [
    "HOST-SETUP.md",
    "README.md",
    "agent.md",
    "components/CartWidget.tsx",
    "components/CheckoutSummary.tsx",
    "index.ts",
    "lib/cart.tsx",
    "slice.contract.ts",
    "slice.json"
  ],
  "imports": {
    "shared": [],
    "external": [
      "@/components/ui/badge",
      "@/components/ui/button",
      "@/components/ui/card",
      "@/components/ui/separator",
      "@/components/ui/sheet",
      "lucide-react",
      "next/link",
      "react"
    ]
  }
}
