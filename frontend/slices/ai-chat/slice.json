{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "ai-chat",
  "version": "0.3.0",
  "category": "ai",
  "kind": "full",
  "title": "AI Chat \u2014 Workbench / Sidebar / Search",
  "description": "Claude.ai / ChatGPT-style chatbot. Three-column shell: threads + attachments + active tools on the left, streaming messages in the center, model picker + params + skills + actions on the right. Multi-provider, multimodal, typed tool calls, agent mode, branching threads, RAG citations, resumable streams.",
  "namespace": "@/features/ai-chat",
  "convex": {
    "tablesExport": "aiChatTables",
    "schemaPath": "convex/features/aiChat/_schema.ts",
    "rootPaths": [
      "convex/features/aiChat"
    ]
  },
  "frontend": {
    "slicePath": "frontend/slices/ai-chat",
    "configExport": ""
  },
  "deps": {
    "npm": [
      "ai@^4.0.0",
      "@ai-sdk/anthropic@^0.0.50",
      "@ai-sdk/openai@^0.0.60"
    ],
    "shadcn": [
      "button",
      "card",
      "badge",
      "avatar",
      "scroll-area",
      "select",
      "separator",
      "slider",
      "switch",
      "textarea",
      "tabs"
    ],
    "env": [
      {
        "name": "ANTHROPIC_API_KEY",
        "scope": "convex"
      },
      {
        "name": "OPENAI_API_KEY",
        "scope": "convex"
      },
      {
        "name": "GOOGLE_GENERATIVE_AI_API_KEY",
        "scope": "convex"
      }
    ],
    "peers": [
      {
        "slug": "convex-auth",
        "range": "^0.1"
      },
      {
        "slug": "ai-router",
        "range": "^0.1"
      },
      {
        "slug": "ai-admin",
        "range": "^0.1"
      },
      {
        "slug": "vector-search",
        "range": "^0.1"
      }
    ]
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "ai",
    "ai:chatbot",
    "streaming",
    "multimodal",
    "tool-calls",
    "agent-mode",
    "rag",
    "citations",
    "branching",
    "history"
  ],
  "previews": [
    {
      "component": "AiChatFab",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "with-mock-bot",
          "title": "Wired assistant",
          "description": "A `chat` prop is injected; sending a message returns a canned reply after a short delay."
        },
        {
          "id": "unconfigured",
          "title": "Not wired up",
          "description": "No `chat` prop \u2014 the FAB still opens and answers with a wire-me-up notice."
        }
      ],
      "seed": "mock chat resolves a canned reply ~500ms after send; FAB + panel anchored inside the preview card"
    }
  ],
  "contract": {
    "requires": {
      "auth": "convex",
      "rbac": [
        "chat.read",
        "chat.write"
      ],
      "env": [
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "GOOGLE_GENERATIVE_AI_API_KEY"
      ],
      "deps": [
        "convex-auth",
        "ai-router",
        "ai-admin",
        "vector-search"
      ]
    },
    "provides": {
      "utils": [
        "createAgenticChatSend"
      ],
      "components": [
        "ChatWorkbench",
        "ChatThreadSidebar",
        "ChatModelPicker",
        "ChatMessageList"
      ]
    },
    "generalization": {
      "level": "portable",
      "forbiddenTerms": [
        "rahmanef",
        "rahmanef.com"
      ],
      "requiredProps": []
    }
  }
}
