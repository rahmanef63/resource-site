    "hooks/use-loop-items.ts",
    "hooks/use-loop-pagination.ts",
    "index.ts",
    "lib/mock-source.ts",
    "lib/registry.ts",
    "lib/types.ts"
  ],
  "imports": {
    "shared": [],
    "external": [
      "@/components/ui/button"
    ]
  }
}
