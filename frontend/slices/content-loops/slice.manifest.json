{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "content-loops",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add content-loops",
    "consumerPath": "slices/content-loops"
  },
  "files": [
    "README.md",
    "components/ContentLoop.tsx",
