{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "settings",
  "version": "1.2.0",
  "category": "ui",
  "kind": "ui",
  "title": "Settings \u2014 account + appearance shells",
  "description": "Framework-parity adapter-driven settings shells behind one slug. React/Next remains default; explicit Svelte 5/SvelteKit installs native account and appearance renderers over the same framework-neutral SettingsAdapter, optimistic merge semantics, section catalog/nav core, settings-page tools, and AppearanceAdapter. Account keeps profile/preferences/notifications/danger-zone plus controlled/internal navigation; appearance keeps style/mode/accent/wallpaper/shell/display composition. Svelte depends only on svelte@^5 and installs no React, Next, Lucide React, shadcn, or agent runtime.",
  "namespace": "@/features/settings",
  "variants": {
    "default": "account",
    "items": [
      {
        "id": "account",
        "title": "Account",
        "description": "Profile/preferences/notifications/danger-zone shell over an async load+save adapter."
      },
      {
        "id": "appearance",
        "title": "Appearance",
        "description": "Style/mode/accent/wallpaper/display shell over a sync per-setting adapter + the shared Section/Row/Segmented primitives."
      }
    ]
  },
  "frontend": {
    "slicePath": "frontend/slices/settings",
    "configExport": "settingsFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/settings-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/settings/variants/account/lib/adapter.ts",
            "frontend/slices/settings/variants/account/lib/core.ts",
            "frontend/slices/settings/variants/account/lib/nav-core.ts",
            "frontend/slices/settings/variants/account/lib/tools.ts",
            "frontend/slices/settings/variants/appearance/lib/types.ts"
          ]
        }
      }
    }
  },
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "alert-dialog",
      "avatar",
      "button",
      "card",
      "input",
      "label",
      "select",
      "separator",
      "skeleton",
      "switch",
      "textarea",
      "toggle-group"
    ],
    "env": [],
    "peers": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "settings",
    "preferences",
    "account",
    "appearance",
    "theme",
    "adapter",
    "shell",
    "primitives",
    "ui",
    "svelte",
    "framework-parity"
  ],
  "previews": [],
  "contract": {
    "provides": {
      "tools": [
        "settings-page.get",
        "settings-page.set"
      ],
      "components": [
        "SettingsShell",
        "ProfileSection",
        "PreferencesSection",
        "NotificationsSection",
        "DangerZone",
        "AppearancePanel",
        "SettingsSection",
        "SettingsRow",
        "Segmented",
        "AccentSwatches"
      ],
      "utils": [
        "createMemoryAdapter"
      ],
      "hooks": [
        "useSettings"
      ],
      "convex": {
        "tables": [],
        "rbac": []
      }
    }
  }
}
