{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "appshell",
  "version": "1.0.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add appshell",
    "consumerPath": "slices/appshell"
  },
  "files": [
    "agent.md",
    "appshell.css",
    "components/app-icon.tsx",
    "components/app-launcher.tsx",
    "components/desktop.tsx",
    "components/dock.tsx",
    "components/layout/app-chrome.tsx",
    "components/menu-bar-status.tsx",
    "components/menu-bar.tsx",
    "components/mobile-app-library-parts.tsx",
    "components/mobile-app-library.tsx",
    "components/mobile-home.tsx",
    "components/mobile-shell.tsx",
    "components/mobile-switcher.tsx",
    "components/traffic-lights.tsx",
    "components/wallpaper.tsx",
    "components/window-content.tsx",
    "components/window.tsx",
    "config.ts",
    "features/control-center/components/control-center.tsx",
    "features/control-center/index.ts",
    "features/inspector/components/inspector-ai.tsx",
    "features/inspector/components/inspector.tsx",
    "features/inspector/index.ts",
    "features/notifications/components/dynamic-island.tsx",
    "features/notifications/components/toast-host.tsx",
    "features/notifications/index.ts",
    "features/search/components/spotlight.tsx",
    "features/search/index.ts",
    "features/widgets/components/mobile-widgets.tsx",
    "features/widgets/index.ts",
    "hooks/use-persist-layout.ts",
    "hooks/use-shell.ts",
    "hooks/use-window-drag.ts",
    "index.ts",
    "lib/activity.ts",
    "lib/inspector.ts",
    "lib/registry.tsx",
    "lib/store-geometry.ts",
    "lib/store-state.ts",
    "lib/store.ts",
    "lib/toast.ts",
    "lib/types.ts",
    "primitives/app-frame.tsx",
    "primitives/master-detail.tsx",
    "primitives/responsive-dialog-context.tsx",
    "primitives/responsive-dialog-parts.tsx",
    "primitives/responsive-dialog.tsx",
    "primitives/responsive-toolbar.tsx",
    "primitives/touch-list.tsx",
    "provider/app-shell.tsx",
    "registry/brand.tsx",
    "registry/capabilities.tsx",
    "registry/feature-registry.tsx",
    "registry/shell-config.tsx",
    "registry/shell-ui.tsx",
    "registry/types.ts",
    "responsive/responsive-provider.tsx",
    "responsive/use-container.ts",
    "responsive/use-is-mobile.ts",
    "responsive/use-responsive.ts",
    "runtime/use-url-sync.tsx"
  ],
  "imports": {
    "shared": [
      "@/components/ui/button",
      "@/components/ui/tooltip",
      "@/components/ui/scroll-area",
      "@/components/ui/sheet",
      "@/components/ui/drawer",
      "@/components/ui/dialog",
      "@/components/ui/alert-dialog",
      "@/components/ui/dropdown-menu",
      "@/lib/utils"
    ],
    "external": [
      "react",
      "lucide-react",
      "class-variance-authority",
      "clsx",
      "tailwind-merge",
      "vaul"
    ]
  }
}
