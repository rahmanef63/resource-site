{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "theme-presets",
  "version": "0.5.0",
  "category": "ui",
  "kind": "ui",
  "title": "Theme Presets — unified switcher with bundled tweakcn registry",
  "description": "Runtime tweakcn color presets with React/Next as the default distribution and native Svelte 5/SvelteKit provider/switcher/theme-color adapters over the same registry, CSS injection, persistence, default-resolution, grouping, swatch and agent-tool core. React display mode stays on next-themes; Svelte ships a native browser light/dark/system adapter.",
  "namespace": "@/features/theme-presets",
  "registers": [],
  "audit": [],
  "frontend": {
    "slicePath": "frontend/slices/theme-presets",
    "configExport": "",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/theme-presets-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/theme-presets/lib/core.ts",
            "frontend/slices/theme-presets/lib/tools.ts",
            "frontend/slices/theme-presets/lib/tweakcn.ts",
            "frontend/slices/theme-presets/lib/tweakcn/apply.ts",
            "frontend/slices/theme-presets/lib/tweakcn/cssBuilder.ts",
            "frontend/slices/theme-presets/lib/tweakcn/groups.ts",
            "frontend/slices/theme-presets/lib/tweakcn/registry-data.json",
            "frontend/slices/theme-presets/lib/tweakcn/registry.ts",
            "frontend/slices/theme-presets/lib/tweakcn/tokens.ts",
            "frontend/slices/theme-presets/lib/tweakcn/types.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "next-themes@^0.4.6",
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button",
      "popover"
    ],
    "env": [],
    "peers": []
  },
  "previews": [
    {
      "component": "ThemePresetSwitcher",
      "kind": "variants",
      "axes": [
        {
          "prop": "size",
          "values": [
            "sm",
            "mobile"
          ],
          "default": "sm",
          "description": "Trigger sizing — compact header button vs larger mobile touch target."
        }
      ],
      "seed": "Wrapped in next-themes ThemeProvider + ThemePresetProvider; click the Palette trigger to open the mode tabs + bundled tweakcn preset list."
    }
  ],
  "contract": {
    "provides": {
      "tools": [
        "theme-presets.list_presets",
        "theme-presets.current",
        "theme-presets.set_preset",
        "theme-presets.clear"
      ],
      "components": [
        "ThemePresetSwitcher",
        "ThemePresetProvider",
        "ThemeColorSync",
        "ThemeProviders",
        "SaveSiteDefaultButton"
      ],
      "utils": [
        "applyTweakcnPreset",
        "bootTweakcnPreset",
        "clearTweakcnPreset",
        "createThemePresetStore",
        "findTweakcnPreset",
        "getSavedTweakcnPreset",
        "groupTweakcnPresets",
        "loadTweakcnRegistry",
        "previewTweakcnPreset",
        "restoreTweakcnPreset",
        "tweakcnSwatches"
      ],
      "hooks": [
        "useThemePreset"
      ],
      "types": [
        "ThemePresetEngine",
        "ThemePresetSnapshot",
        "ThemePresetStore",
        "TweakcnPresetGroup",
        "TweakcnPresetItem",
        "TweakcnPresetMeta",
        "TweakcnRegistry"
      ]
    }
  }
}
