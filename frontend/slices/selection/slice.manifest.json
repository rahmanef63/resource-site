{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "selection",
  "version": "0.2.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add selection",
    "consumerPath": "slices/selection"
  },
  "files": [
    "components/SelectableBlock.tsx",
    "components/SelectionMarquee.tsx",
