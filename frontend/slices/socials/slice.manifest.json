{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "socials",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add socials",
    "consumerPath": "slices/socials"
  },
  "files": [
    "README.md",
    "config.ts",
    "index.ts"
  ],
  "convexFiles": [
    "convex/features/socials/_schema.ts",
    "convex/features/socials/query.ts",
    "convex/features/socials/mutation.ts"
  ],
  "imports": {
    "shared": [
      "convex/_shared/auth"
    ],
    "external": [
      "convex/server",
      "convex/values"
    ]
  }
}
