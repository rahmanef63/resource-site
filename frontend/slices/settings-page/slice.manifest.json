{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "settings-page",
  "version": "0.3.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add settings-page",
    "consumerPath": "slices/settings-page"
  },
  "files": [
    "README.md",
    "components/SettingsShell.tsx",
    "components/sections/DangerZone.tsx",
    "components/sections/NotificationsSection.tsx",
    "components/sections/PreferencesSection.tsx",
    "components/sections/ProfileSection.tsx",
    "config.ts",
    "hooks/useSettings.ts",
    "index.ts",
    "lib/adapter.ts",
    "lib/tools.ts"
  ],
  "imports": {
    "shared": [],
    "external": [
      "lucide-react",
      "@/components/ui/alert-dialog",
      "@/components/ui/avatar",
      "@/components/ui/button",
      "@/components/ui/card",
      "@/components/ui/input",
      "@/components/ui/label",
      "@/components/ui/select",
      "@/components/ui/separator",
      "@/components/ui/skeleton",
      "@/components/ui/switch",
      "@/components/ui/textarea",
      "@/lib/utils"
    ]
  }
}
