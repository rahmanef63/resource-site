{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "ai-search",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add ai-search",
    "consumerPath": "slices/ai-search"
  },
  "files": [
    "index.ts",
    "README.md",
    "types.ts",
    "components/AskBox.tsx",
    "components/AnswerView.tsx",
    "components/SourceStrip.tsx",
    "components/FollowUpChips.tsx",
    "hooks/useAsk.ts",
    "hooks/useCorpus.ts",
    "lib/citation-parser.ts"
  ],
  "convex": {
    "schemaPath": "convex/features/ai-search/schema.ts",
    "rootPaths": ["convex/features/ai-search"]
  },
  "imports": {
    "shared": [
      "@/components/ui/button",
      "@/components/ui/card",
      "@/components/ui/badge",
      "@/components/ui/input",
      "@/components/ui/tabs",
      "@/components/ui/scroll-area",
      "@/components/ui/separator",
      "@/lib/utils"
    ],
    "external": ["react", "lucide-react", "ai"]
  }
}
