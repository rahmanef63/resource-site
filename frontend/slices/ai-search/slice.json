{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "ai-search",
  "version": "0.1.0",
  "category": "ai",
  "kind": "full",
  "title": "AI Search — Ask with Citations",
  "description": "Perplexity-style answer engine over a workspace corpus. Streaming answer with inline numbered citations + source cards strip. Follow-up suggestions. Admin: corpus ingestion + crawl schedule + reranker tuning + per-source weight.",
  "namespace": "@/features/ai-search",
  "convex": {
    "tablesExport": "aiSearchTables",
    "schemaPath": "convex/features/ai-search/schema.ts",
    "rootPaths": ["convex/features/ai-search"]
  },
  "frontend": {
    "slicePath": "frontend/slices/ai-search",
    "configExport": ""
  },
  "deps": {
    "npm": ["ai@^4.0.0"],
    "shadcn": ["button", "card", "badge", "input", "tabs", "scroll-area", "separator"],
    "env": [],
    "peers": [
      { "slug": "convex-auth", "range": "^0.1" },
      { "slug": "ai-router", "range": "^0.1" },
      { "slug": "ai-admin", "range": "^0.1" },
      { "slug": "vector-search", "range": "^0.1" }
    ]
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": ["ai", "ai:search", "rag", "citations", "streaming", "corpus"]
}
