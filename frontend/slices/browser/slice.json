{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "browser",
  "version": "1.3.0",
  "category": "os",
  "kind": "ui",
  "title": "Browser \u2014 remote headless-browser chrome",
  "description": "Framework-parity remote-browser chrome over one injected BrowserAdapter. React/Next remains default with Lucide/shadcn chrome and automatic agent-tool registration; explicit Svelte 5/SvelteKit adds native multitab/omnibar/bookmark/history/AI-log/remote-frame/screenshot surfaces over the same observable browser session, demo renderer, screenshot-poll/MJPEG-screencast fallback, URL/storage helpers, and self-contained browserTools. Remote browser authentication and authorization remain host-owned.",
  "namespace": "@/features/browser",
  "frontend": {
    "slicePath": "frontend/slices/browser",
    "configExport": "browserConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/browser-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/browser/config.ts",
            "frontend/slices/browser/lib/demo-browser.ts",
            "frontend/slices/browser/lib/host-core.ts",
            "frontend/slices/browser/lib/screencast-core.ts",
            "frontend/slices/browser/lib/session-core.ts",
            "frontend/slices/browser/lib/storage-core.ts",
            "frontend/slices/browser/lib/tools.ts",
            "frontend/slices/browser/lib/url.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button",
      "input",
      "badge",
      "dropdown-menu",
      "tooltip",
      "scroll-area",
      "sheet"
    ],
    "env": [],
    "peers": [],
    "sharedFiles": [
      "lib/shared/agentic/types.ts",
      "lib/shared/agentic/define.ts",
      "lib/shared/agentic/schema.ts",
      "lib/shared/agentic/prompt.ts",
      "lib/shared/agentic/registry.ts",
      "lib/shared/agentic/global-host.ts",
      "lib/shared/agentic/use-agent-tools.ts"
    ]
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:ui-consistency"
  ],
  "license": "MIT",
  "tags": [
    "browser",
    "headless",
    "playwright",
    "remote",
    "omnibar",
    "tabs",
    "screencast",
    "bookmarks",
    "ui",
    "svelte",
    "framework-parity",
    "agent-tools"
  ],
  "previews": [],
  "contract": {
    "requires": {
      "auth": "none",
      "deps": []
    },
    "provides": {
      "tools": [
        "browser.read_state",
        "browser.open",
        "browser.new_tab",
        "browser.close_tab",
        "browser.back",
        "browser.forward",
        "browser.reload",
        "browser.scroll",
        "browser.click",
        "browser.type",
        "browser.key"
      ],
      "routes": [],
      "components": [
        "Browser"
      ],
      "hooks": [],
      "utils": [
        "configureBrowser",
        "configureBrowserMode",
        "configureScreencast",
        "browserApp",
        "createBrowserSession"
      ],
      "tables": []
    }
  }
}
