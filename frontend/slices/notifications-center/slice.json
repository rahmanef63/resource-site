{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "notifications-center",
  "version": "0.3.0",
  "category": "ui",
  "kind": "ui",
  "title": "Notifications Center — bell + inbox",
  "description": "Adapter-driven notification inbox with one framework-neutral snapshot/sort/filter/action core, native React and Svelte bell/list/item UI, and host-supplied feed adapters. React/Next remains default; Svelte/SvelteKit reuses the same notification, adapter, unread, relative-time, tool, and mutation semantics without shadcn/Lucide.",
  "namespace": "@/features/notifications-center",
  "frontend": {
    "slicePath": "frontend/slices/notifications-center",
    "configExport": "notificationsCenterFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/notifications-center-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/notifications-center/lib/types.ts",
            "frontend/slices/notifications-center/lib/adapter.ts",
            "frontend/slices/notifications-center/lib/relativeTime.ts",
            "frontend/slices/notifications-center/lib/state.ts",
            "frontend/slices/notifications-center/lib/tools.ts"
          ]
        }
      }
    }
  },
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "avatar",
      "badge",
      "button",
      "popover",
      "scroll-area",
      "separator",
      "sheet",
      "tabs"
    ],
    "env": [],
    "peers": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "ui",
    "notifications",
    "inbox",
    "bell",
    "adapter",
    "realtime"
  ],
  "previews": [
    {
      "component": "NotificationBell",
      "kind": "variants",
      "axes": [
        {
          "prop": "surface",
          "values": [
            "popover",
            "sheet"
          ],
          "default": "popover",
          "description": "Panel surface — floating popover (desktop) or side sheet (mobile)"
        }
      ],
      "seed": "8 static mixed-kind notifications with static ISO timestamps"
    },
    {
      "component": "NotificationList",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "mixed",
          "title": "Mixed feed",
          "description": "8 notifications, some unread, with actors + bodies"
        },
        {
          "id": "all-read",
          "title": "All read",
          "description": "Same feed, every row already read — unread tab empty"
        },
        {
          "id": "empty",
          "title": "Empty state",
          "description": "No notifications — caught-up fallback renders"
        }
      ],
      "seed": "Same 8 static notifications; scenario toggles read-state + emptiness"
    }
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "tools": [
        "notifications-center.list",
        "notifications-center.mark_read",
        "notifications-center.mark_all_read",
        "notifications-center.dismiss",
        "notifications-center.clear"
      ],
      "components": [
        "NotificationBell",
        "NotificationList",
        "NotificationItem"
      ],
      "utils": [
        "createMemoryNotificationsAdapter",
        "relativeTime",
        "createNotificationsState",
        "filterNotifications",
        "sortNotificationsNewestFirst"
      ],
      "hooks": [
        "useNotifications"
      ],
      "convex": {
        "tables": [],
        "rbac": []
      }
    }
  }
}
