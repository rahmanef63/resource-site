{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "notifications-center",
  "version": "0.2.0",
  "category": "ui",
  "kind": "ui",
  "title": "Notifications Center \u2014 bell + inbox",
  "description": "Standalone notification inbox \u2014 a bell trigger with an unread badge that opens a panel (popover on desktop, sheet on mobile) listing notifications with All/Unread tabs, per-row mark-read + dismiss, and bulk mark-all-read + clear. Adapter-driven: the host supplies the feed via a NotificationsAdapter (Convex, websocket, or the bundled in-memory store). Pure UI, no backend coupling, theme-token styling.",
  "namespace": "@/features/notifications-center",
  "frontend": {
    "slicePath": "frontend/slices/notifications-center",
    "configExport": "notificationsCenterFeature"
  },
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "avatar",
      "badge",
      "button",
      "popover",
      "scroll-area",
      "separator",
      "sheet",
      "tabs"
    ],
    "env": [],
    "peers": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "ui",
    "notifications",
    "inbox",
    "bell",
    "adapter",
    "realtime"
  ],
  "previews": [
    {
      "component": "NotificationBell",
      "kind": "variants",
      "axes": [
        {
          "prop": "surface",
          "values": [
            "popover",
            "sheet"
          ],
          "default": "popover",
          "description": "Panel surface \u2014 floating popover (desktop) or side sheet (mobile)"
        }
      ],
      "seed": "8 static mixed-kind notifications with static ISO timestamps"
    },
    {
      "component": "NotificationList",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "mixed",
          "title": "Mixed feed",
          "description": "8 notifications, some unread, with actors + bodies"
        },
        {
          "id": "all-read",
          "title": "All read",
          "description": "Same feed, every row already read \u2014 unread tab empty"
        },
        {
          "id": "empty",
          "title": "Empty state",
          "description": "No notifications \u2014 caught-up fallback renders"
        }
      ],
      "seed": "Same 8 static notifications; scenario toggles read-state + emptiness"
    }
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "tools": [
        "notifications-center.list",
        "notifications-center.mark_read",
        "notifications-center.mark_all_read",
        "notifications-center.dismiss",
        "notifications-center.clear"
      ],
      "components": [
        "NotificationBell",
        "NotificationList",
        "NotificationItem"
      ],
      "utils": [
        "createMemoryNotificationsAdapter",
        "relativeTime"
      ],
      "hooks": [
        "useNotifications"
      ],
      "convex": {
        "tables": [],
        "rbac": []
      }
    }
  }
}
