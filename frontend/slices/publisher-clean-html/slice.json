{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "publisher-clean-html",
  "version": "0.2.0",
  "category": "content",
  "kind": "ui",
  "title": "Publisher \u2014 clean HTML",
  "description": "Pure clean-HTML publisher with one canonical framework-neutral TypeScript core for rendering, schema-typed sanitization, CSS deduplication and CSP planning. React/Next remains the default preview distribution; an additive Svelte 5/SvelteKit preview reuses the exact same core through verified framework sharedFiles, so security logic is not forked.",
  "namespace": "@/features/publisher-clean-html",
  "frontend": {
    "slicePath": "frontend/slices/publisher-clean-html",
    "configExport": "publisherCleanHtmlFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/publisher-clean-html-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/publisher-clean-html/lib/class-injection.ts",
            "frontend/slices/publisher-clean-html/lib/csp-plan.ts",
            "frontend/slices/publisher-clean-html/lib/css-collector.ts",
            "frontend/slices/publisher-clean-html/lib/escape-props.ts",
            "frontend/slices/publisher-clean-html/lib/inline-style.ts",
            "frontend/slices/publisher-clean-html/lib/module-registry.ts",
            "frontend/slices/publisher-clean-html/lib/publish-page.ts",
            "frontend/slices/publisher-clean-html/lib/render-node.ts",
            "frontend/slices/publisher-clean-html/lib/reset-css.ts",
            "frontend/slices/publisher-clean-html/lib/sanitize/css-value.ts",
            "frontend/slices/publisher-clean-html/lib/sanitize/html.ts",
            "frontend/slices/publisher-clean-html/lib/sanitize/index.ts",
            "frontend/slices/publisher-clean-html/lib/sanitize/richtext.ts",
            "frontend/slices/publisher-clean-html/lib/sanitize/runtime.ts",
            "frontend/slices/publisher-clean-html/lib/sanitize/svg.ts",
            "frontend/slices/publisher-clean-html/lib/types.ts"
          ]
        }
      }
    }
  },
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "deps": {
    "npm": [],
    "shadcn": [],
    "env": [],
    "peers": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "content",
    "publisher",
    "html",
    "static-export",
    "sanitization",
    "csp",
    "css-dedup",
    "render"
  ],
  "previews": [
    {
      "component": "PublishPreview",
      "kind": "variants",
      "axes": [
        {
          "prop": "cssEmission",
          "values": [
            "inline",
            "external"
          ],
          "default": "inline",
          "description": "Embed CSS in a <style> block, or link an external bundle (re-inlined for this iframe preview)"
        }
      ],
      "seed": "4-node demo tree (body > section > heading + 3 paragraphs), one of which carries an inert <script> string to show schema-typed escaping"
    }
  ],
  "contract": {
    "requires": {
      "deps": []
    },
    "provides": {
      "components": [
        "PublishPreview"
      ],
      "utils": [
        "publishPage",
        "renderNode",
        "createModuleRegistry",
        "escapeProps",
        "CssCollector",
        "sanitizeModuleCSS",
        "escapeHtml",
        "safeUrl",
        "isSafeUrl",
        "sanitiseCssValue",
        "sanitizeRichtext",
        "sanitizeSvg",
        "configureRichtextSanitizer",
        "createBaseCspPlan",
        "serializeCsp",
        "PUBLISHER_RESET_CSS"
      ],
      "hooks": [],
      "convex": {
        "tables": [],
        "rbac": []
      }
    }
  }
}
