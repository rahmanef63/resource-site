{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "quicklinks",
  "version": "1.1.0",
  "category": "os",
  "kind": "ui",
  "title": "Quicklinks — website shortcuts with favicons",
  "description": "A grid of user-curated website shortcuts with one framework-neutral QuicklinksStore + URL/favicon core. The bundled default persists to localStorage with SSR-safe post-mount hydration, while configureQuicklinks() can inject a host store. React/Next remains the default UI; an additive Svelte 5/SvelteKit grid reuses the exact same core and preserves favicon + noopener new-tab behavior.",
  "namespace": "@/features/quicklinks",
  "frontend": {
    "slicePath": "frontend/slices/quicklinks",
    "configExport": "quicklinksConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/quicklinks-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/quicklinks/lib/core.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react"
    ],
    "shadcn": [
      "button"
    ],
    "env": [],
    "peers": []
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:ui-consistency"
  ],
  "license": "MIT",
  "tags": [
    "shortcuts",
    "links",
    "favicons",
    "launcher",
    "ui"
  ],
  "previews": [
    {
      "component": "QuicklinksApp",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "seeded-grid",
          "title": "Seeded grid",
          "description": "Demo links on an injected in-memory store — click opens the site in a new tab"
        },
        {
          "id": "empty",
          "title": "Empty state",
          "description": "No quicklinks yet — the add-via-store hint"
        }
      ],
      "seed": "in-memory stores only — the preview never touches localStorage; favicons load from the Google s2 host"
    }
  ],
  "contract": {
    "requires": {
      "auth": "none",
      "deps": [
        {
          "npm": "react",
          "range": "^19"
        },
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "routes": [],
      "components": [
        "QuicklinksApp"
      ],
      "hooks": [
        "useQuicklinks"
      ],
      "utils": [
        "configureQuicklinks",
        "createLocalStore",
        "createMemoryStore",
        "getQuicklinksStore",
        "faviconUrl",
        "openQuicklink",
        "quicklinksApp"
      ],
      "tables": []
    }
  }
}
