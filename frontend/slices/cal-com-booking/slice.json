{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "cal-com-booking",
  "version": "0.3.0",
  "category": "data",
  "kind": "full",
  "title": "Cal.com Booking",
  "description": "Cal.com inline booking UI with a real Convex webhook mirror. React/Next remains default via @calcom/embed-react; Svelte 5/SvelteKit uses the shared vanilla embed loader. The bundled backend verifies CALCOM_WEBHOOK_SECRET and upserts Cal events into the real bookings table; list/cancel/reschedule tools stay host-injected adapters.",
  "namespace": "@/features/cal-com-booking",
  "convex": {
    "tablesExport": "bookingsTables",
    "schemaPath": "convex/features/bookings/_schema.ts",
    "rootPaths": [
      "convex/features/bookings"
    ]
  },
  "frontend": {
    "slicePath": "frontend/slices/cal-com-booking",
    "configExport": "calComBookingConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/cal-com-booking-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/cal-com-booking/lib/embed-core.ts",
            "frontend/slices/cal-com-booking/lib/tools.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "@calcom/embed-react@^1.5.3"
    ],
    "shadcn": [],
    "env": [
      {
        "name": "CALCOM_WEBHOOK_SECRET",
        "scope": "convex",
        "required": true,
        "description": "Server-only HMAC secret used to verify Cal.com webhook deliveries."
      }
    ],
    "peers": []
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:public-fn-validator"
  ],
  "license": "MIT",
  "tags": [
    "data",
    "scheduling",
    "cal-com",
    "bookings",
    "webhook",
    "svelte"
  ],
  "previews": [],
  "contract": {
    "requires": {
      "auth": "none",
      "rbac": [],
      "env": [
        "CALCOM_WEBHOOK_SECRET"
      ],
      "deps": []
    },
    "provides": {
      "tools": [
        "cal-com-booking.list",
        "cal-com-booking.cancel",
        "cal-com-booking.reschedule"
      ],
      "routes": [
        "/book"
      ],
      "components": [
        "CalEmbed"
      ],
      "utils": [
        "mountCalInline",
        "normalizeCalLink",
        "normalizeCalOrigin"
      ],
      "convex": {
        "tables": [
          "bookings"
        ],
        "rbac": []
      }
    },
    "generalization": {
      "level": "needs-adapter",
      "requiredProps": [
        "calLink",
        "list",
        "cancel",
        "reschedule"
      ]
    }
  }
}
