{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "notion-app",
  "version": "1.2.0",
  "category": "content",
  "title": "Notion App — Block Editor",
  "description": "Framework-parity Notion-style block editor over one page/block model, markdown bridge, adapter CRUD contract and tool collection. React/Next remains default with dnd-kit, shadcn and rich optional host render adapters; native Svelte 5/SvelteKit provides title + block CRUD, slash/markdown transforms, lists/todos/headings/quote/callout/code/equation/media/table/toggle/layout blocks, drag/button reorder, undo/redo, Markdown import/export, child pages and optional tool/navigation wiring without React/Next/dnd-kit/Lucide/shadcn/Sonner runtime.",
  "namespace": "@/features/notion-app",
  "kind": "full",
  "frontend": {
    "slicePath": "frontend/slices/notion-app",
    "configExport": "notionAppConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/notion-app-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5",
            "katex@^0.16.47"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/notion-app/shared/types/index.ts",
            "frontend/slices/notion-app/shared/types/block.ts",
            "frontend/slices/notion-app/shared/types/blocks.ts",
            "frontend/slices/notion-app/shared/types/property.ts",
            "frontend/slices/notion-app/shared/types/database.ts",
            "frontend/slices/notion-app/shared/lib/uid.ts",
            "frontend/slices/notion-app/shared/lib/markdown/index.ts",
            "frontend/slices/notion-app/shared/lib/markdown/fromMarkdown.ts",
            "frontend/slices/notion-app/shared/lib/markdown/toMarkdown.ts",
            "frontend/slices/notion-app/slices/editor/lib/dataAdapter.ts",
            "frontend/slices/notion-app/slices/editor/lib/page-core.ts",
            "frontend/slices/notion-app/slices/editor/lib/block-catalog.ts",
            "frontend/slices/notion-app/slices/editor/lib/history-core.ts",
            "frontend/slices/notion-app/slices/editor/lib/markdownTriggers.ts",
            "frontend/slices/notion-app/slices/editor/lib/turnInto.ts",
            "frontend/slices/notion-app/lib/tools.ts",
            "lib/shared/agentic/define.ts",
            "lib/shared/agentic/schema.ts",
            "lib/shared/agentic/types.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "sonner@^2.0.7",
      "@dnd-kit/core@^6.3.1",
      "@dnd-kit/sortable@^10.0.0",
      "@dnd-kit/utilities@^3.2.2",
      "katex@^0.16.47",
      "lucide-react@^1.16.0"
    ],
    "shadcn": [
      "button",
      "dropdown-menu",
      "popover",
      "separator",
      "checkbox",
      "input",
      "switch",
      "skeleton"
    ],
    "env": [],
    "peers": [],
    "sharedFiles": [
      "components/shared/ui/FilePicker.tsx",
      "lib/shared/features/defineFeature.ts",
      "lib/shared/agentic/define.ts",
      "lib/shared/agentic/schema.ts",
      "lib/shared/agentic/types.ts"
    ]
  },
  "registers": [
    "registry"
  ],
  "license": "MIT",
  "tags": [
    "content",
    "notion",
    "editor",
    "block-editor",
    "rich-text",
    "svelte",
    "framework-parity"
  ],
  "previews": [
    {
      "component": "PageEditor",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "starter",
          "title": "Starter page",
          "description": "Notes page — slash menu, markdown triggers, todo, drag"
        },
        {
          "id": "rich",
          "title": "Rich blocks",
          "description": "Callout, numbered list, toggle, code, divider, inline KaTeX"
        }
      ],
      "seed": "two pages in rr-demo:notion via an in-memory EditorDataAdapter; all edits persist"
    }
  ],
  "contract": {
    "requires": {
      "deps": [
        "sonner",
        "@dnd-kit/core",
        "@dnd-kit/sortable",
        "@dnd-kit/utilities",
        "katex"
      ]
    },
    "provides": {
      "tools": [
        "notion.page.create",
        "notion.page.get",
        "notion.page.update",
        "notion.search"
      ],
      "utils": [
        "blockTree",
        "turnInto",
        "markdownTriggers",
        "inlineDecorator",
        "syncedBlocks",
        "layoutAdapter",
        "listOrdinals",
        "blockSpecs",
        "createPageEditorCore",
        "BLOCK_CATALOG",
        "searchBlocks"
      ],
      "hooks": [],
      "components": [
        "PageEditor"
      ]
    }
  }
}
