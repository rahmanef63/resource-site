{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "resources-launcher-admin",
  "version": "1.1.1",
  "category": "os",
  "kind": "ui",
  "title": "Resources Admin \u2014 curated icon-launcher CRUD",
  "description": "Owner-gated curated launcher CRUD with one framework-neutral ResourcesAdapter/core. React/Next remains the default Lucide + shadcn surface; Svelte 5/SvelteKit gets native add/edit/remove/reorder UI over the same mock/live adapter, resource model, icon-name catalog, normalization, sorting, and permission state. The backend stays injected via configureResources (list/upsert/remove/canManage), so zero-backend mock mode remains fully interactive.",
  "namespace": "@/features/resources-launcher-admin",
  "frontend": {
    "slicePath": "frontend/slices/resources-launcher-admin",
    "configExport": "resourcesLauncherAdminConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/resources-launcher-admin-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/resources-launcher-admin/lib/core.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button",
      "input",
      "label",
      "scroll-area",
      "native-select"
    ],
    "env": [],
    "peers": [],
    "sharedFiles": [
      "frontend/slices/resources-launcher-admin/lib/core.ts"
    ]
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:ui-consistency"
  ],
  "license": "MIT",
  "tags": [
    "launcher",
    "links",
    "bookmarks",
    "admin",
    "crud",
    "icons",
    "ui"
  ],
  "previews": [
    {
      "component": "ResourcesAdmin",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "mock-crud",
          "title": "Mock CRUD",
          "description": "Bundled mock adapter with add/edit/delete/reorder enabled"
        }
      ],
      "seed": "Three canonical mock resources from the shared resources core"
    }
  ],
  "contract": {
    "requires": {
      "auth": "none",
      "deps": [
        {
          "npm": "react",
          "range": "^19"
        },
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "tools": [],
      "routes": [],
      "components": [
        "ResourcesAdmin"
      ],
      "hooks": [],
      "utils": [
        "configureResources",
        "resourcesApi",
        "readResourcesState",
        "sortResources",
        "swapResourceOrder",
        "resolveIcon"
      ],
      "tables": []
    },
    "generalization": {
      "level": "portable",
      "forbiddenTerms": [
        "rahmanef"
      ],
      "requiredProps": []
    }
  }
}
