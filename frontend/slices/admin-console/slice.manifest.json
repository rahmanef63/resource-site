{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "admin-console",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add admin-console",
    "consumerPath": "slices/admin-console"
  },
  "files": [
    "README.md",
    "config.ts",
    "index.ts",
    "page.tsx",
    "components/AdminConsole.tsx",
    "components/AccessGate.tsx",
    "components/sections/AnalyticsDashboard.tsx",
    "components/sections/AuditLogViewer.tsx",
    "components/sections/NavConfigManager.tsx",
    "components/sections/LeadsInbox.tsx",
    "components/sections/SeoHealthPanel.tsx",
    "hooks/useAdminSection.ts",
    "lib/index.ts",
    "lib/sections.ts",
    "lib/access.ts",
    "lib/mock.ts"
  ],
  "convex": {
    "schemaPath": "convex/features/admin_console/_schema.ts",
    "rootPaths": [
      "convex/features/admin_console"
    ]
  },
  "imports": {
    "shared": [
      "@/components/ui/card",
      "@/components/ui/button",
      "@/components/ui/badge",
      "@/components/ui/input",
      "@/components/ui/table",
      "@/components/ui/select",
      "@/components/ui/sheet",
      "@/components/ui/scroll-area",
      "@/components/ui/progress",
      "@/components/ui/textarea",
      "@/lib/utils",
      "@/lib/shared/features/defineFeature"
    ],
    "external": [
      "react",
      "lucide-react",
      "convex/server",
      "convex/values"
    ]
  }
}
