{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "rbac-roles",
  "version": "0.4.0",
  "category": "auth",
  "title": "RBAC — Roles & Permissions",
  "description": "RBAC engine with six system role presets, dot-namespaced permissions, * / feature.* wildcard matching, one framework-neutral permission API, native React and Svelte UI adapters, and a tenant-scoped Convex authorization backend. React/Next remains default; Svelte/SvelteKit reuses the same role, permission, catalog, tool, and backend semantics.",
  "namespace": "@/features/rbac-roles",
  "convex": {
    "tablesExport": "rbacRolesTables",
    "schemaPath": "convex/features/rbac-roles/_schema.ts",
    "rootPaths": [
      "convex/features/rbac-roles"
    ]
  },
  "frontend": {
    "slicePath": "frontend/slices/rbac-roles",
    "configExport": "rbacRolesFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/rbac-roles-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/rbac-roles/lib/permissions.ts",
            "frontend/slices/rbac-roles/lib/roles.ts",
            "frontend/slices/rbac-roles/lib/check.ts",
            "frontend/slices/rbac-roles/lib/permission-catalog.ts",
            "frontend/slices/rbac-roles/lib/api.ts",
            "frontend/slices/rbac-roles/lib/tools.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [],
    "shadcn": [
      "badge",
      "checkbox",
      "label"
    ],
    "env": [
      {
        "name": "PLATFORM_ADMIN_EMAILS",
        "scope": "convex",
        "description": "Comma-separated emails granted cross-tenant superadmin (`*`)."
      }
    ],
    "peers": [
      {
        "slug": "convex-auth",
        "range": "^0.1",
        "reason": "Permission checks resolve the authed user via getAuthUserId."
      }
    ]
  },
  "registers": [],
  "audit": [
    "bp:public-fn-validator"
  ],
  "license": "MIT",
  "tags": [
    "rbac",
    "auth",
    "permissions",
    "roles",
    "authorization",
    "no-clerk",
    "convex"
  ],
  "previews": [
    {
      "component": "PermissionMatrix",
      "kind": "variants",
      "axes": [
        {
          "prop": "role",
          "values": [
            "admin",
            "manager",
            "staff",
            "guest"
          ],
          "default": "manager",
          "description": "Seeds the matrix `value` from this role preset's permission set."
        },
        {
          "prop": "readOnly",
          "values": [
            "false",
            "true"
          ],
          "default": "false",
          "description": "PermissionMatrix `readOnly` — locks the checkboxes for inspection."
        }
      ],
      "seed": "PERMISSION_GROUPS catalog + the selected role preset's resolved permissions"
    }
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "next",
          "range": "^15"
        },
        {
          "npm": "react",
          "range": "^18"
        }
      ]
    },
    "provides": {
      "tools": [
        "rbac-roles.list_roles",
        "rbac-roles.list_permissions",
        "rbac-roles.check",
        "rbac-roles.grant",
        "rbac-roles.revoke"
      ],
      "components": [
        "PermissionGate",
        "RoleBadge",
        "PermissionMatrix"
      ],
      "hooks": [
        "usePermissions"
      ],
      "utils": [
        "PERMS",
        "matchPermission",
        "ROLE_PRESETS",
        "ROLE_MAP",
        "resolvePermissions",
        "hasPermission",
        "roleHasPermission",
        "roleLevel",
        "isAtLeast",
        "PERMISSION_GROUPS",
        "createPermissionsApi"
      ],
      "convex": {
        "tables": [
          "rbac_roles"
        ],
        "rbac": [
          "roles.view",
          "roles.manage"
        ]
      }
    }
  }
}
