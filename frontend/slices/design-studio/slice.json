{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "design-studio",
  "version": "1.1.0",
  "category": "os",
  "kind": "ui",
  "title": "Design Studio \u2014 photo / social design canvas",
  "description": "Framework-parity layered photo/social design studio. React/Next remains the default renderer; native Svelte 5/SvelteKit provides the same offline canvas workflow over shared framework-neutral layer/document model, observable undo/redo store, scene state, filters, masks, social safe areas, JSON/HTML import-export, bundled image samples, and injected host/media adapter. Both renderers support image/text/shape/sticker/HTML layers, transforms, filters, masks, custom CSS, aspect presets, safe-area guides, keyboard shortcuts, and host-save when configured.",
  "namespace": "@/features/design-studio",
  "frontend": {
    "slicePath": "frontend/slices/design-studio",
    "configExport": "designStudioConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/design-studio-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/design-studio/config.ts",
            "frontend/slices/design-studio/lib/filters.ts",
            "frontend/slices/design-studio/lib/host-core.ts",
            "frontend/slices/design-studio/lib/masks.ts",
            "frontend/slices/design-studio/lib/model-core.ts",
            "frontend/slices/design-studio/lib/samples.ts",
            "frontend/slices/design-studio/lib/scene-core.ts",
            "frontend/slices/design-studio/lib/serialize.ts",
            "frontend/slices/design-studio/lib/studio-core.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button",
      "badge",
      "dialog",
      "input",
      "scroll-area",
      "switch",
      "textarea",
      "tooltip"
    ],
    "env": [],
    "peers": []
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:ui-consistency"
  ],
  "license": "MIT",
  "tags": [
    "media",
    "image",
    "editor",
    "design",
    "social",
    "ui",
    "svelte",
    "framework-parity"
  ],
  "previews": [
    {
      "component": "MediaStudio",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "blank-canvas",
          "title": "Blank canvas",
          "description": "Default headline + gradient background; place layers with the tools"
        },
        {
          "id": "social-story",
          "title": "Social story",
          "description": "9:16 doc loaded via payload \u2014 sticker, masked image, safe-area aspect"
        }
      ],
      "seed": "fully offline \u2014 gradient tints + bundled SVG data-URI sample images"
    }
  ],
  "contract": {
    "requires": {
      "auth": "none",
      "deps": []
    },
    "provides": {
      "routes": [],
      "components": [
        "MediaStudio"
      ],
      "hooks": [],
      "utils": [
        "configureMediaStudio",
        "parseDoc",
        "mediaStudioApp"
      ],
      "tables": []
    }
  }
}
