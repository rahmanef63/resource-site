{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "comments",
  "version": "0.4.0",
  "category": "content",
  "title": "Comments — Threaded",
  "description": "Polymorphic-target threaded comments with one framework-neutral state/thread/tool core, renderless React and Svelte adapters, and one canonical Convex backend. React/Next remains default; Svelte/SvelteKit reuses the same TargetRef, nesting, CRUD, forbidden-word, open-count, pathMap, and agent-tool semantics.",
  "namespace": "@/features/comments",
  "kind": "full",
  "convex": {
    "tablesExport": "commentsTables",
    "schemaPath": "convex/features/comments/_schema.ts",
    "rootPaths": [
      "convex/features/comments"
    ]
  },
  "frontend": {
    "slicePath": "frontend/slices/comments",
    "configExport": "commentsConfig",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/comments-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/comments/types/index.ts",
            "frontend/slices/comments/lib/buildThread.ts",
            "frontend/slices/comments/lib/state.ts",
            "frontend/slices/comments/lib/tools.ts"
          ]
        }
      }
    }
  },
  "deps": {
    "npm": [],
    "shadcn": [
      "button",
      "textarea",
      "avatar"
    ],
    "env": [],
    "peers": [
      {
        "slug": "convex-auth",
        "range": "^0.1",
        "reason": "Comment author identity from convex-auth."
      }
    ]
  },
  "registers": [
    "registry"
  ],
  "audit": [
    "bp:public-fn-validator"
  ],
  "license": "MIT",
  "tags": [
    "content",
    "social",
    "comments",
    "threaded",
    "annotations"
  ],
  "previews": [
    {
      "component": "CommentsThread",
      "kind": "variants",
      "axes": [
        {
          "prop": "density",
          "values": [
            "comfortable",
            "compact"
          ],
          "default": "comfortable",
          "description": "Row spacing of the thread skin — airy vs. dense"
        },
        {
          "prop": "resolved",
          "values": [
            "show",
            "hide"
          ],
          "default": "show",
          "description": "Include resolved comments or hide them from the list"
        }
      ],
      "seed": "seeded thread (2 roots + 1 reply) in rr-demo:comments; posting a reply persists via createDemoStore"
    }
  ],
  "contract": {
    "requires": {
      "auth": "convex",
      "rbac": [
        "comment.create",
        "comment.read"
      ],
      "convex": {
        "prefix": "comment_",
        "tables": [
          "comment_threads"
        ]
      },
      "deps": [
        "convex-auth"
      ]
    },
    "provides": {
      "tools": [
        "comments.list",
        "comments.add",
        "comments.resolve",
        "comments.remove"
      ],
      "tables": [
        "comment_threads"
      ],
      "hooks": [
        "useComments"
      ],
      "utils": [
        "buildThread",
        "createCommentsState"
      ],
      "components": [
        "CommentsThread",
        "CommentsAnchor"
      ]
    },
    "migrationFrom": {
      "0.1.0": "comments-v0.1.0-to-v0.2.0-polymorphic-target"
    },
    "generalization": {
      "level": "needs-adapter",
      "forbiddenTerms": [
        "pageId",
        "blockId",
        "targetType"
      ],
      "requiredProps": [
        "target",
        "bindings",
        "forbiddenWords",
        "pathMap"
      ]
    }
  }
}
