{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "notion-ui-svelte",
  "version": "0.25.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add notion-ui --framework sveltekit",
    "consumerPath": "slices/notion-ui-svelte"
  },
  "files": [
    "README.md",
    "index.ts",
    "shared/index.ts",
    "svelte-components.d.ts",
    "variants/database/components/NotionDatabase.svelte",
    "variants/database/components/PropertyCell.svelte",
    "variants/database/components/views/BoardView.svelte",
    "variants/database/components/views/CalendarView.svelte",
    "variants/database/components/views/CardViews.svelte",
    "variants/database/components/views/ChartView.svelte",
    "variants/database/components/views/DashboardView.svelte",
    "variants/database/components/views/FormView.svelte",
    "variants/database/components/views/MapView.svelte",
    "variants/database/components/views/TableView.svelte",
    "variants/database/components/views/TimelineView.svelte",
    "variants/database/components/views/ViewRouter.svelte",
    "variants/database/index.ts",
    "variants/database/lib/view-core.ts",
    "variants/page/components/NotionBlock.svelte",
    "variants/page/components/NotionPage.svelte",
    "variants/page/components/SlashMenu.svelte",
