    "variants/page/index.ts",
    "variants/sidebar/components/NotionSidebar.svelte",
    "variants/sidebar/index.ts"
  ],
  "imports": {
    "shared": [
      "frontend/slices/notion-ui/shared/block-core.ts",
      "frontend/slices/notion-ui/shared/types.ts",
      "frontend/slices/notion-ui/shared/calc-types.ts",
      "frontend/slices/notion-ui/shared/view-config-types.ts",
      "frontend/slices/notion-ui/variants/page/lib/block-catalog.ts",
      "frontend/slices/notion-ui/variants/page/lib/markdownTriggers.ts",
      "frontend/slices/notion-ui/variants/page/lib/blockInputHandler.ts",
      "frontend/slices/notion-ui/variants/page/lib/tools.ts",
      "lib/shared/agentic/define.ts",
      "lib/shared/agentic/schema.ts",
      "lib/shared/agentic/types.ts",
      "frontend/slices/notion-ui/shared/property-type-meta.ts",
      "frontend/slices/notion-ui/variants/database/types.ts",
      "frontend/slices/notion-ui/variants/database/lib/viewData.ts",
