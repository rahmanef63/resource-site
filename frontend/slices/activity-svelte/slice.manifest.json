{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "activity-svelte",
  "version": "0.4.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add activity --framework sveltekit",
    "consumerPath": "slices/activity"
  },
  "files": [
    "README.md",
    "components/ActivityFeed.svelte",
    "components/ActivityItem.svelte",
    "components/StatsPanel.svelte",
    "index.ts",
    "svelte-components.d.ts"
  ],
  "imports": {
    "shared": [
      "frontend/slices/activity/config.ts",
      "frontend/slices/activity/lib/types.ts",
      "frontend/slices/activity/lib/format.ts",
      "frontend/slices/activity/lib/grouping.ts",
      "frontend/slices/activity/lib/defaults.ts",
      "frontend/slices/activity/lib/stats.ts",
      "frontend/slices/activity/lib/tools.ts"
    ],
    "external": [
      "svelte",
      "convex"
    ]
  }
}
