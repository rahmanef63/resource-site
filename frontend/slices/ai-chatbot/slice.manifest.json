{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "ai-chatbot",
  "version": "0.1.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add ai-chatbot",
    "consumerPath": "slices/ai-chatbot"
  },
  "files": [
    "index.ts",
    "README.md",
    "components/ChatWorkbench.tsx",
    "components/ChatThreadList.tsx",
    "components/ChatMessagesView.tsx",
    "components/ChatComposer.tsx",
    "components/ChatModelPanel.tsx",
    "hooks/useChat.ts",
    "hooks/useStreamingMessage.ts",
    "lib/sse.ts",
    "lib/normalize-message.ts",
    "types.ts"
  ],
  "convex": {
    "schemaPath": "convex/features/ai-chatbot/schema.ts",
    "rootPaths": ["convex/features/ai-chatbot"]
  },
  "imports": {
    "shared": [
      "@/components/ui/button",
      "@/components/ui/card",
      "@/components/ui/badge",
      "@/components/ui/avatar",
      "@/components/ui/scroll-area",
      "@/components/ui/select",
      "@/components/ui/separator",
      "@/components/ui/slider",
      "@/components/ui/switch",
      "@/components/ui/textarea",
      "@/components/ui/tabs",
      "@/lib/utils"
    ],
    "external": ["react", "lucide-react", "ai", "@ai-sdk/anthropic", "@ai-sdk/openai"]
  }
}
