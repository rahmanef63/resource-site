{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "file-upload",
  "version": "0.4.0",
  "category": "data",
  "kind": "ui",
  "title": "File Upload — pluggable upload + URL resolver with storage-adapter contract",
  "description": "Host-pluggable file upload + URL resolution with React/Next kept as the default distribution and an additive Svelte 5/SvelteKit distribution. React consumers use FilesAdapter.useUrl(); Svelte consumers use a framework-native resolveUrl()/optional subscribeUrl() seam so React hook semantics do not leak across frameworks. Both preserve FileRef parsing, upload/remove behavior, file chips, upload buttons, and the demo localStorage adapter. The default React path now points to the real frontend/slices/file-upload source instead of the stale missing frontend/slices/files path.",
  "namespace": "@/features/file-upload",
  "frontend": {
    "slicePath": "frontend/slices/file-upload",
    "configExport": "",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/file-upload-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": []
        }
      }
    }
  },
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "button"
    ],
    "env": [],
    "peers": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "previews": [],
  "tags": [
    "data",
    "upload",
    "files",
    "storage",
    "adapter",
    "portable",
    "notion-like"
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "next",
          "range": "^15"
        },
        {
          "npm": "react",
          "range": "^18"
        },
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        }
      ]
    },
    "provides": {
      "tools": [
        "files.parse_ref",
        "files.remove"
      ],
      "components": [
        "FileChip",
        "FileUploadButton",
        "FilesAdapterProvider"
      ],
      "utils": [
        "parseFileRef",
        "makeStorageRef"
      ],
      "hooks": [
        "useFileUpload",
        "useFileUrl",
        "useFilesAdapter",
        "useLocalStorageFilesAdapter"
      ],
      "convex": {
        "tables": [],
        "rbac": []
      }
    }
  }
}
