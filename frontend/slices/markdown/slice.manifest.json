{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "markdown",
  "version": "0.4.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add markdown",
    "consumerPath": "slices/markdown"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "components/ChartBlock.tsx",
    "components/ChartCanvas.tsx",
    "components/MarkdownPage.tsx",
    "components/MarkdownReader.tsx",
    "components/MdNodeView.tsx",
    "components/MermaidBlock.tsx",
    "components/ReviewTab.tsx",
    "components/WriteTab.tsx",
    "components/chart-spec.ts",
    "config.ts",
    "index.ts",
    "lib/classnames.ts",
    "lib/comments.ts",
    "lib/inline-core.ts",
    "lib/inline.tsx",
    "lib/katex-lazy.tsx",
    "lib/page-core.ts",
    "lib/parse.ts",
    "lib/render-core.ts",
    "lib/snippets.ts",
    "preview.tsx"
  ],
  "imports": {
    "shared": [],
    "external": [
      "react",
      "katex",
      "mermaid",
      "recharts",
      "lucide-react",
      "@/components/ui/button",
      "@/components/ui/tabs",
      "@/components/ui/textarea"
    ]
  }
}
