{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "admin",
  "version": "0.2.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add admin",
    "consumerPath": "slices/admin"
  },
  "files": [
    "index.ts",
    "config.ts",
    "page.tsx",
    "components/index.ts",
    "hooks/index.ts",
    "lib/index.ts",
    "lib/registry-adapter.ts",
    "lib/registry-types.ts",
    "lib/registry-labels.ts",
    "lib/registry-stats.ts",
    "types/index.ts",
    "utils/index.ts"
  ],
  "convex": {
    "schemaPath": "convex/features/admin/schema.ts",
    "rootPaths": ["convex/features/admin"]
  },
  "imports": {
    "shared": [
      "@/components/ui/card",
      "@/components/ui/button",
      "@/components/ui/badge"
    ],
    "external": ["react", "next/link", "lucide-react"]
  }
}
