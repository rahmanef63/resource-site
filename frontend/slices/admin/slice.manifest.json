{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "admin",
  "version": "0.4.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add admin",
    "consumerPath": "slices/admin"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "config.ts",
    "index.ts",
    "slice.json",
    "variants/console/CHANGELOG.md",
    "variants/console/README.md",
    "variants/console/components/AccessGate.tsx",
    "variants/console/components/AdminConsole.tsx",
    "variants/console/components/sections/AnalyticsDashboard.tsx",
    "variants/console/components/sections/AuditLogViewer.tsx",
    "variants/console/components/sections/LeadsInbox.tsx",
    "variants/console/components/sections/NavConfigManager.tsx",
    "variants/console/components/sections/SeoHealthPanel.tsx",
    "variants/console/hooks/useAdminSection.ts",
    "variants/console/index.ts",
    "variants/console/lib/access.ts",
    "variants/console/lib/index.ts",
    "variants/console/lib/mock.ts",
    "variants/console/lib/nav.ts",
    "variants/console/lib/section-core.ts",
    "variants/console/lib/sections.ts",
    "variants/console/page.tsx",
    "variants/shell/README.md",
    "variants/shell/index.ts",
    "variants/shell/lib/index.ts",
    "variants/shell/lib/registry-adapter.ts",
    "variants/shell/lib/registry-labels.ts",
    "variants/shell/lib/registry-stats.ts",
    "variants/shell/lib/registry-types.ts",
    "variants/shell/page.tsx"
  ],
  "imports": {
    "shared": [
      "@/components/ui/badge",
      "@/components/ui/button",
      "@/components/ui/card",
      "@/components/ui/input",
      "@/components/ui/progress",
      "@/components/ui/scroll-area",
      "@/components/ui/select",
      "@/components/ui/sheet",
      "@/components/ui/table",
      "@/components/ui/textarea",
      "@/lib/shared/features/defineFeature",
      "@/lib/utils"
    ],
    "external": [
      "react",
      "lucide-react"
    ]
  }
}
