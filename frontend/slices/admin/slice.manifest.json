{
  "$schema": "https://resource.rahmanef.com/slice-manifest-schema.json",
  "slug": "admin",
  "version": "0.2.0",
  "tier": 3,
  "distribution": {
    "method": "cli-copy",
    "command": "npx rr add admin",
    "consumerPath": "slices/admin"
  },
  "files": [
    "README.md",
    "components/index.ts",
    "config.ts",
    "hooks/index.ts",
    "index.ts",
    "lib/index.ts",
    "lib/registry-adapter.ts",
    "lib/registry-labels.ts",
    "lib/registry-stats.ts",
    "lib/registry-types.ts",
    "page.tsx",
    "types/index.ts",
    "utils/index.ts"
  ],
  "convex": {
    "schemaPath": "convex/features/admin/_schema.ts",
    "rootPaths": [
      "convex/features/admin"
    ]
  },
  "imports": {
    "shared": [
      "@/components/ui/card",
      "@/components/ui/button",
      "@/components/ui/badge"
    ],
    "external": [
      "react",
      "next/link",
      "lucide-react"
    ]
  }
}
