{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "admin",
  "version": "0.4.0",
  "category": "infra",
  "kind": "full",
  "title": "Admin \u2014 generic shell + composed console",
  "description": "Framework-parity access-gated admin surfaces behind one slug. React/Next remains default; explicit Svelte 5/SvelteKit provides native shell and console renderers over the same access rules, 26-section catalog, mock contracts, registry-driven stats core, and per-variant Convex backends. shell is the minimal generic AdminPage + buildAdminStats surface over convex/features/admin. console is the composed 26-section AdminConsole with five owned sections (analytics, audit log, nav config, SEO health, leads) plus host-injected peer panels over convex/features/admin_console. Variant installs keep backend gating exact: shell pulls only admin, console only admin_console.",
  "namespace": "@/features/admin",
  "variants": {
    "default": "console",
    "items": [
      {
        "id": "shell",
        "title": "Shell",
        "description": "Minimal generic admin shell (titled card + buildAdminStats).",
        "convex": [
          "convex/features/admin"
        ],
        "deps": {
          "env": [
            {
              "name": "SUPER_ADMIN_EMAIL",
              "scope": "convex",
              "required": false,
              "description": "shell variant \u2014 single super-admin gate."
            }
          ]
        }
      },
      {
        "id": "console",
        "title": "Console",
        "description": "Composed access-gated 26-section console mounting other rr slices.",
        "convex": [
          "convex/features/admin_console"
        ],
        "deps": {
          "env": [
            {
              "name": "PLATFORM_ADMIN_EMAILS",
              "scope": "convex",
              "required": false,
              "description": "console variant \u2014 comma-separated platform-admin allowlist."
            }
          ]
        }
      }
    ]
  },
  "frontend": {
    "slicePath": "frontend/slices/admin",
    "configExport": "adminFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/admin-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/admin/variants/console/lib/access.ts",
            "frontend/slices/admin/variants/console/lib/mock.ts",
            "frontend/slices/admin/variants/console/lib/section-core.ts",
            "frontend/slices/admin/variants/console/lib/sections.ts",
            "frontend/slices/admin/variants/shell/lib/registry-labels.ts",
            "frontend/slices/admin/variants/shell/lib/registry-stats.ts",
            "frontend/slices/admin/variants/shell/lib/registry-types.ts"
          ]
        }
      }
    }
  },
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": [
      "convex/features/admin",
      "convex/features/admin_console"
    ]
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0"
    ],
    "shadcn": [
      "badge",
      "button",
      "card",
      "input",
      "progress",
      "scroll-area",
      "select",
      "sheet",
      "table",
      "textarea"
    ],
    "env": [],
    "peers": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "admin",
    "console",
    "shell",
    "access-gate",
    "rbac",
    "sections",
    "dashboard",
    "infra",
    "svelte",
    "framework-parity"
  ],
  "previews": [],
  "contract": {
    "provides": {
      "tools": [],
      "components": [
        "AdminPage",
        "AdminConsole",
        "AccessGate"
      ],
      "utils": [
        "buildAdminStats",
        "filterSections",
        "hasPermission"
      ],
      "hooks": [],
      "convex": {
        "tables": [
          "ac_leads",
          "ac_nav_items"
        ],
        "rbac": []
      }
    }
  }
}
