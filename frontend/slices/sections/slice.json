{
  "$schema": "https://resource.rahmanef.com/slice-schema.json",
  "slug": "sections",
  "version": "0.5.0",
  "category": "content",
  "kind": "ui",
  "title": "Sections \u2014 composable marketing/landing sections",
  "description": "Framework-parity canonical landing sections: React stays default with self-contained CRUD/motion renderers, while explicit Svelte 5/SvelteKit installs native admin list/editor plus stats, testimonials, FAQ, pricing, newsletter, custom, and shell renderers over the same reducer, store contract, ordering, field schema, section types, and config parser.",
  "namespace": "@/features/sections",
  "frontend": {
    "slicePath": "frontend/slices/sections",
    "configExport": "sectionsFeature",
    "defaultFramework": "react-next",
    "frameworks": {
      "svelte-sveltekit": {
        "path": "frontend/slices/sections-svelte",
        "aliases": [
          "svelte",
          "sveltekit"
        ],
        "deps": {
          "npm": [
            "svelte@^5"
          ],
          "shadcn": [],
          "sharedFiles": [
            "frontend/slices/sections/types.ts",
            "frontend/slices/sections/reducer.ts",
            "frontend/slices/sections/seed-factory.ts",
            "frontend/slices/sections/lib/core.ts",
            "frontend/slices/sections/lib/fields.ts",
            "frontend/slices/sections/sections/config.ts"
          ]
        }
      }
    }
  },
  "convex": {
    "tablesExport": "",
    "schemaPath": "",
    "rootPaths": []
  },
  "deps": {
    "npm": [
      "lucide-react@^0.400.0",
      "embla-carousel-autoplay@^8.6.0"
    ],
    "shadcn": [
      "accordion",
      "badge",
      "button",
      "card",
      "carousel",
      "dialog",
      "input",
      "switch",
      "table",
      "textarea"
    ],
    "env": [],
    "peers": [],
    "sharedFiles": []
  },
  "registers": [],
  "audit": [],
  "license": "MIT",
  "tags": [
    "admin",
    "landing",
    "cms",
    "sections",
    "crud",
    "renderer",
    "svelte",
    "framework-parity"
  ],
  "previews": [
    {
      "component": "LandingSectionShell",
      "kind": "scenarios",
      "scenarios": [
        {
          "id": "hero-only",
          "title": "Hero only",
          "description": "Single hero band"
        },
        {
          "id": "hero-features",
          "title": "Hero + features",
          "description": "Hero followed by a features grid"
        },
        {
          "id": "full-page",
          "title": "Full page",
          "description": "Hero + features + CTA stacked, scaled to fit"
        }
      ],
      "seed": "3 seed sections (hero/features/cta) rendered by local mini-blocks wrapped in LandingSectionShell, scaled in a fixed-height frame"
    }
  ],
  "contract": {
    "requires": {
      "deps": [
        {
          "npm": "lucide-react",
          "range": "^0.400.0"
        },
        {
          "npm": "embla-carousel-autoplay",
          "range": "^8.6.0"
        }
      ]
    },
    "provides": {
      "tools": [],
      "components": [
        "LandingView",
        "LandingEditorView",
        "LandingSectionShell",
        "StatsSection",
        "TestimonialsSection",
        "FaqSection",
        "PricingSection",
        "NewsletterSection",
        "CustomSection"
      ],
      "utils": [
        "blankSection",
        "defaultLandingSections",
        "landingReducer",
        "parseConfigBadge",
        "parseConfigField",
        "parseConfigObject",
        "LANDING_KIND_LABEL",
        "LANDING_KIND_OPTIONS",
        "LANDING_RATIO_OPTIONS",
        "moveLandingSection",
        "sortedLandingSections",
        "visibleLandingCount"
      ],
      "hooks": [
        "useLandingStore"
      ],
      "convex": {
        "tables": [],
        "rbac": []
      },
      "types": [
        "LandingStore",
        "LandingFieldDef"
      ]
    },
    "generalization": {
      "level": "portable"
    }
  }
}
