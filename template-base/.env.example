# ============================================================================
# resources/template-base — environment template
# Copy to .env.local for dev, set in Dokploy for prod.
# ============================================================================

# Convex (self-hosted)
NEXT_PUBLIC_CONVEX_URL="https://your-convex-backend.example.com"
CONVEX_SELF_HOSTED_URL="https://your-convex-backend.example.com"
CONVEX_SELF_HOSTED_ADMIN_KEY="convex-self-hosted-admin-key"

# Convex backend internal (self-host docker)
INSTANCE_NAME="prod"
INSTANCE_SECRET="generate-with-openssl-rand-hex-32"
CONVEX_CLOUD_ORIGIN="https://api.your-domain.example.com"
CONVEX_SITE_ORIGIN="https://site.your-domain.example.com"
POSTGRES_URL="postgresql://user:pass@postgres:5432/convex"
# Optional S3 buckets — required for prod-grade storage
# S3_STORAGE_EXPORTS_BUCKET=
# S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=
# S3_STORAGE_MODULES_BUCKET=
# S3_STORAGE_FILES_BUCKET=
# S3_STORAGE_SEARCH_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# Next.js 16 — multi-instance Server Actions key (audit-bp P0)
# Generate ONCE: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Next.js deploy id (si-coder injects per deploy)
NEXT_DEPLOYMENT_ID=""

# Public site URL (used by allowedOrigins, OG, sitemap)
NEXT_PUBLIC_SITE_URL="https://your-domain.example.com"

# OAuth — @convex-dev/auth providers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend — contact form / transactional email
RESEND_API_KEY=""

# AI providers (optional)
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""

# Dokploy / GitHub / Hostinger (si-coder deploy script reads from your shell, not from .env)
# Set these in ~/.bashrc:
#   DOKPLOY_API_URL, DOKPLOY_API_KEY, GITHUB_TOKEN, HOSTINGER_API_TOKEN
