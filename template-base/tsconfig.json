{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // The hand-written convex/_generated/api.d.ts types `api` as `any`. UI
    // hooks that pull data through `useQuery(api.…)` end up with `any[]`,
    // which TS then flags as implicit-any on every `.filter((x) => …)` /
    // `.map((x, i) => …)` callback. Loosen here while the stub is in
    // place; flip back to strict once `npx convex dev --once` runs and
    // the real codegen produces typed return values.
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/convex/*": ["./convex/*"],
      "@convex/_generated/*": ["./convex/_generated/*"],
      "@notion/*": ["./frontend/slices/notion/*"],
      "@notionConvex/*": ["./convex/features/notion/*"],
      "@/shared/builder/*": ["./frontend/shared/builder/*"],
      "@/shared/foundation/*": ["./frontend/shared/foundation/*"],
      "@/shared/settings/*": ["./frontend/shared/settings/*"],
      "@/shared/communications/*": ["./frontend/shared/communications/*"],
      "@/shared/theme/*": ["./frontend/shared/theme/*"],
      "@/shared/lib/*": ["./frontend/shared/lib/*"],
      "@/shared/ui/*": [
        "./frontend/shared/ui/components/*",
        "./frontend/shared/ui/motion/*",
        "./frontend/shared/ui/*",
        "./components/ui/*"
      ],
      "@/shared/*": ["./frontend/shared/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.legacy",
    "archive",
    "frontend/slices/notion/app-fragments"
  ]
}
