  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "convex:dev": "convex dev",
    "convex:codegen": "convex dev --once",
    "convex:deploy": "convex deploy",
    "create:feature": "tsx scripts/features/create.ts",
    "list:features": "tsx scripts/features/list.ts",
    "edit:feature": "tsx scripts/features/edit.ts",
    "delete:feature": "tsx scripts/features/delete.ts",
    "sync:features": "tsx scripts/features/sync.ts",
    "syncagent:all": "tsx scripts/features/sync-agents.ts",
