    "validate:previews": "tsx scripts/features/validate-previews.ts",
    "validate:features": "tsx scripts/validation/features.ts",
    "validate:feature-naming": "tsx scripts/validation/feature-naming.ts",
    "sync:all": "pnpm run sync:features && pnpm run syncagent:all && pnpm run generate:registry && pnpm run generate:init-imports && pnpm run generate:previews && pnpm run generate:manifest && pnpm run generate:slice-docs && pnpm run validate:bundles",
